# Environment variables for Cloudflare Pages and Vercel
# Copy these values into Cloudflare Pages > Settings > Environment Variables

# 1. Supabase Cloud Database (Live Views, Likes, Posts Sync)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# 2. GitHub Token (Automatic Git Commits on Post Publishing)
GITHUB_TOKEN=your-github-personal-access-token
