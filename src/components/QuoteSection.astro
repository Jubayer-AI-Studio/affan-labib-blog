---
// src/components/QuoteSection.astro
import quotes from '../data/quotes.json';
---

<section class="mt-14 mb-16 relative">
  <div class="relative overflow-hidden rounded-3xl border border-paper-border/80 dark:border-night-border/80 bg-paper-surface/85 dark:bg-night-surface/85 backdrop-blur-xl p-8 sm:p-12 shadow-sm text-center">
    <!-- Top Action Bar -->
    <div class="flex items-center justify-between gap-4 mb-6 text-xs font-sans text-paper-muted dark:text-night-muted">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-500/10 dark:bg-amber-400/10 text-amber-900 dark:text-amber-200 border border-amber-500/20 font-medium">
        <span>✨</span>
        <span>সাহিত্যিক বাণী</span>
      </span>

      <div class="flex items-center gap-3">
        <!-- Like / Heart Button -->
        <button
          id="quote-like-btn"
          type="button"
          class="inline-flex items-center gap-1 px-3 py-1 rounded-full border border-paper-border dark:border-night-border hover:border-rose-400 dark:hover:border-rose-500 hover:text-rose-500 transition-colors cursor-pointer relative"
          title="বাণীটি পছন্দ হয়েছে"
        >
          <span>❤️</span>
          <span id="heart-count">৪২</span>
          <span id="heart-burst" class="absolute left-1/2 -top-2 pointer-events-none opacity-0 transition-all duration-500 text-rose-500">❤️</span>
        </button>

        <!-- Refresh Quote Button -->
        <button
          id="next-quote-btn"
          type="button"
          class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full border border-paper-border dark:border-night-border hover:border-paper-accent dark:hover:border-night-accent hover:text-paper-accent dark:hover:text-night-accent transition-colors cursor-pointer"
          title="পরবর্তী বাণী"
        >
          <span id="refresh-icon" class="transition-transform duration-500">🔄</span>
          <span class="hidden sm:inline">বাণী বদলান</span>
        </button>
      </div>
    </div>

    <!-- Quote Body -->
    <div class="space-y-4 my-4">
      <span class="text-4xl sm:text-5xl font-serif text-paper-accent/30 dark:text-night-accent/30 leading-none block select-none">
        ❝
      </span>
      <blockquote
        id="quote-text"
        class="text-lg sm:text-xl md:text-2xl font-serif font-medium text-paper-text dark:text-night-text leading-relaxed max-w-2xl mx-auto italic transition-all duration-300"
      >
        "{quotes[0]}"
      </blockquote>

      <!-- Progress Line -->
      <div class="w-24 h-1 bg-paper-border/60 dark:bg-night-border/60 rounded-full mx-auto mt-4 overflow-hidden">
        <div id="quote-progress" class="h-full bg-gradient-to-r from-amber-500 via-rose-500 to-teal-500 w-0 transition-all duration-100 ease-linear rounded-full"></div>
      </div>
    </div>

    <!-- Author Citation -->
    <div class="pt-4 flex items-center justify-center gap-3">
      <div class="w-8 h-0.5 bg-paper-accent/40 dark:bg-night-accent/40 rounded-full"></div>
      <div class="flex items-center gap-2">
        <img src="/images/affan-labib.jpg" alt="আফফান লাবীব" class="author-avatar-img w-6 h-6 rounded-full object-cover ring-1 ring-paper-accent/40 shadow-xs" />
        <cite class="text-sm font-sans font-bold text-paper-accent dark:text-night-accent not-italic">
          — <span class="author-name-text">আফফান লাবীব</span>
        </cite>
        <span class="text-xs text-paper-muted dark:text-night-muted font-sans font-normal">
          (<span class="author-edu-text">তাখাসসুস ফিল আদব ও ইসলামিক স্টাডিজ</span>)
        </span>
      </div>
      <div class="w-8 h-0.5 bg-paper-accent/40 dark:bg-night-accent/40 rounded-full"></div>
    </div>
  </div>
</section>

<script is:inline define:vars={{ quotes }}>
  (() => {
    let currentIndex = 0;
    const quoteEl = document.getElementById('quote-text');
    const nextBtn = document.getElementById('next-quote-btn');
    const refreshIcon = document.getElementById('refresh-icon');
    const progressBar = document.getElementById('quote-progress');
    const likeBtn = document.getElementById('quote-like-btn');
    const heartCountEl = document.getElementById('heart-count');
    const heartBurstEl = document.getElementById('heart-burst');

    let heartCount = parseInt(localStorage.getItem('kherokhata_quote_hearts') || '42', 10);
    if (heartCountEl) heartCountEl.textContent = heartCount.toLocaleString('bn-BD');

    likeBtn?.addEventListener('click', () => {
      heartCount += 1;
      localStorage.setItem('kherokhata_quote_hearts', heartCount.toString());
      if (heartCountEl) heartCountEl.textContent = heartCount.toLocaleString('bn-BD');

      if (heartBurstEl) {
        heartBurstEl.style.opacity = '1';
        heartBurstEl.style.transform = 'translate(-50%, -18px) scale(1.3)';
        setTimeout(() => {
          heartBurstEl.style.opacity = '0';
          heartBurstEl.style.transform = 'translate(-50%, 0) scale(1)';
        }, 600);
      }
    });

    const DURATION = 10000;
    let startTime = Date.now();

    function updateProgress() {
      if (!progressBar) return;
      const elapsed = Date.now() - startTime;
      const pct = Math.min(100, (elapsed / DURATION) * 100);
      progressBar.style.width = pct + '%';
      if (pct >= 100) {
        switchQuote();
      }
    }

    setInterval(updateProgress, 100);

    function switchQuote() {
      if (!quoteEl) return;
      startTime = Date.now();

      if (refreshIcon) {
        refreshIcon.style.transform = 'rotate(360deg)';
        setTimeout(() => { refreshIcon.style.transform = 'rotate(0deg)'; }, 500);
      }

      quoteEl.style.opacity = '0';
      quoteEl.style.transform = 'translateY(8px)';

      setTimeout(() => {
        currentIndex = (currentIndex + 1) % quotes.length;
        quoteEl.innerText = `"${quotes[currentIndex]}"`;
        quoteEl.style.opacity = '1';
        quoteEl.style.transform = 'translateY(0)';
      }, 250);
    }

    nextBtn?.addEventListener('click', switchQuote);
  })();
</script>
