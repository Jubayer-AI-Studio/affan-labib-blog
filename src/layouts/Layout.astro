---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import InstallModal from '../components/InstallModal.astro';
import AppLoader from '../components/AppLoader.astro';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  showLoader?: boolean;
  article?: {
    publishedTime: string;
    tags?: string[];
  };
}

const {
  title = 'লাবীবের খেরোখাতা | আফফান লাবীব - Affan Labib',
  description = 'Affan Labib (আফফান লাবীব)-এর অফিসিয়াল ওয়েবসাইট ও সাহিত্য সাময়িকী লাবীবের খেরোখাতা (Labib er Kherokhata)। চিন্তা, পাঠের আনন্দ, ইতিহাসচর্চা ও বই-আলোচনার ব্যক্তিগত ঘর।',
  image = '/images/og-affan-labib-v4.jpg?v=4',
  showLoader = false,
  article
} = Astro.props;

const siteUrl = 'https://affan-labib-blog.vercel.app';
const canonicalURL = new URL(Astro.url.pathname, siteUrl).href;
const cleanImage = (image === '/images/og-default.jpg' || image === '/images/og-default-v2.jpg') ? '/images/og-affan-labib-v4.jpg?v=4' : image;
const absoluteImageURL = cleanImage.startsWith('http') ? cleanImage : new URL(cleanImage, siteUrl).href;

// Multi-Entity Schema.org Knowledge Graph (Person + WebSite + Article/WebPage)
const personEntity = {
  '@type': 'Person',
  '@id': `${siteUrl}/#person`,
  name: 'আফফান লাবীব',
  alternateName: ['Affan Labib', 'Labib', 'আফফান', 'লাবীব'],
  url: `${siteUrl}/about`,
  image: {
    '@type': 'ImageObject',
    '@id': `${siteUrl}/#authorImage`,
    url: `${siteUrl}/images/og-affan-labib-v4.jpg`,
    caption: 'Affan Labib (আফফান লাবীব)'
  },
  jobTitle: 'লেখক, গবেষক ও চিন্তক (Author, Researcher & Essayist)',
  description: "আফফান লাবীব (Affan Labib) একজন বাংলাদেশি লেখক, গবেষক ও চিন্তক। তিনি সাহিত্য সাময়িকী 'লাবীবের খেরোখাতা' (Labib er Kherokhata)-র প্রতিষ্ঠাতা ও লেখক।",
  sameAs: [
    'https://www.facebook.com/share/19tT1QFjef/',
    siteUrl
  ],
  knowsAbout: [
    'Islamic Studies',
    'Bengali Literature',
    'History',
    'Philosophy',
    'Book Reviews',
    'চিন্তা',
    'ইতিহাস',
    'সাহিত্য'
  ]
};

const websiteEntity = {
  '@type': 'WebSite',
  '@id': `${siteUrl}/#website`,
  url: siteUrl,
  name: 'লাবীবের খেরোখাতা | Affan Labib',
  alternateName: [
    'Labib er Kherokhata',
    'Affan Labib',
    'আফফান লাবীব',
    'Affan Labib Blog',
    'Labiber Kherokhata',
    'লাবীবের খেরোখাতা'
  ],
  description: "Affan Labib's official website & literary web magazine: Labib er Kherokhata (লাবীবের খেরোখাতা - চিন্তা ও পাঠের নিভৃত আঙিনা)।",
  publisher: { '@id': `${siteUrl}/#person` },
  author: { '@id': `${siteUrl}/#person` },
  inLanguage: ['bn-BD', 'en'],
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${siteUrl}/search?q={search_term_string}`
    },
    'query-input': 'required name=search_term_string'
  }
};

const pageEntity = article
  ? {
      '@type': 'BlogPosting',
      '@id': `${canonicalURL}#article`,
      isPartOf: { '@id': `${siteUrl}/#website` },
      headline: title,
      description: description,
      image: absoluteImageURL,
      datePublished: article.publishedTime,
      dateModified: article.publishedTime,
      mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL },
      author: { '@id': `${siteUrl}/#person` },
      publisher: { '@id': `${siteUrl}/#person` },
      inLanguage: 'bn-BD',
      keywords: article.tags && article.tags.length > 0 ? article.tags.join(', ') : 'Affan Labib, Labib er Kherokhata'
    }
  : {
      '@type': Astro.url.pathname === '/about' ? 'ProfilePage' : 'WebPage',
      '@id': `${canonicalURL}#webpage`,
      url: canonicalURL,
      name: title,
      description: description,
      isPartOf: { '@id': `${siteUrl}/#website` },
      about: { '@id': `${siteUrl}/#person` },
      inLanguage: 'bn-BD'
    };

const schemaData = {
  '@context': 'https://schema.org',
  '@graph': [personEntity, websiteEntity, pageEntity]
};
---

<!DOCTYPE html>
<html lang="bn" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icons/icon-192.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- Canonical URL & Sitemap Declaration -->
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap.xml" />
    <link rel="author" href={`${siteUrl}/about`} />

    <!-- Core SEO & Search Indexing Directives (Google, Bing, AI Bots) -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Affan Labib (আফফান লাবীব)" />
    <meta name="keywords" content="Affan Labib, Labib er Kherokhata, লাবীবের খেরোখাতা, আফফান লাবীব, Labiber Kherokhata, affan labib blog, affan labib website, bangla essays, bengali literature, বই আলোচনা, ইসলামি ইতিহাস, চিন্তাশীল গদ্য, সাহিত্য সাময়িকী" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="bingbot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

    <!-- Open Graph / Facebook / WhatsApp / LinkedIn / Telegram -->
    <link rel="image_src" href={absoluteImageURL} />
    <meta name="thumbnail" content={absoluteImageURL} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="লাবীবের খেরোখাতা | Affan Labib" />
    <meta property="og:locale" content="bn_BD" />
    <meta property="og:locale:alternate" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteImageURL} />
    <meta property="og:image:secure_url" content={absoluteImageURL} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    {article?.publishedTime && <meta property="article:published_time" content={article.publishedTime} />}
    {article?.tags?.map((t) => <meta property="article:tag" content={t} />)}

    <!-- Twitter / X Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImageURL} />
    <meta name="twitter:image:src" content={absoluteImageURL} />
    <meta name="twitter:image:alt" content={title} />

    <!-- High-Performance Non-Blocking Fonts -->
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://fonts.gstatic.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&family=Amiri:ital,wght@0,400;0,700;1,400&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&family=Amiri:ital,wght@0,400;0,700;1,400&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&family=Amiri:ital,wght@0,400;0,700;1,400&display=swap"
      />
    </noscript>

    <!-- RSS Feed -->
    <link rel="alternate" type="application/rss+xml" title="আফফান লাবীব - RSS Feed" href="/rss.xml" />

    <!-- PWA Manifest & Mobile Configuration -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#9A3412" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="খেরোখাতা" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />

    <!-- JSON-LD Structured Data Schema -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

    <!-- Anti-flicker 3-Mode Theme Script (Light, Sepia, Dark) -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();

      document.documentElement.classList.remove('dark', 'sepia');
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else if (theme === 'sepia') {
        document.documentElement.classList.add('sepia');
      }

      try {
        const savedLang = localStorage.getItem('kherokhata_lang');
        if (savedLang) {
          document.documentElement.lang = savedLang;
        }
      } catch (e) {}
    </script>
  </head>
  <body
    id="top"
    class="bg-paper-bg dark:bg-night-bg text-paper-text dark:text-night-text min-h-screen flex flex-col font-sans selection:bg-orange-200 dark:selection:bg-orange-950 relative"
  >
    <!-- Entertaining App Launch Screen with Live 1-100% Progress & Pushing Robot (First Cold Launch only) -->
    {showLoader && <AppLoader />}

    <!-- Ambient Literary Glow Orbs -->
    <div class="fixed inset-0 pointer-events-none z-[-1] overflow-hidden select-none" aria-hidden="true">
      <div class="absolute -top-24 -left-24 w-80 sm:w-96 h-80 sm:h-96 rounded-full bg-gradient-to-br from-amber-500/10 via-orange-500/5 to-transparent dark:from-amber-400/5 dark:via-orange-500/5 blur-3xl opacity-60"></div>
      <div class="absolute top-1/3 -right-24 w-80 sm:w-[28rem] h-80 sm:h-[28rem] rounded-full bg-gradient-to-bl from-teal-500/10 via-emerald-500/5 to-transparent dark:from-teal-400/5 dark:via-cyan-500/5 blur-3xl opacity-50"></div>
      <div class="absolute -bottom-24 left-1/4 w-80 sm:w-96 h-80 sm:h-96 rounded-full bg-gradient-to-tr from-rose-500/8 via-amber-500/5 to-transparent dark:from-orange-500/5 dark:via-amber-400/5 blur-3xl opacity-50"></div>
      <div class="absolute inset-0 bg-radial-vignette opacity-40"></div>
    </div>

    <!-- Global Header -->
    <Header />

    <!-- Main Content Slot -->
    <main class="flex-grow max-w-5xl w-full mx-auto px-4 sm:px-6 py-8 sm:py-12">
      <slot />
    </main>

    <!-- Global Footer -->
    <Footer />

    <!-- Global PWA Install Modal -->
    <InstallModal />

    <!-- Bulletproof Author Profile & Avatar Sync Everywhere -->
    <script is:inline>
      (() => {
        function syncAuthorProfile() {
          const customProfile = localStorage.getItem('kherokhata_author_custom');
          if (customProfile) {
            try {
              const data = JSON.parse(customProfile);
              if (data.name) document.querySelectorAll('.author-name-text').forEach((el) => { el.textContent = data.name; });
              if (data.education) document.querySelectorAll('.author-edu-text').forEach((el) => { el.textContent = data.education; });
              if (data.tagline) document.querySelectorAll('.author-tagline-text').forEach((el) => { el.textContent = data.tagline; });
              if (data.bio) document.querySelectorAll('.author-shortbio-text').forEach((el) => { el.textContent = data.bio; });
            } catch (e) {}
          }
        }

        syncAuthorProfile();
        document.addEventListener('DOMContentLoaded', syncAuthorProfile);
        window.addEventListener('load', syncAuthorProfile);
        window.addEventListener('kherokhata-author-sync', syncAuthorProfile);
        window.addEventListener('kherokhata-avatar-sync', syncAuthorProfile);
        window.addEventListener('storage', syncAuthorProfile);
      })();
    </script>

    <!-- Auto-Updating Service Worker Registration (Busts Stale Caches Instantly) -->
    <script is:inline>
      if ('serviceWorker' in navigator) {
        let refreshing = false;
        const hadController = Boolean(navigator.serviceWorker.controller);
        navigator.serviceWorker.addEventListener('controllerchange', () => {
          if (hadController && !refreshing) {
            refreshing = true;
            window.location.reload();
          }
        });

        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').then((reg) => {
            reg.update();
            reg.onupdatefound = () => {
              const installingWorker = reg.installing;
              if (installingWorker) {
                installingWorker.onstatechange = () => {
                  if (installingWorker.state === 'installed' && navigator.serviceWorker.controller) {
                    installingWorker.postMessage({ type: 'SKIP_WAITING' });
                  }
                };
              }
            };
          }).catch(() => {});
        });
      }
    </script>
  </body>
</html>
