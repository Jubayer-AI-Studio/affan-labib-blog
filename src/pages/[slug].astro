---
// src/pages/[slug].astro
import Layout from '../layouts/Layout.astro';
import ThemeAvatar from '../components/ThemeAvatar.astro';
import { getAllPostsAsync, CATEGORY_LABELS_MAP } from '../lib/db';
import { getArticleStatsAndComments, toBnDigits } from '../lib/interactions';

export const prerender = false;

// Direct Dynamic Response (prevents stale CDN caching of views and likes)
Astro.response.headers.set('Cache-Control', 'no-cache, no-store, must-revalidate');

const rawSlug = Astro.params.slug || '';
let decodedSlug = rawSlug;
try {
  decodedSlug = decodeURIComponent(rawSlug);
} catch {}

const allPosts = await getAllPostsAsync();
const post = allPosts.find((p) => p.slug === rawSlug || p.slug === decodedSlug || decodeURIComponent(p.slug) === decodedSlug);
const isFallback = !post;

const displayPost = post || {
  slug: decodedSlug || rawSlug,
  title: 'লেখা লোড হচ্ছে...',
  category: 'chinta',
  description: 'লেখা লোড হচ্ছে...',
  publishedAt: '',
  formattedDate: '',
  tags: [],
  body: '',
  wordCount: 0,
  footnotes: []
};

// Server-side pre-fetch of live views, likes and comments for instant 0ms flicker-free display
const { views: initialViews, likes: initialLikes, comments: initialComments } = await getArticleStatsAndComments(displayPost.slug);
const initialViewsBn = toBnDigits(initialViews || 0);
const initialLikesBn = toBnDigits(initialLikes || 0);
const initialCommentsCountBn = toBnDigits(initialComments.length || 0);

const categoryName = CATEGORY_LABELS_MAP[displayPost.category] || displayPost.category;
const readTime = Math.max(1, Math.ceil((displayPost.wordCount || 200) / 100));
const bnDigits = ['০', '১', '২', '৩', '৪', '৫', '৬', '৭', '৮', '৯'];
const readTimeBn = readTime.toString().replace(/[0-9]/g, (d) => bnDigits[parseInt(d, 10)]);

const bnToEnMap: Record<string, string> = {
  '০': '0', '১': '1', '২': '2', '৩': '3', '৪': '4',
  '৫': '5', '৬': '6', '৭': '7', '৮': '8', '৯': '9'
};

function normalizeDigitId(raw: string): string {
  return (raw || '').replace(/[০-৯]/g, (d) => bnToEnMap[d] || d);
}

// Format body paragraphs (handles markdown headers, bolding, paragraphs, footnotes)
function renderBody(body: string) {
  if (!body) return '<div class="py-12 text-center text-paper-muted animate-pulse">লেখা প্রস্তুত হচ্ছে...</div>';
  const paragraphs = body.split('\n\n');
  return paragraphs
    .map((p) => {
      const trimmed = p.trim();
      if (!trimmed) return '';
      if (trimmed.startsWith('### ')) {
        return `<h3 class="text-xl sm:text-2xl font-bold font-serif text-paper-text dark:text-night-text mt-8 mb-3">${trimmed.slice(4)}</h3>`;
      }
      if (trimmed.startsWith('## ')) {
        return `<h2 class="text-2xl sm:text-3xl font-bold font-serif text-paper-text dark:text-night-text mt-10 mb-4">${trimmed.slice(3)}</h2>`;
      }
      if (trimmed === '---') {
        return `<hr class="my-8 border-paper-border/80 dark:border-night-border/80" />`;
      }

      // Blockquote handling (> quote lines)
      if (trimmed.startsWith('> ') || trimmed.startsWith('>')) {
        const lines = trimmed.split('\n');
        const quoteContent = lines
          .map((line) => line.replace(/^>\s?/, ''))
          .join('<br />');
        let formattedQuote = quoteContent
          .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
          .replace(/\*(.*?)\*/g, '<em>$1</em>');
        return `<blockquote class="my-6 border-l-4 border-amber-600 dark:border-amber-400 bg-amber-500/8 dark:bg-amber-400/10 px-5 py-4 rounded-r-2xl font-serif text-base sm:text-lg text-paper-text dark:text-night-text italic leading-relaxed shadow-2xs">${formattedQuote}</blockquote>`;
      }

      // Convert **bold** and *italic*
      let formatted = trimmed
        .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
        .replace(/\*(.*?)\*/g, '<em>$1</em>')
        .replace(/\n/g, '<br />');

      // 1. Convert raw HTML sup footnote links (e.g. <sup id="fnref-1"><a href="#fn-1">[১]</a></sup>) to interactive buttons
      formatted = formatted.replace(/<sup[^>]*id="fnref-(\d+)"[^>]*><a[^>]*href="#fn-\d+"[^>]*>(.*?)<\/a><\/sup>/gi, (match, num, inner) => {
        return `<button type="button" data-fn-id="${num}" class="footnote-btn inline-flex items-center justify-center mx-1 px-2 py-0.5 rounded-lg text-xs font-mono font-bold bg-amber-500/15 dark:bg-amber-400/20 text-paper-accent dark:text-night-accent hover:bg-paper-accent hover:text-white dark:hover:bg-night-accent dark:hover:text-stone-900 transition-all cursor-pointer select-none align-super shadow-2xs"><span>${inner || '[' + num + ']'}</span></button>`;
      });

      // 2. Convert markdown footnote references like [1] or [১] to interactive buttons
      formatted = formatted.replace(/\[([0-9০-৯]+)\]/g, (match, numStr) => {
        const enNum = normalizeDigitId(numStr);
        return `<button type="button" data-fn-id="${enNum}" class="footnote-btn inline-flex items-center justify-center mx-1 px-2 py-0.5 rounded-lg text-xs font-mono font-bold bg-amber-500/15 dark:bg-amber-400/20 text-paper-accent dark:text-night-accent hover:bg-paper-accent hover:text-white dark:hover:bg-night-accent dark:hover:text-stone-900 transition-all cursor-pointer select-none align-super shadow-2xs"><span>[${numStr}]</span></button>`;
      });

      return `<p class="text-base sm:text-lg text-paper-text/90 dark:text-night-text/90 font-serif leading-relaxed mb-6">${formatted}</p>`;
    })
    .join('');
}

const renderedContent = renderBody(displayPost.body);
---

<Layout
  title={`${displayPost.title} | আফফান লাবীব (Affan Labib)`}
  description={displayPost.description}
  article={{
    publishedTime: displayPost.publishedAt,
    tags: displayPost.tags
  }}
>
  <!-- Reading Progress Bar -->
  <div class="fixed top-0 inset-x-0 h-1 z-50 bg-paper-border/40 dark:border-night-border/40">
    <div id="reading-progress" class="h-full bg-gradient-to-r from-paper-accent via-amber-500 to-orange-500 w-0 transition-all duration-75"></div>
  </div>

  <article id="article-main" class="max-w-3xl mx-auto space-y-8" data-is-fallback={isFallback ? 'true' : 'false'} data-slug={displayPost.slug}>
    <!-- Meta Header -->
    <header class="space-y-4 pb-8 border-b border-paper-border/80 dark:border-night-border/80">
      <div class="flex items-center gap-2 text-xs font-sans text-paper-muted dark:text-night-muted">
        <a href="/" class="hover:underline">প্রধান পাতা</a>
        <span>/</span>
        <a id="article-category-link" href={`/category/${displayPost.category}`} class="text-paper-accent dark:text-night-accent font-medium hover:underline">
          {categoryName}
        </a>
      </div>

      <h1 id="article-title" class="text-2xl sm:text-3xl md:text-4xl font-bold font-serif text-paper-text dark:text-night-text leading-tight tracking-tight">
        {displayPost.title}
      </h1>

      <div class="flex flex-wrap items-center justify-between gap-4 pt-2 text-xs font-sans text-paper-muted dark:text-night-muted">
        <div class="flex items-center gap-3">
          <ThemeAvatar
            class="w-9 h-9 rounded-full ring-2 ring-paper-accent/30 shrink-0"
            imgClass="w-full h-full object-contain p-0.5"
            alt="আফফান লাবীব"
          />
          <div>
            <span class="font-bold text-paper-text dark:text-night-text block author-name-text">আফফান লাবীব</span>
            <span class="text-[11px] author-edu-text">তাখাসসুস ফিল আদব ও ইসলামিক স্টাডিজ</span>
          </div>
        </div>

        <div class="flex items-center gap-2 flex-wrap">
          <time id="article-date" datetime={displayPost.publishedAt}>{displayPost.formattedDate}</time>
          <span>·</span>
          <span id="article-read-time">{readTimeBn} মিনিটে পাঠ্য</span>
          <span>·</span>
          <span id="article-views-top-badge" class="inline-flex items-center gap-1 font-mono text-paper-accent dark:text-night-accent font-medium" title="মোট পঠিত সংখ্যা">
            <span>👁️</span>
            <span id="article-views-count-top">{initialViewsBn}</span>
          </span>
        </div>
      </div>
    </header>

    <!-- Post Body Content -->
    <div id="article-body-content" class="prose dark:prose-invert max-w-none text-paper-text dark:text-night-text pt-2">
      <Fragment set:html={renderedContent} />
    </div>

    <!-- Footnotes Section if present -->
    {displayPost.footnotes && displayPost.footnotes.length > 0 && (
      <section class="mt-12 pt-6 border-t border-paper-border/80 dark:border-night-border/80">
        <h4 class="text-sm font-bold font-sans text-paper-accent dark:text-night-accent uppercase tracking-wider mb-4 flex items-center gap-2">
          <span>📑</span>
          <span>টীকা ও তথ্যসূত্র</span>
        </h4>
        <ol class="space-y-2 list-decimal list-inside text-xs sm:text-sm text-paper-muted dark:text-night-muted font-serif">
          {displayPost.footnotes.map((fn: any) => (
            <li id={`fn-${fn.id}`} class="leading-relaxed">
              <span class="font-serif">{fn.text}</span>
            </li>
          ))}
        </ol>
      </section>
    )}

    <!-- Footnotes JSON Store for client popover -->
    <script id="article-footnotes-data" type="application/json" set:html={JSON.stringify(displayPost.footnotes || [])} />

    <!-- Article Footer: Tags & Action Bar -->
    <footer class="pt-8 border-t border-paper-border/80 dark:border-night-border/80 space-y-6">
      <!-- Tags -->
      <div id="article-tags-container" class="flex flex-wrap items-center gap-2">
        <span class="text-xs font-sans text-paper-muted dark:text-night-muted">ট্যাগ:</span>
        {displayPost.tags.map((tag) => (
          <span class="px-3 py-1 rounded-full bg-paper-border/50 dark:bg-night-border/50 text-paper-muted dark:text-night-muted text-xs font-sans">
            #{tag}
          </span>
        ))}
      </div>

      <!-- Social Share Bar & Actions -->
      <div class="p-4 rounded-2xl border border-paper-border/70 dark:border-night-border/70 bg-paper-surface/60 dark:bg-night-surface/60 flex flex-wrap items-center justify-between gap-4 text-xs font-sans">
        <span class="font-medium text-paper-text dark:text-night-text flex items-center gap-1.5">
          <span>📤</span>
          <span>লেখাটি শেয়ার করুন:</span>
        </span>

        <div class="flex items-center gap-2 flex-wrap">
          <!-- Facebook Share -->
          <a
            id="share-fb-link"
            href={`https://www.facebook.com/sharer/sharer.php?u=https://affan-labib-blog.vercel.app/${displayPost.slug}`}
            target="_blank"
            rel="noopener noreferrer"
            class="px-3 py-1.5 rounded-lg bg-blue-600/10 text-blue-700 dark:text-blue-400 border border-blue-600/20 hover:bg-blue-600 hover:text-white transition-colors"
          >
            Facebook
          </a>

          <!-- WhatsApp Share -->
          <a
            id="share-wa-link"
            href={`https://api.whatsapp.com/send?text=${encodeURIComponent(displayPost.title + ' ' + 'https://affan-labib-blog.vercel.app/' + displayPost.slug)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="px-3 py-1.5 rounded-lg bg-emerald-600/10 text-emerald-700 dark:text-emerald-400 border border-emerald-600/20 hover:bg-emerald-600 hover:text-white transition-colors"
          >
            WhatsApp
          </a>

          <!-- Copy Link -->
          <button
            id="copy-link-btn"
            type="button"
            class="px-3 py-1.5 rounded-lg border border-paper-border dark:border-night-border hover:border-paper-accent transition-colors cursor-pointer"
          >
            লিঙ্ক কপি
          </button>

          <!-- Print Button -->
          <button
            onclick="window.print()"
            type="button"
            class="px-3 py-1.5 rounded-lg border border-paper-border dark:border-night-border hover:border-paper-accent transition-colors cursor-pointer"
          >
            🖨️ প্রিন্ট
          </button>
        </div>
      </div>
    </footer>

    <!-- Reader Reactions: Views & Minimalist Heart (❤️ ৪২) -->
    <div class="pt-8 border-t border-paper-border/80 dark:border-night-border/80 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-2 text-xs font-sans text-paper-muted dark:text-night-muted">
        <span>পাঠক প্রতিক্রিয়া:</span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-paper-border/40 dark:bg-night-border/40 font-mono text-paper-text dark:text-night-text">
          <span>👁️</span>
          <span id="article-views-count-bottom">{initialViewsBn}</span>
          <span class="font-sans text-[11px]">পঠিত</span>
        </span>
      </div>

      <!-- Minimalist Heart Button: icon + count only (❤️ ৪২) -->
      <button
        id="main-like-btn"
        type="button"
        class="group relative inline-flex items-center gap-2 px-6 py-2.5 rounded-full border border-rose-500/30 bg-rose-500/10 hover:bg-rose-500/20 active:scale-95 transition-all duration-200 cursor-pointer text-rose-600 dark:text-rose-400 font-bold shadow-2xs select-none"
        title="ভালো লাগলে ভালোবাসা দিন"
      >
        <span id="main-like-icon" class="text-xl transition-transform duration-200 group-hover:scale-125">🤍</span>
        <span id="main-like-count" data-likes={initialLikes || 0} class="font-mono text-base font-bold">{initialLikesBn}</span>
      </button>
    </div>
    <!-- Reader Comments (মন্তব্যঘর) Section -->
    <section id="comments-section" class="pt-10 border-t border-paper-border/80 dark:border-night-border/80 space-y-6">
      <div class="flex items-center justify-between">
        <div>
          <h3 class="text-xl sm:text-2xl font-bold font-serif text-paper-text dark:text-night-text flex items-center gap-2.5">
            <span>💬</span>
            <span>মন্তব্যঘর</span>
          </h3>
          <p class="text-xs font-serif text-paper-muted dark:text-night-muted mt-1">
            লেখাটি পড়ে আপনার অনুভূতি বা প্রাসঙ্গিক ভাবনা লিখে যেতে পারেন
          </p>
        </div>
        <span id="comments-total-badge" class="px-3 py-1 rounded-full text-xs font-mono font-bold bg-paper-accent/15 dark:bg-night-accent/20 text-paper-accent dark:text-night-accent border border-paper-accent/20">
          {initialCommentsCountBn}টি মন্তব্য
        </span>
      </div>

      <!-- Comment Submission Form -->
      <form id="comment-form" class="space-y-4 rounded-3xl border border-paper-border/80 dark:border-night-border/80 bg-paper-surface/85 dark:bg-night-surface/85 backdrop-blur-xl p-5 sm:p-6 shadow-xs">
        <div class="space-y-1.5">
          <label for="comment-author-input" class="block text-xs font-sans font-medium text-paper-muted dark:text-night-muted">
            আপনার নাম <span class="text-[11px] opacity-75">(ঐচ্ছিক — ফাঁকা রাখলে 'মুগ্ধ পাঠক' হিসেবে যাবে)</span>
          </label>
          <input
            type="text"
            id="comment-author-input"
            maxlength="50"
            placeholder="যেমন: সাদমান শাকিল (বা খালি রাখুন)"
            class="w-full px-4 py-2.5 rounded-xl border border-paper-border dark:border-night-border bg-paper-bg dark:bg-night-bg text-paper-text dark:text-night-text placeholder:text-paper-muted/60 text-sm font-sans focus:outline-none focus:ring-2 focus:ring-paper-accent/40 transition-all"
          />
        </div>

        <div class="space-y-1.5">
          <label for="comment-body-input" class="block text-xs font-sans font-medium text-paper-text dark:text-night-text">
            আপনার মন্তব্য <span class="text-rose-500">*</span>
          </label>
          <textarea
            id="comment-body-input"
            rows="3"
            maxlength="800"
            required
            placeholder="লেখাটি পড়ে আপনার ভাবনা বা ভালোলাগার কথা লিখুন..."
            class="w-full px-4 py-3 rounded-xl border border-paper-border dark:border-night-border bg-paper-bg dark:bg-night-bg text-paper-text dark:text-night-text placeholder:text-paper-muted/60 text-sm font-serif leading-relaxed focus:outline-none focus:ring-2 focus:ring-paper-accent/40 transition-all resize-y"
          ></textarea>
        </div>

        <div class="flex items-center justify-between pt-1">
          <span id="comment-char-counter" class="text-[11px] font-mono text-paper-muted dark:text-night-muted">
            ৮০০ অক্ষর বাকি
          </span>

          <button
            id="comment-submit-btn"
            type="submit"
            class="px-5 py-2.5 rounded-xl bg-paper-accent hover:opacity-90 active:scale-95 text-white font-sans text-xs sm:text-sm font-semibold transition-all shadow-xs flex items-center gap-2 cursor-pointer disabled:opacity-50"
          >
            <span>মন্তব্য প্রকাশ করুন</span>
            <span>✉️</span>
          </button>
        </div>

        <p id="comment-form-status" class="text-xs font-sans text-emerald-600 dark:text-emerald-400 hidden pt-1"></p>
      </form>

      <!-- Live Comments Stream Container -->
      <div id="comments-stream-container" class="space-y-4">
        <div id="comments-loading" class="hidden py-6 text-center text-xs font-sans text-paper-muted animate-pulse">
          মন্তব্য লোড হচ্ছে...
        </div>
        <div id="comments-empty" class={initialComments.length === 0 ? "py-8 text-center rounded-2xl border border-dashed border-paper-border/80 dark:border-night-border/80 text-sm font-serif text-paper-muted" : "hidden py-8 text-center rounded-2xl border border-dashed border-paper-border/80 dark:border-night-border/80 text-sm font-serif text-paper-muted"}>
          🍃 এখনো কোনো মন্তব্য আসেনি। লেখাটি সম্পর্কে প্রথম মন্তব্যটি আপনিই করুন!
        </div>
        <div id="comments-list" class="space-y-4">
          {initialComments.map((c) => (
            <div class={`p-4 sm:p-5 rounded-2xl border ${c.isAuthor ? 'border-amber-500/40 dark:border-amber-400/40 bg-amber-500/5 dark:bg-amber-400/5' : 'border-paper-border/80 dark:border-night-border/80 bg-paper-surface/80 dark:bg-night-surface/80'} backdrop-blur-xl transition-all shadow-2xs space-y-2`}>
              <div class="flex items-center justify-between gap-2 text-xs font-sans">
                <div class="flex items-center gap-2">
                  <span class="font-bold font-serif text-paper-text dark:text-night-text text-sm">{c.authorName}</span>
                  {c.isAuthor && (
                    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-sans font-bold bg-amber-500/20 text-amber-700 dark:text-amber-300 border border-amber-500/30">✍️ লেখক</span>
                  )}
                </div>
              </div>
              <p class="text-sm sm:text-base font-serif text-paper-text/90 dark:text-night-text/90 leading-relaxed whitespace-pre-wrap">{c.content}</p>
              {c.replies && c.replies.length > 0 && (
                <div class="mt-3 pl-4 sm:pl-6 border-l-2 border-amber-500/30 space-y-3">
                  {c.replies.map((r) => (
                    <div class="p-3 sm:p-4 rounded-xl bg-amber-500/10 dark:bg-amber-400/10 border border-amber-500/25 space-y-1.5">
                      <div class="flex items-center gap-2">
                        <span class="font-bold font-serif text-paper-text dark:text-night-text text-xs">{r.authorName}</span>
                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-sans font-bold bg-amber-500/25 text-amber-800 dark:text-amber-200">✍️ লেখক</span>
                      </div>
                      <p class="text-xs sm:text-sm font-serif text-paper-text/95 dark:text-night-text/95 leading-relaxed whitespace-pre-wrap">{r.content}</p>
                    </div>
                  ))}
                </div>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>
  </article>

  <!-- Floating Quick-Love Action Pill (Reveals on scroll) -->
  <aside
    id="floating-love-pill"
    class="fixed bottom-6 right-6 z-40 transform translate-y-20 opacity-0 transition-all duration-300 pointer-events-none"
    aria-label="কুইক লাইক"
  >
    <button
      id="floating-like-btn"
      type="button"
      class="group flex items-center gap-2 px-4 py-2.5 rounded-full bg-paper-surface/95 dark:bg-night-surface/95 backdrop-blur-xl border border-rose-500/40 shadow-xl hover:shadow-2xl active:scale-95 transition-all text-rose-600 dark:text-rose-400 font-bold text-sm cursor-pointer select-none"
      title="ভালো লাগলে ভালোবাসা দিন"
    >
      <span id="floating-like-icon" class="text-lg transition-transform duration-200 group-hover:scale-125">🤍</span>
      <span id="floating-like-count" data-likes={initialLikes || 0} class="font-mono text-sm font-bold">{initialLikesBn}</span>
    </button>
  </aside>

  <!-- In-Situ Footnote Popover Modal (Full Focus Backdrop) -->
  <div
    id="footnote-popover-modal"
    class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-md opacity-0 pointer-events-none transition-all duration-200"
    role="dialog"
    aria-modal="true"
  >
    <div
      id="footnote-popover-card"
      class="bg-[#FAF7F2] dark:bg-[#1C1917] border-2 border-amber-600/40 dark:border-amber-400/40 rounded-3xl max-w-lg w-full p-6 sm:p-7 shadow-2xl space-y-5 transform translate-y-6 transition-all duration-200"
    >
      <div class="flex items-center justify-between pb-3 border-b border-amber-900/10 dark:border-amber-100/10">
        <span class="text-sm font-sans font-bold text-amber-800 dark:text-amber-400 fn-modal-title flex items-center gap-2">
          <span class="text-lg">📌</span>
          <span>টীকা ও তথ্যসূত্র <span id="fn-popover-num" class="font-mono text-base">[১]</span></span>
        </span>
        <button id="close-fn-popover-btn" type="button" class="text-stone-500 dark:text-stone-400 hover:text-stone-900 dark:hover:text-stone-100 text-xl p-1.5 rounded-xl hover:bg-stone-200/50 dark:hover:bg-stone-800 transition-colors cursor-pointer" aria-label="বন্ধ করুন">✕</button>
      </div>

      <div class="py-2 min-h-[60px]">
        <p id="fn-popover-content" class="text-base sm:text-lg font-serif text-stone-900 dark:text-stone-100 leading-relaxed">
          টীকা লোড হচ্ছে...
        </p>
      </div>

      <div class="pt-3 flex items-center justify-between border-t border-amber-900/10 dark:border-amber-100/10">
        <span class="text-xs text-stone-500 dark:text-stone-400 font-sans">
          পড়া শেষে মূল লেখায় ফিরে যান
        </span>
        <button id="done-fn-popover-btn" type="button" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-amber-700 hover:bg-amber-800 dark:bg-amber-500 dark:hover:bg-amber-400 text-white dark:text-stone-950 font-sans text-xs font-semibold shadow-md cursor-pointer transition-all">
          <span>← ফিরে যান লেখাতে</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Client-side Views & Persistent Cloud Love Script -->
  <script is:inline>
    (function initInteractions() {
      const slug = document.getElementById('article-main')?.getAttribute('data-slug');
      if (!slug) return;

      const bnDigits = ['০', '১', '২', '৩', '৪', '৫', '৬', '৭', '৮', '৯'];
      function toBn(n) {
        return (n ?? 0).toString().replace(/[0-9]/g, (d) => bnDigits[parseInt(d, 10)]);
      }

      const topViewsEl = document.getElementById('article-views-count-top');
      const bottomViewsEl = document.getElementById('article-views-count-bottom');
      const mainLikeBtn = document.getElementById('main-like-btn');
      const mainLikeIcon = document.getElementById('main-like-icon');
      const mainLikeCount = document.getElementById('main-like-count');
      const floatingPill = document.getElementById('floating-love-pill');
      const floatingLikeBtn = document.getElementById('floating-like-btn');
      const floatingLikeIcon = document.getElementById('floating-like-icon');
      const floatingLikeCount = document.getElementById('floating-like-count');

      const commentsTotalBadge = document.getElementById('comments-total-badge');
      const commentForm = document.getElementById('comment-form');
      const commentAuthorInput = document.getElementById('comment-author-input');
      const commentBodyInput = document.getElementById('comment-body-input');
      const commentCharCounter = document.getElementById('comment-char-counter');
      const commentSubmitBtn = document.getElementById('comment-submit-btn');
      const commentFormStatus = document.getElementById('comment-form-status');
      const commentsLoading = document.getElementById('comments-loading');
      const commentsEmpty = document.getElementById('comments-empty');
      const commentsList = document.getElementById('comments-list');

      function renderComments(comments) {
        if (commentsLoading) commentsLoading.classList.add('hidden');
        if (!comments || comments.length === 0) {
          if (commentsEmpty) commentsEmpty.classList.remove('hidden');
          if (commentsTotalBadge) commentsTotalBadge.textContent = '০টি মন্তব্য';
          if (commentsList) commentsList.innerHTML = '';
          return;
        }

        if (commentsEmpty) commentsEmpty.classList.add('hidden');
        if (commentsTotalBadge) commentsTotalBadge.textContent = `${toBn(comments.length)}টি মন্তব্য`;

        if (!commentsList) return;
        commentsList.innerHTML = comments.map((c) => {
          const isAuthor = c.isAuthor;
          const authorBadge = isAuthor
            ? `<span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-sans font-bold bg-amber-500/20 text-amber-700 dark:text-amber-300 border border-amber-500/30">✍️ লেখক</span>`
            : '';
          const cardBorder = isAuthor
            ? 'border-amber-500/40 dark:border-amber-400/40 bg-amber-500/5 dark:bg-amber-400/5'
            : 'border-paper-border/80 dark:border-night-border/80 bg-paper-surface/80 dark:bg-night-surface/80';

          const repliesHtml = (c.replies && c.replies.length > 0)
            ? `<div class="mt-3 pl-4 sm:pl-6 border-l-2 border-amber-500/30 space-y-3">
                ${c.replies.map((r) => `
                  <div class="p-3 sm:p-4 rounded-xl bg-amber-500/10 dark:bg-amber-400/10 border border-amber-500/25 space-y-1.5">
                    <div class="flex items-center gap-2">
                      <span class="font-bold font-serif text-paper-text dark:text-night-text text-xs">${r.authorName}</span>
                      <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-sans font-bold bg-amber-500/25 text-amber-800 dark:text-amber-200">✍️ লেখক</span>
                    </div>
                    <p class="text-xs sm:text-sm font-serif text-paper-text/95 dark:text-night-text/95 leading-relaxed whitespace-pre-wrap">${r.content}</p>
                  </div>
                `).join('')}
              </div>`
            : '';

          return `
            <div class="p-4 sm:p-5 rounded-2xl border ${cardBorder} backdrop-blur-xl transition-all shadow-2xs space-y-2">
              <div class="flex items-center justify-between gap-2 text-xs font-sans">
                <div class="flex items-center gap-2">
                  <span class="font-bold font-serif text-paper-text dark:text-night-text text-sm">${c.authorName}</span>
                  ${authorBadge}
                </div>
              </div>
              <p class="text-sm sm:text-base font-serif text-paper-text/90 dark:text-night-text/90 leading-relaxed whitespace-pre-wrap">${c.content}</p>
              ${repliesHtml}
            </div>
          `;
        }).join('');
      }

      let currentLikes = parseInt(mainLikeCount?.getAttribute('data-likes') || '0', 10);
      let isLiked = false;

      try {
        isLiked = localStorage.getItem('liked_' + slug) === 'true';
      } catch (_) {}

      function updateLikeUI(liked, count) {
        if (typeof count === 'number' && !isNaN(count)) {
          currentLikes = count;
          const countBn = toBn(count);
          if (mainLikeCount) mainLikeCount.textContent = countBn;
          if (floatingLikeCount) floatingLikeCount.textContent = countBn;
        }

        if (liked) {
          if (mainLikeIcon) mainLikeIcon.textContent = '❤️';
          if (floatingLikeIcon) floatingLikeIcon.textContent = '❤️';
          mainLikeBtn?.classList.add('bg-rose-500/25', 'border-rose-500', 'shadow-md');
          floatingLikeBtn?.classList.add('bg-rose-500/25', 'border-rose-500');
        } else {
          if (mainLikeIcon) mainLikeIcon.textContent = '🤍';
          if (floatingLikeIcon) floatingLikeIcon.textContent = '🤍';
          mainLikeBtn?.classList.remove('bg-rose-500/25', 'border-rose-500', 'shadow-md');
          floatingLikeBtn?.classList.remove('bg-rose-500/25', 'border-rose-500');
        }
      }

      // Immediately render local like state on mount with zero delay
      updateLikeUI(isLiked, currentLikes);

      // 1. Deduplicated View Counter Call (increments once per session)
      try {
        const sessionKey = 'viewed_art_' + slug;
        if (!sessionStorage.getItem(sessionKey)) {
          fetch('/api/interactions', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ slug, action: 'view' })
          }).then((r) => r.json()).then((res) => {
            if (res && res.views !== undefined) {
              const b = toBn(res.views);
              if (topViewsEl) topViewsEl.textContent = b;
              if (bottomViewsEl) bottomViewsEl.textContent = b;
              sessionStorage.setItem(sessionKey, '1');
            }
          }).catch(() => {});
        }
      } catch (_) {}

      // 2. Fetch fresh stats and comments from Cloud DB with cache busting
      fetch(`/api/interactions?slug=${encodeURIComponent(slug)}&_t=${Date.now()}`)
        .then((r) => r.json())
        .then((data) => {
          if (data && data.success) {
            if (data.stats) {
              const v = toBn(data.stats.views || 0);
              if (topViewsEl) topViewsEl.textContent = v;
              if (bottomViewsEl) bottomViewsEl.textContent = v;
              updateLikeUI(isLiked, data.stats.likes || 0);
            }
            renderComments(data.comments || []);
          }
        })
        .catch(() => {
          if (commentsLoading) commentsLoading.classList.add('hidden');
          if (commentsEmpty) commentsEmpty.classList.remove('hidden');
        });

      // 3. Like Toggle Handler (Syncs to Cloud permanently with lock)
      let isLikingInProgress = false;
      function handleLikeClick() {
        if (isLikingInProgress) return;
        isLikingInProgress = true;

        const nextLiked = !isLiked;
        isLiked = nextLiked;
        try {
          localStorage.setItem('liked_' + slug, nextLiked ? 'true' : 'false');
        } catch (_) {}

        const nextCount = nextLiked ? currentLikes + 1 : Math.max(0, currentLikes - 1);
        updateLikeUI(nextLiked, nextCount);

        // Micro-bounce animation
        mainLikeBtn?.classList.add('scale-110');
        floatingLikeBtn?.classList.add('scale-110');
        setTimeout(() => {
          mainLikeBtn?.classList.remove('scale-110');
          floatingLikeBtn?.classList.remove('scale-110');
        }, 200);

        fetch('/api/interactions', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ slug, action: 'like', isLike: nextLiked })
        })
          .then((r) => r.json())
          .then((res) => {
            if (res && res.likes !== undefined) {
              updateLikeUI(isLiked, res.likes);
            }
          })
          .catch((err) => {
            console.error('Like toggle error:', err);
          })
          .finally(() => {
            setTimeout(() => { isLikingInProgress = false; }, 300);
          });
      }

      mainLikeBtn?.addEventListener('click', handleLikeClick);
      floatingLikeBtn?.addEventListener('click', handleLikeClick);

      // Comment character counter
      commentBodyInput?.addEventListener('input', () => {
        const remaining = 800 - (commentBodyInput.value || '').length;
        if (commentCharCounter) commentCharCounter.textContent = `${toBn(Math.max(0, remaining))} অক্ষর বাকি`;
      });

      // Comment Form Submission Handler (Live Cloud Submission)
      commentForm?.addEventListener('submit', (e) => {
        e.preventDefault();
        const content = (commentBodyInput?.value || '').trim();
        if (!content) return;

        const authorName = (commentAuthorInput?.value || '').trim() || 'মুগ্ধ পাঠক';
        if (commentSubmitBtn) commentSubmitBtn.disabled = true;

        fetch('/api/interactions', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ slug, action: 'comment', authorName, content })
        })
          .then((r) => r.json())
          .then((res) => {
            if (commentSubmitBtn) commentSubmitBtn.disabled = false;
            if (res && res.success && res.comment) {
              if (commentBodyInput) commentBodyInput.value = '';
              if (commentAuthorInput) commentAuthorInput.value = '';
              if (commentFormStatus) {
                commentFormStatus.textContent = '✓ আপনার মন্তব্যটি সরাসরি প্রকাশিত হয়েছে। অনেক ধন্যবাদ!';
                commentFormStatus.classList.remove('hidden');
                setTimeout(() => commentFormStatus.classList.add('hidden'), 4000);
              }

              if (commentsEmpty) commentsEmpty.classList.add('hidden');
              const newCardHtml = `
                <div class="p-4 sm:p-5 rounded-2xl border border-paper-border/80 dark:border-night-border/80 bg-paper-surface/80 dark:bg-night-surface/80 backdrop-blur-xl transition-all shadow-2xs space-y-2 animate-fadeIn">
                  <div class="flex items-center justify-between gap-2 text-xs font-sans">
                    <div class="flex items-center gap-2">
                      <span class="font-bold font-serif text-paper-text dark:text-night-text text-sm">${res.comment.authorName}</span>
                    </div>
                  </div>
                  <p class="text-sm sm:text-base font-serif text-paper-text/90 dark:text-night-text/90 leading-relaxed whitespace-pre-wrap">${res.comment.content}</p>
                </div>
              `;
              if (commentsList) {
                commentsList.insertAdjacentHTML('afterbegin', newCardHtml);
                const total = commentsList.children.length;
                if (commentsTotalBadge) commentsTotalBadge.textContent = `${toBn(total)}টি মন্তব্য`;
              }
            } else {
              alert(res?.error || 'মন্তব্য পাঠাতে সমস্যা হয়েছে। আবার চেষ্টা করুন।');
            }
          })
          .catch(() => {
            if (commentSubmitBtn) commentSubmitBtn.disabled = false;
            alert('নেটওয়ার্ক সংযোগ পরীক্ষা করুন।');
          });
      });

      // 4. Floating Love Pill scroll reveal
      window.addEventListener('scroll', () => {
        if (!floatingPill) return;
        if (window.scrollY > 300) {
          floatingPill.classList.remove('translate-y-20', 'opacity-0', 'pointer-events-none');
          floatingPill.classList.add('translate-y-0', 'opacity-100', 'pointer-events-auto');
        } else {
          floatingPill.classList.add('translate-y-20', 'opacity-0', 'pointer-events-none');
          floatingPill.classList.remove('translate-y-0', 'opacity-100', 'pointer-events-auto');
        }
      }, { passive: true });
    })();
  </script>
</Layout>


<script is:inline>
  (() => {
    // Reading Progress Indicator
    window.addEventListener('scroll', () => {
      const progressBar = document.getElementById('reading-progress');
      if (!progressBar) return;
      const winScroll = document.documentElement.scrollTop || document.body.scrollTop;
      const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      const scrolled = height > 0 ? (winScroll / height) * 100 : 0;
      progressBar.style.width = scrolled + '%';
    }, { passive: true });

    // Copy Article Link
    const copyBtn = document.getElementById('copy-link-btn');
    copyBtn?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        const prev = copyBtn.innerText;
        copyBtn.innerText = 'কপি হয়েছে!';
        setTimeout(() => { copyBtn.innerText = prev; }, 2000);
      } catch (err) {}
    });

    // Offline-Aware External Social Sharing Check
    const shareFb = document.getElementById('share-fb-link');
    const shareWa = document.getElementById('share-wa-link');

    [shareFb, shareWa].forEach((btn) => {
      btn?.addEventListener('click', (e) => {
        if (!navigator.onLine) {
          e.preventDefault();
          alert('📶 সোশ্যাল মিডিয়ায় শেয়ার করার জন্য ইন্টারনেট সংযোগ প্রয়োজন।\n\nআপনি অফলাইনে লেখাটির লিঙ্ক সংরক্ষণ করতে চাইলে "লিঙ্ক কপি" বোতামটি ব্যবহার করতে পারেন।');
        }
      });
    });

    // In-situ Footnote Popover
    const modal = document.getElementById('footnote-popover-modal');
    const card = document.getElementById('footnote-popover-card');
    const fnNum = document.getElementById('fn-popover-num');
    const fnContent = document.getElementById('fn-popover-content');
    const closeBtn = document.getElementById('close-fn-popover-btn');
    const doneBtn = document.getElementById('done-fn-popover-btn');

    const bnDigits = ['০', '১', '২', '৩', '৪', '৫', '৬', '৭', '৮', '৯'];
    const bnToEnMap = { '০':'0', '১':'1', '২':'2', '৩':'3', '৪':'4', '৫':'5', '৬':'6', '৭':'7', '৮':'8', '৯':'9' };
    function toEn(str) {
      return String(str || '').replace(/[০-৯]/g, (d) => bnToEnMap[d] || d);
    }
    function toBn(str) {
      return String(str || '').replace(/[0-9]/g, (d) => bnDigits[Number(d)] || d);
    }

    let footnotesMap = {};
    const fnDataEl = document.getElementById('article-footnotes-data');
    if (fnDataEl) {
      try {
        const raw = JSON.parse(fnDataEl.textContent || '[]');
        raw.forEach((f) => {
          const enId = toEn(f.id);
          const bnId = toBn(f.id);
          footnotesMap[f.id] = f.text;
          footnotesMap[enId] = f.text;
          footnotesMap[bnId] = f.text;
        });
      } catch (e) {}
    }

    function openFootnote(rawId, fallback) {
      if (!modal || !card) return;
      const enId = toEn(rawId);
      const bnId = toBn(rawId);
      if (fnNum) fnNum.textContent = `[${bnId || rawId}]`;

      let text = footnotesMap[rawId] || footnotesMap[enId] || footnotesMap[bnId] || fallback;
      if (!text) {
        const targetLi = document.getElementById(`fn-${rawId}`) || document.getElementById(`fn-${enId}`) || document.getElementById(`fn-${bnId}`);
        if (targetLi) text = targetLi.textContent.trim();
      }
      if (fnContent) fnContent.textContent = text || 'কোনো টীকা পাওয়া যায়নি।';
      modal.classList.remove('opacity-0', 'pointer-events-none');
      card.classList.remove('translate-y-6');
      card.classList.add('translate-y-0');
    }

    function closeFootnote() {
      if (!modal || !card) return;
      modal.classList.add('opacity-0', 'pointer-events-none');
      card.classList.add('translate-y-6');
      card.classList.remove('translate-y-0');
    }

    closeBtn?.addEventListener('click', closeFootnote);
    doneBtn?.addEventListener('click', closeFootnote);
    modal?.addEventListener('click', (e) => { if (e.target === modal) closeFootnote(); });
    window.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeFootnote(); });

    // 1. Intercept all .footnote-btn clicks
    document.querySelectorAll('.footnote-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const dataId = btn.getAttribute('data-fn-id');
        const textDigits = btn.textContent.replace(/[^0-9০-৯]/g, '');
        const fnId = dataId || textDigits;
        openFootnote(fnId, '');
      });
    });

    // 2. Intercept any native anchor tags pointing to footnotes (e.g. href="#fn-1", href="#fn:1")
    document.querySelectorAll('a[href*="#fn-"], a[href*="#fn:"]').forEach((a) => {
      a.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const href = a.getAttribute('href') || '';
        const match = href.match(/#fn[-:]?([0-9০-৯]+)/i);
        const fnId = match ? match[1] : a.textContent.replace(/[^0-9০-৯]/g, '');
        openFootnote(fnId, '');
      });
    });

    // Check if this article was deleted by author
    try {
      const deletedSlugs = JSON.parse(localStorage.getItem('kherokhata_deleted_posts') || '[]');
      const pathSlug = window.location.pathname.replace(/^\/|\/$/g, '');
      if (deletedSlugs.includes(pathSlug)) {
        const article = document.querySelector('article');
        if (article) {
          article.innerHTML = `
            <div class="py-20 text-center space-y-4">
              <span class="text-4xl block">🍃</span>
              <h2 class="text-2xl font-bold font-serif text-paper-text dark:text-night-text">এই রচনাটি মুছে ফেলা হয়েছে</h2>
              <p class="text-sm font-serif text-paper-muted dark:text-night-muted">লেখক এই লেখাটি মুছে ফেলেছেন বা সরিয়ে নিয়েছেন।</p>
              <a href="/" class="inline-block px-5 py-2.5 rounded-xl bg-paper-accent dark:bg-night-accent text-white font-sans text-xs font-semibold hover:opacity-95">
                ← প্রধান পাতায় ফিরে যান
              </a>
            </div>
          `;
          return;
        }
      }
    } catch (e) {}

    // Resilient Fallback Hydration for newly written posts
    const articleEl = document.getElementById('article-main');
    const isFallbackMode = articleEl?.getAttribute('data-is-fallback') === 'true';
    const currentSlug = articleEl?.getAttribute('data-slug') || window.location.pathname.replace(/^\/|\/$/g, '');

    if (isFallbackMode && currentSlug) {
      function hydrateDynamicPost(p) {
        if (!p) return;
        document.title = `${p.title} | আফফান লাবীব`;

        const titleEl = document.getElementById('article-title');
        if (titleEl) titleEl.innerText = p.title;

        const catEl = document.getElementById('article-category-link');
        const categoryLabels = {
          chinta: 'চিন্তা',
          pathalap: 'পাঠালাপ',
          itihas: 'ইতিহাস',
          'boi-alochona': 'বই-আলোচনা',
          onubad: 'অনুবাদ',
          dinlipi: 'দিনলিপি',
          smritikotha: 'স্মৃতিকথা',
          bhromongatha: 'ভ্রমণগাঁথা',
          goddo: 'গদ্য'
        };
        if (catEl) {
          catEl.innerText = categoryLabels[p.category] || p.category;
          catEl.href = `/category/${p.category}`;
        }

        const dateEl = document.getElementById('article-date');
        if (dateEl) dateEl.innerText = p.formattedDate || p.publishedAt;

        const words = p.wordCount || (p.body ? p.body.trim().split(/\s+/).length : 200);
        const readMins = Math.max(1, Math.ceil(words / 100));
        const bnDigits = ['০', '১', '২', '৩', '৪', '৫', '৬', '৭', '৮', '৯'];
        const readMinsBn = readMins.toString().replace(/[0-9]/g, (d) => bnDigits[parseInt(d, 10)]);
        const readEl = document.getElementById('article-read-time');
        if (readEl) readEl.innerText = `${readMinsBn} মিনিটে পাঠ্য`;

        const bodyEl = document.getElementById('article-body-content');
        if (bodyEl && p.body) {
          const paragraphs = p.body.split('\n\n');
          bodyEl.innerHTML = paragraphs.map((item) => {
            const trimmed = item.trim();
            if (!trimmed) return '';
            if (trimmed.startsWith('### ')) return `<h3 class="text-xl sm:text-2xl font-bold font-serif text-paper-text dark:text-night-text mt-8 mb-3">${trimmed.slice(4)}</h3>`;
            if (trimmed.startsWith('## ')) return `<h2 class="text-2xl sm:text-3xl font-bold font-serif text-paper-text dark:text-night-text mt-10 mb-4">${trimmed.slice(3)}</h2>`;
            if (trimmed === '---') return `<hr class="my-8 border-paper-border/80 dark:border-night-border/80" />`;
            if (trimmed.startsWith('> ') || trimmed.startsWith('>')) {
              const lines = trimmed.split('\n');
              const quoteContent = lines.map((l) => l.replace(/^>\s?/, '')).join('<br />');
              let formattedQuote = quoteContent.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>').replace(/\*(.*?)\*/g, '<em>$1</em>');
              return `<blockquote class="my-6 border-l-4 border-amber-600 dark:border-amber-400 bg-amber-500/8 dark:bg-amber-400/10 px-5 py-4 rounded-r-2xl font-serif text-base sm:text-lg text-paper-text dark:text-night-text italic leading-relaxed shadow-2xs">${formattedQuote}</blockquote>`;
            }
            let formatted = trimmed.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>').replace(/\*(.*?)\*/g, '<em>$1</em>').replace(/\n/g, '<br />');
            formatted = formatted.replace(/\[(\d+)\]/g, `<button type="button" data-fn-id="$1" class="footnote-btn inline-flex items-center justify-center mx-1 px-1.5 py-0.5 rounded text-xs font-mono font-bold bg-amber-500/15 dark:bg-amber-400/20 text-paper-accent dark:text-night-accent hover:bg-paper-accent hover:text-white dark:hover:bg-night-accent dark:hover:text-stone-900 transition-colors cursor-pointer select-none align-super"><span>[$1]</span></button>`);
            return `<p class="text-base sm:text-lg text-paper-text/90 dark:text-night-text/90 font-serif leading-relaxed mb-6">${formatted}</p>`;
          }).join('');

          bodyEl.querySelectorAll('.footnote-btn').forEach((btn) => {
            btn.addEventListener('click', (ev) => {
              ev.preventDefault();
              ev.stopPropagation();
              const fnId = btn.getAttribute('data-fn-id');
              const fnItem = (p.footnotes || []).find((f) => f.id == fnId);
              openFootnote(fnId, fnItem ? fnItem.text : '');
            });
          });
        }

        if (Array.isArray(p.footnotes)) {
          p.footnotes.forEach((f) => { footnotesMap[f.id] = f.text; });
        }
      }

      // 1. Check localStorage first
      let localFound = null;
      try {
        const custom = JSON.parse(localStorage.getItem('kherokhata_custom_posts') || '[]');
        localFound = custom.find((p) => p.slug === currentSlug);
      } catch (e) {}

      if (localFound) {
        hydrateDynamicPost(localFound);
      } else {
        // 2. Fetch from /api/posts
        fetch('/api/posts', { cache: 'no-store' })
          .then((r) => r.json())
          .then((d) => {
            if (d && Array.isArray(d.posts)) {
              const sp = d.posts.find((p) => p.slug === currentSlug);
              if (sp) {
                hydrateDynamicPost(sp);
              } else {
                if (articleEl) {
                  articleEl.innerHTML = `
                    <div class="py-20 text-center space-y-4">
                      <span class="text-4xl block">🍃</span>
                      <h2 class="text-2xl font-bold font-serif text-paper-text dark:text-night-text">এই রচনাটি খুঁজে পাওয়া যায়নি</h2>
                      <p class="text-sm font-serif text-paper-muted dark:text-night-muted">সম্ভবত লেখাটি এখনো প্রকাশিত হয়নি অথবা লেখক সরিয়ে নিয়েছেন।</p>
                      <a href="/" class="inline-block px-5 py-2.5 rounded-xl bg-paper-accent dark:bg-night-accent text-white font-sans text-xs font-semibold hover:opacity-95">
                        ← প্রধান পাতায় ফিরে যান
                      </a>
                    </div>
                  `;
                }
              }
            }
          })
          .catch(() => {});
      }
    }
  })();
</script>
