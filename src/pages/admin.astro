              <p class="text-xs text-paper-muted font-sans mt-0.5">সরাসরি পাঠকদের মন্তব্যের উত্তর দিন বা মুছুন</p>
            </div>
            <span id="admin-comments-feed-badge" class="px-3 py-1 rounded-full text-xs font-serif font-bold bg-amber-500/15 text-amber-900 dark:text-amber-200 border border-amber-500/30">
              {ssrTotalCommentsBn}টি মন্তব্য
            </span>
          </div>

          <!-- SSR Pre-rendered Comments Moderation Feed (Zero 'লোড হচ্ছে...') -->
          <div id="admin-comments-feed-list" class="space-y-3.5 max-h-[550px] overflow-y-auto pr-1">
            {ssrComments.length === 0 ? (
              <div class="py-12 text-center rounded-2xl border border-dashed border-paper-border dark:border-night-border text-xs font-serif text-paper-muted">
                🍃 পাঠকদের কোনো মন্তব্য এখনো আসেনি।
              </div>
            ) : (
              ssrComments.map((c, index) => {
                const postMatch = posts.find((p) => p.slug === c.slug);
                const postTitle = postMatch ? postMatch.title : c.slug;
                const authorInitial = (c.authorName || 'পা')[0] || 'পা';
                const safeId = String(c.id || '').trim() || ('cmt_ssr_' + index);

                return (
                  <div class="comment-card-item p-4 rounded-2xl border border-paper-border/80 dark:border-night-border/80 bg-paper-bg/60 dark:bg-night-bg/60 space-y-3 transition-all hover:border-paper-accent/30" data-comment-id={safeId} data-comment-content={c.content}>
                    <div class="flex items-start justify-between gap-3 text-xs">
                      <div class="flex items-start gap-2.5">
                        <div class="w-8 h-8 rounded-full bg-amber-500/20 text-amber-900 dark:text-amber-200 font-serif font-bold flex items-center justify-center shrink-0 border border-amber-500/30">
                          {c.isAuthor ? '👑' : authorInitial}
                        </div>
                        <div>
                          <div class="flex items-center gap-2">
                            <span class="font-bold font-serif text-paper-text dark:text-night-text text-sm">{c.authorName || 'মুগ্ধ পাঠক'}</span>
                            {c.isAuthor && (
                              <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-amber-500/20 text-amber-800 dark:text-amber-200 border border-amber-500/30">লেখক</span>
                            )}
                          </div>
                          <a href={`/${c.slug}`} target="_blank" class="text-xs font-sans text-paper-accent dark:text-night-accent hover:underline block truncate max-w-[200px] sm:max-w-xs mt-0.5">
                            রচনা: {postTitle}
                          </a>
                        </div>
                      </div>
                      <time class="text-[10px] font-sans text-paper-muted dark:text-night-muted shrink-0">
                        {c.createdAt ? new Date(c.createdAt).toLocaleDateString('bn-BD', { day: 'numeric', month: 'short', year: 'numeric' }) : ''}
                      </time>
                    </div>

                    <div class="comment-body-text text-xs sm:text-sm font-serif text-paper-text dark:text-night-text leading-relaxed bg-paper-surface/60 dark:bg-night-surface/60 p-3 rounded-xl border border-paper-border/60 whitespace-pre-wrap">
                      {c.content}
                    </div>

                    <div class="flex items-center justify-between pt-1 text-xs">
                      <button
                        type="button"
                        class="admin-reply-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl border border-paper-accent/30 text-paper-accent dark:text-night-accent hover:bg-paper-accent/10 transition-colors font-serif text-xs font-medium cursor-pointer"
                        data-slug={c.slug}
                        data-id={safeId}
                        data-author={c.authorName}
                      >
                        <span>✍️</span>
                        <span>উত্তর দিন</span>
                      </button>

                      <div class="del-wrap flex items-center gap-1.5">
                        <button
                          type="button"
                          class="admin-delete-cmt-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl border border-rose-500/30 text-rose-700 dark:text-rose-400 hover:bg-rose-500/10 transition-colors font-serif text-xs font-medium cursor-pointer"
                          data-id={safeId}
                          title="মন্তব্যটি সম্পূর্ণ মুছে ফেলুন"
                        >
                          <span>🗑️</span>
                          <span>মুছে ফেলুন</span>
                        </button>
                        <div class="confirm-del-box hidden flex items-center gap-1.5 bg-rose-500/15 px-2.5 py-1 rounded-xl border border-rose-500/30">
                          <span class="text-[11px] font-sans font-semibold text-rose-700 dark:text-rose-400">মুছবেন?</span>
                          <button type="button" class="confirm-del-yes-btn px-2.5 py-1 rounded-lg bg-rose-600 text-white font-bold text-xs hover:bg-rose-700 cursor-pointer shadow-2xs" data-id={safeId}>হ্যাঁ</button>
                          <button type="button" class="confirm-del-no-btn px-2 py-1 rounded-lg text-paper-muted hover:text-paper-text text-xs cursor-pointer">না</button>
                        </div>
                      </div>
                    </div>

                    <!-- Inline Author Reply Box (Hidden by default) -->
                    <div class="reply-form-box hidden pt-3 border-t border-paper-border/60 space-y-2">
                      <textarea
                        rows="2"
                        placeholder="আফফান লাবীব হিসেবে আপনার উত্তর লিখুন..."
                        class="reply-textarea-input w-full px-3 py-2 rounded-xl border border-amber-500/40 bg-paper-bg dark:bg-night-bg text-xs font-serif text-paper-text focus:outline-none focus:ring-1 focus:ring-amber-500"
                      ></textarea>
                      <div class="flex items-center justify-end gap-2">
                        <button
                          type="button"
                          class="cancel-reply-btn px-3 py-1 rounded-lg text-xs font-sans text-paper-muted hover:text-paper-text cursor-pointer"
                          data-id={safeId}
                        >
                          বাতিল
                        </button>
                        <button
                          type="button"
                          class="submit-reply-btn px-3.5 py-1.5 rounded-lg bg-paper-accent hover:opacity-90 text-white text-xs font-serif font-semibold cursor-pointer shadow-2xs"
                          data-slug={c.slug}
                          data-id={safeId}
                        >
                          উত্তর প্রকাশ করুন
                        </button>
                      </div>
                    </div>
                  </div>
                );
              })
            )}
          </div>
        </div>
      </div>
    </section>

    <!-- TAB 6: Cloud Database & Sync Status -->
    <!-- ======================================================== -->
    <section id="tab-settings" class="admin-tab-content hidden space-y-6">
      <div class="max-w-lg mx-auto rounded-3xl border border-paper-border/80 dark:border-night-border/80 bg-paper-surface/95 dark:bg-night-surface/95 p-6 sm:p-8 shadow-xs space-y-6">
        <div class="text-center space-y-2">
          <div class="w-14 h-14 mx-auto rounded-2xl bg-amber-500/10 text-amber-700 dark:text-amber-400 flex items-center justify-center text-2xl border border-amber-500/20">
            <span>🔒</span>
          </div>
          <h3 class="text-xl font-bold font-serif text-paper-text dark:text-night-text">
            স্টুডিও নিরাপত্তা ও পিন পরিবর্তন
          </h3>
          <p class="text-xs text-paper-muted dark:text-night-muted font-serif leading-relaxed">
            লেখক ছাড়া অন্য কেউ যেন স্টুডিওতে প্রবেশ করতে না পারে, সেজন্য আপনার গোপন পিন কোড এখান থেকে পরিবর্তন করতে পারেন।
          </p>
        </div>

        <div class="space-y-4 pt-2">
          <div class="p-4 rounded-2xl border border-paper-border/70 dark:border-night-border/70 bg-paper-bg/50 dark:bg-night-bg/50 space-y-3">
            <label for="new-pin-input" class="block text-xs font-sans font-semibold text-paper-text dark:text-night-text">
              নতুন পিন কোড লিখুন (৪-৮ ডিজিট):
            </label>
            <div class="flex items-center gap-2">
              <input
                id="new-pin-input"
                type="password"
                maxlength="8"
                placeholder="নতুন পিন দিন..."
                autocomplete="off"
                class="flex-grow px-4 py-2.5 rounded-xl border border-paper-border dark:border-night-border bg-paper-surface dark:bg-night-surface text-sm font-mono text-paper-text dark:text-night-text focus:outline-none focus:ring-2 focus:ring-paper-accent"
              />
              <button
                id="save-new-pin-btn"
                type="button"
                class="px-5 py-2.5 rounded-xl bg-paper-accent text-white text-xs font-sans font-semibold hover:opacity-95 cursor-pointer shadow-xs active:scale-95 transition-all whitespace-nowrap"
              >
                পিন সেভ করুন
              </button>
            </div>
            <p id="pin-change-status" class="hidden text-xs text-emerald-600 dark:text-emerald-400 font-sans font-semibold bg-emerald-500/10 p-2 rounded-lg border border-emerald-500/20">
              ✓ পিন কোড সফলভাবে পরিবর্তন হয়েছে!
            </p>
          </div>

          <div class="pt-2">
            <button
              id="settings-lock-now-btn"
              type="button"
              class="w-full py-3 rounded-2xl bg-rose-500/10 hover:bg-rose-500/20 text-rose-600 dark:text-rose-400 border border-rose-500/30 text-xs font-sans font-semibold transition-all cursor-pointer flex items-center justify-center gap-2"
            >
              <span>🔒</span>
              <span>স্টুডিও এখনই লক করুন</span>
            </button>
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- Raw Data Injection for Ultra-Fast Client Hydration -->
  <script id="server-posts-data" type="application/json" set:html={JSON.stringify(posts)} />
  <script id="server-categories-data" type="application/json" set:html={JSON.stringify(categories)} />
  <script id="server-author-data" type="application/json" set:html={JSON.stringify(author)} />
  <script id="server-bookshelf-data" type="application/json" set:html={JSON.stringify(defaultBookshelf)} />
  <script id="server-interactions-data" type="application/json" set:html={JSON.stringify(interactions)} />
  <script id="server-admin-pin" type="application/json" set:html={JSON.stringify(currentAdminPin)} />

  <!-- Author Studio Client Engine -->
  <script is:inline>
    (() => {
      // ========================================================
      // 🔐 UNIVERSAL CLOUD PIN LOCK ENGINE (Client Protection)
      // ========================================================
      const DEFAULT_PIN = '786992';
      const pinScreen = document.getElementById('pin-screen');
      const studioScreen = document.getElementById('studio-screen');
      const pinInput = document.getElementById('pin-input');
      const pinError = document.getElementById('pin-error');
      const pinSubmitBtn = document.getElementById('pin-submit-btn');
      const adminLockBtn = document.getElementById('admin-lock-btn');
      const newPinInput = document.getElementById('new-pin-input');
      const saveNewPinBtn = document.getElementById('save-new-pin-btn');

      const serverPinEl = document.getElementById('server-admin-pin');
      const initialServerPin = serverPinEl ? JSON.parse(serverPinEl.textContent || '""') : DEFAULT_PIN;

      const BN_DIGIT_MAP = {
        '০': '0', '১': '1', '২': '2', '৩': '3', '৪': '4',
        '৫': '5', '৬': '6', '৭': '7', '৮': '8', '৯': '9'
      };
      function cleanPinString(s) {
        if (!s) return '';
        return s.toString().replace(/[০-৯]/g, (d) => BN_DIGIT_MAP[d] || d).trim();
      }

      function getStoredPin() {
        return localStorage.getItem('kherokhata_admin_pin') || initialServerPin || DEFAULT_PIN;
      }

      function checkAuth() {
        const isAuth = sessionStorage.getItem('kherokhata_admin_authenticated') === 'true';
        if (isAuth) {
          pinScreen?.classList.add('hidden');
          studioScreen?.classList.remove('hidden');
          if (typeof loadInteractionsData === 'function') loadInteractionsData();
        } else {
          pinScreen?.classList.remove('hidden');
          studioScreen?.classList.add('hidden');
          if (pinInput) {
            pinInput.value = '';
            pinInput.focus();
          }
        }
      }

      async function attemptUnlock() {
        const raw = pinInput?.value || '';
        const entered = cleanPinString(raw);

        if (!entered) {
          if (pinError) {
            pinError.textContent = 'অনুগ্রহ করে পিন কোড লিখুন।';
            pinError.classList.remove('hidden');
          }
          return;
        }

        if (pinSubmitBtn) pinSubmitBtn.disabled = true;

        try {
          // Cloud Database PIN Verification
          const res = await fetch('/api/admin-pin', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'verify', pin: entered })
          });
          const data = await res.json();

          if (res.ok && data.success) {
            sessionStorage.setItem('kherokhata_admin_authenticated', 'true');
            localStorage.setItem('kherokhata_admin_pin', entered);
            pinError?.classList.add('hidden');
            checkAuth();
            if (window.showAdminToast) window.showAdminToast('লেখক স্টুডিও সফলভাবে আনলক হয়েছে! 🔓');
          } else {
            if (pinError) {
              pinError.textContent = data.message || 'ভুল পিন কোড! শুধুমাত্র লেখকের নির্ধারিত পিন কোড দিয়েই খোলা যাবে।';
              pinError.classList.remove('hidden');
            }
          }
        } catch (e) {
          // Offline fallback: check local cached pin if network down
          const localPin = getStoredPin();
          if (entered === localPin) {
            sessionStorage.setItem('kherokhata_admin_authenticated', 'true');
            pinError?.classList.add('hidden');
            checkAuth();
            if (window.showAdminToast) window.showAdminToast('অফলাইন মোডে স্টুডিও আনলক হয়েছে। 🔓');
          } else {
            if (pinError) {
              pinError.textContent = 'ভুল পিন কোড! শুধুমাত্র লেখকের নির্ধারিত পিন কোড দিয়েই খোলা যাবে।';
              pinError.classList.remove('hidden');
            }
          }
        } finally {
          if (pinSubmitBtn) pinSubmitBtn.disabled = false;
        }
      }

      pinSubmitBtn?.addEventListener('click', attemptUnlock);
      pinInput?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') attemptUnlock();
      });

      function lockStudio() {
        sessionStorage.removeItem('kherokhata_admin_authenticated');
        checkAuth();
        if (window.showAdminToast) window.showAdminToast('স্টুডিও লক করা হয়েছে। 🔒');
      }

      adminLockBtn?.addEventListener('click', lockStudio);
      document.getElementById('settings-lock-now-btn')?.addEventListener('click', lockStudio);

      saveNewPinBtn?.addEventListener('click', async () => {
        const rawVal = newPinInput?.value || '';
        const val = cleanPinString(rawVal);
        if (!val || val.length < 4) {
          alert('অনুগ্রহ করে কমপক্ষে ৪ সংখ্যার নতুন পিন কোড লিখুন।');
          return;
        }

        saveNewPinBtn.disabled = true;
        const origText = saveNewPinBtn.innerText;
        saveNewPinBtn.innerText = 'সেভ হচ্ছে...';

        try {
          const res = await fetch('/api/admin-pin', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'change', newPin: val })
          });
          const json = await res.json();
          if (res.ok && json.success) {
            localStorage.setItem('kherokhata_admin_pin', val);
            const statusEl = document.getElementById('pin-change-status');
            if (statusEl) {
              statusEl.textContent = '✓ নতুন পিন কোড ক্লাউড ডেটাবেসে সফলভাবে সংরক্ষিত হয়েছে! সকল ডিভাইসে এই পিন দিয়ে লগইন করতে হবে।';
              statusEl.classList.remove('hidden');
            }
            if (newPinInput) newPinInput.value = '';
            if (window.showAdminToast) window.showAdminToast('নতুন পিন কোড ক্লাউডে সংরক্ষিত হয়েছে! ✓');
          } else {
            alert(json.message || 'পিন সংরক্ষণ ব্যর্থ হয়েছে।');
          }
        } catch (e) {
          alert('নেটওয়ার্ক সমস্যা: ' + e.message);
        } finally {
          saveNewPinBtn.disabled = false;
          saveNewPinBtn.innerText = origText;
        }
      });

      checkAuth();


      // 1. Data Bootstrap
      const serverPostsEl = document.getElementById('server-posts-data');
      let serializedPosts = serverPostsEl ? JSON.parse(serverPostsEl.textContent || '[]') : [];

      const serverCatsEl = document.getElementById('server-categories-data');
      let serializedCategories = serverCatsEl ? JSON.parse(serverCatsEl.textContent || '[]') : [];

      const author = JSON.parse(document.getElementById('server-author-data')?.textContent || '{}');
      const initialBookshelf = JSON.parse(document.getElementById('server-bookshelf-data')?.textContent || '{}');

      // 2. Client-Side Resilience & Cloud DB Sync
      function getCustomPosts() {
        try {
          return JSON.parse(localStorage.getItem('kherokhata_custom_posts') || '[]');
        } catch (e) {
          return [];
        }
      }

      function getDeletedSlugs() {
        try {
          return JSON.parse(localStorage.getItem('kherokhata_deleted_posts') || '[]');
        } catch (e) {
          return [];
        }
      }

      const bnDigits = ['০', '১', '২', '৩', '৪', '৫', '৬', '৭', '৮', '৯'];
      function toBnNum(num) {
        return (num || 0).toString().replace(/[0-9]/g, (d) => bnDigits[parseInt(d, 10)]);
      }

      function updateConnectionStatus() {
        const badge = document.getElementById('admin-connection-badge');
        const dot = document.getElementById('admin-connection-dot');
        const statusText = document.getElementById('admin-connection-status-text');
        const subtext = document.getElementById('admin-connection-subtext');

        if (navigator.onLine) {
          if (badge) {
            badge.className = 'inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-sans font-medium bg-emerald-500/15 text-emerald-700 dark:text-emerald-400 border border-emerald-500/30';
          }
          if (dot) {
            dot.className = 'w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse';
          }
          if (statusText) statusText.innerText = 'অনলাইন স্টুডিও';
          if (subtext) subtext.innerText = '☁️ ক্লাউড ও ডেটাবেস সিঙ্ক সক্রিয়';
        } else {
          if (badge) {
            badge.className = 'inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-sans font-medium bg-amber-500/15 text-amber-700 dark:text-amber-400 border border-amber-500/30';
          }
          if (dot) {
            dot.className = 'w-1.5 h-1.5 rounded-full bg-amber-500';
          }
          if (statusText) statusText.innerText = '📶 অফলাইন মোড (লোকাল স্টুডিও)';
          if (subtext) subtext.innerText = '💾 ডিভাইস স্টোরেজে সংরক্ষণ হবে, ইন্টারনেট পেলেই ক্লাউডে সিঙ্ক হবে';
        }
      }

      function updateOfflineQueueBadge() {
        try {
          const queue = JSON.parse(localStorage.getItem('kherokhata_offline_queue') || '[]');
          const badge = document.getElementById('offline-queue-badge');
          const desc = document.getElementById('offline-queue-desc');
          if (badge) {
            if (queue.length > 0) {
              badge.innerText = `${toBnNum(queue.length)}টি অপেক্ষমাণ`;
              badge.className = 'px-2.5 py-1 rounded text-[11px] font-bold bg-amber-500/30 text-amber-900 dark:text-amber-200 animate-pulse';
            } else {
              badge.innerText = 'সকল লেখা ক্লাউডে সিঙ্কড ✓';
              badge.className = 'px-2.5 py-1 rounded text-[11px] font-bold bg-emerald-500/20 text-emerald-800 dark:text-emerald-300';
            }
          }
          if (desc) {
            desc.innerText = queue.length > 0
              ? `${toBnNum(queue.length)}টি রচনা ইন্টারনেট পুনঃসংযোগ পাওয়ার জন্য অপেক্ষমাণ রয়েছে`
              : 'কোনো অপেক্ষমাণ রচনা নেই, ক্লাউড ও লোকাল স্টোরেজ সামঞ্জস্যপূর্ণ';
          }
        } catch (e) {}
      }

      async function syncOfflineQueue() {
        updateConnectionStatus();
        updateOfflineQueueBadge();
        if (!navigator.onLine) return;

        try {
          // 1. Process deletes first
          const delQueue = JSON.parse(localStorage.getItem('kherokhata_offline_delete_queue') || '[]');
          if (delQueue.length > 0) {
            const remainingDeletes = [];
            for (const delSlug of delQueue) {
              try {
                const res = await fetch('/api/posts', {
                  method: 'DELETE',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ slug: delSlug })
                });
                if (!res.ok) remainingDeletes.push(delSlug);
              } catch (err) {
                remainingDeletes.push(delSlug);
              }
            }
            localStorage.setItem('kherokhata_offline_delete_queue', JSON.stringify(remainingDeletes));
          }

          // 2. Process post creations/edits
          const queue = JSON.parse(localStorage.getItem('kherokhata_offline_queue') || '[]');
          if (queue.length > 0) {
            let uploadedCount = 0;
            const remainingPosts = [];
            for (const post of queue) {
              try {
                const res = await fetch('/api/posts', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify(post)
                });
                if (res.ok) {
                  uploadedCount++;
                } else {
                  remainingPosts.push(post);
                }
              } catch (err) {
                remainingPosts.push(post);
              }
            }
            localStorage.setItem('kherokhata_offline_queue', JSON.stringify(remainingPosts));
            updateOfflineQueueBadge();
            if (uploadedCount > 0 && window.showAdminToast) {
              window.showAdminToast(`☁️ ইন্টারনেট পুনঃসংযোগ: ${toBnNum(uploadedCount)}টি অফলাইন রচনা ক্লাউডে স্বয়ংক্রিয়ভাবে আপলোড সম্পন্ন হয়েছে! ✓`);
            }
          }
        } catch (e) {
          console.warn('[Admin] Sync offline queue error:', e);
        }
      }

      window.addEventListener('online', () => {
        updateConnectionStatus();
        syncOfflineQueue();
        refreshCloudPosts(false);
      });

      window.addEventListener('offline', () => {
        updateConnectionStatus();
      });

      // Merge local custom posts into serializedPosts
      const initialCustomPosts = getCustomPosts();
      const initialDeletedSlugs = getDeletedSlugs();

      // Filter out deleted posts
      serializedPosts = serializedPosts.filter((p) => !initialDeletedSlugs.includes(p.slug));

      // Unshift or update custom posts
      initialCustomPosts.forEach((cp) => {
        if (initialDeletedSlugs.includes(cp.slug)) return;
        const existIdx = serializedPosts.findIndex((p) => p.slug === cp.slug);
        if (existIdx >= 0) {
          serializedPosts[existIdx] = cp;
        } else {
          serializedPosts.unshift(cp);
        }
      });

      async function refreshCloudPosts(showToast = true) {
        if (!navigator.onLine) {
          if (showToast && window.showAdminToast) {
            window.showAdminToast('📶 বর্তমানে আপনি অফলাইনে আছেন। লোকাল ক্যাশ থেকে ডাটা প্রদর্শিত হচ্ছে।');
          }
          return;
        }
        try {
          const res = await fetch('/api/posts', { cache: 'no-store' });
          if (!res.ok) return;
          const data = await res.json();
          if (data && Array.isArray(data.posts)) {
            const serverPosts = data.posts;
            const currentDeleted = getDeletedSlugs();
            const validServerPosts = serverPosts.filter((p) => !currentDeleted.includes(p.slug));
            
            // Merge with local custom posts
            const currentCustom = getCustomPosts();
            const merged = [...validServerPosts];
            currentCustom.forEach((cp) => {
              if (currentDeleted.includes(cp.slug)) return;
              const idx = merged.findIndex((p) => p.slug === cp.slug);
              if (idx >= 0) merged[idx] = cp;
              else merged.unshift(cp);
            });

            serializedPosts = merged;
            localStorage.setItem('kherokhata_custom_posts', JSON.stringify(merged));
            renderEntireFileList();
            updateFolderBadges();
            renderFileList();
            if (showToast && window.showAdminToast) {
              window.showAdminToast(`ক্লাউড ডেটাবেস সফলভাবে সিঙ্ক হয়েছে! (${merged.length}টি রচনা) ✓`);
            }
          }
        } catch (e) {
          console.warn('[Admin] Cloud sync error:', e);
        }
      }

      const syncRefreshBtn = document.getElementById('sync-refresh-btn');
      syncRefreshBtn?.addEventListener('click', () => refreshCloudPosts(true));

      const forceSyncBtn = document.getElementById('force-cloud-sync-btn');
      forceSyncBtn?.addEventListener('click', () => {
        syncOfflineQueue();
        refreshCloudPosts(true);
      });

      // Boot updates
      updateConnectionStatus();
      updateOfflineQueueBadge();
      if (navigator.onLine) {
        setTimeout(syncOfflineQueue, 500);
      }
      setTimeout(() => refreshCloudPosts(false), 800);

      // 3. Tab Switching Engine
      const tabBtns = document.querySelectorAll('.admin-tab-btn');
      const tabContents = document.querySelectorAll('.admin-tab-content');

      tabBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const tabId = btn.getAttribute('data-tab');

          tabBtns.forEach((b) => {
            b.classList.remove('bg-paper-accent', 'text-white', 'shadow-xs');
            b.classList.add('border', 'border-paper-border', 'dark:border-night-border', 'bg-paper-surface/60', 'dark:bg-night-surface/60', 'text-paper-muted', 'dark:text-night-muted');
          });

          btn.classList.remove('border', 'border-paper-border', 'dark:border-night-border', 'bg-paper-surface/60', 'dark:bg-night-surface/60', 'text-paper-muted', 'dark:text-night-muted');
          btn.classList.add('bg-paper-accent', 'text-white', 'shadow-xs');

          tabContents.forEach((c) => c.classList.add('hidden'));
          document.getElementById(tabId)?.classList.remove('hidden');
        });
      });

      // Quick Nav Buttons
      document.getElementById('quick-new-post-btn')?.addEventListener('click', () => {
        document.getElementById('tab-btn-writer')?.click();
        document.getElementById('editor-title')?.focus();
      });

      document.getElementById('quick-new-folder-btn')?.addEventListener('click', () => {
        document.getElementById('tab-btn-menu')?.click();
        document.getElementById('new-cat-label')?.focus();
      });

      // 4. Admin Theme Switcher (Day / Sepia / Night)
      const themeToggleBtn = document.getElementById('admin-theme-toggle-btn');
      const themeIcon = document.getElementById('admin-theme-icon');
      const THEMES = ['light', 'sepia', 'dark'];
      const ICONS = { light: '☀️', sepia: '📜', dark: '🌙' };

      function getCurrentTheme() {
        if (document.documentElement.classList.contains('dark')) return 'dark';
        if (document.documentElement.classList.contains('sepia')) return 'sepia';
        return 'light';
      }

      function applyTheme(th) {
        document.documentElement.classList.remove('dark', 'sepia');
        if (th === 'dark') document.documentElement.classList.add('dark');
        if (th === 'sepia') document.documentElement.classList.add('sepia');
        localStorage.setItem('theme', th);
        if (themeIcon) themeIcon.innerText = ICONS[th] || '☀️';
      }

      if (themeIcon) themeIcon.innerText = ICONS[getCurrentTheme()] || '☀️';

      themeToggleBtn?.addEventListener('click', () => {
        const curr = getCurrentTheme();
        const nextIdx = (THEMES.indexOf(curr) + 1) % THEMES.length;
        applyTheme(THEMES[nextIdx]);
      });

      // 5. C: Drive Explorer & Filtering Engine
      let currentFilterCat = 'all';
      const fileListContainer = document.getElementById('file-list-container');
      const emptyFolderNotice = document.getElementById('empty-folder-notice');
      const currentFolderTitle = document.getElementById('current-folder-title');
      const currentFolderCount = document.getElementById('current-folder-count');
      const folderTotalFilesBadge = document.getElementById('folder-total-files-badge');

      function renderEntireFileList() {
        if (!fileListContainer) return;
        fileListContainer.innerHTML = '';
        serializedPosts.forEach((post) => {
          const row = document.createElement('div');
          row.className = 'file-row p-4 rounded-2xl border border-paper-border/70 dark:border-night-border/70 bg-paper-bg/40 dark:bg-night-bg/40 hover:border-paper-accent/50 dark:hover:border-night-accent/50 transition-all flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs';
          row.setAttribute('data-category', post.category);
          row.setAttribute('data-slug', post.slug);
          const isPinned = Boolean(post.pinned);
          row.innerHTML = `
            <div class="space-y-1 min-w-0 flex-1">
              <div class="font-serif font-bold text-sm sm:text-base text-paper-text dark:text-night-text flex items-center gap-2">
                <span class="shrink-0 text-base">${isPinned ? '📌' : '📄'}</span>
                <span class="truncate block ${isPinned ? 'text-amber-900 dark:text-amber-200 font-black' : ''}">${post.title}</span>
                ${isPinned ? '<span class="text-[10px] font-sans font-bold px-2 py-0.5 rounded-full bg-amber-500/20 text-amber-800 dark:text-amber-200 border border-amber-500/30">শীর্ষে পিনকৃত</span>' : ''}
              </div>
              <div class="text-[11px] font-sans text-paper-muted dark:text-night-muted flex items-center gap-2 flex-wrap">
                <span class="px-2 py-0.5 rounded-md bg-paper-accent/10 text-paper-accent dark:text-night-accent font-medium">
                  ${post.category}
                </span>
                <span>·</span>
                <span>তারিখ: ${post.publishedAt || post.formattedDate}</span>
                <span>·</span>
                <span>${post.body ? post.body.trim().split(/\\s+/).length : (post.wordCount || 0)} শব্দ</span>
                <span class="inline-flex items-center gap-2 font-mono text-[10px] px-2 py-0.5 rounded-md bg-amber-500/10 text-amber-900 dark:text-amber-300 border border-amber-500/20">
                  <span>👁️ ${(currentInteractionsData.stats?.[post.slug]?.views || 0)}</span>
                  <span>❤️ ${(currentInteractionsData.stats?.[post.slug]?.likes || 0)}</span>
                  <span>💬 ${(currentInteractionsData.comments || []).filter((x) => x.slug === post.slug).length}</span>
                </span>
              </div>
            </div>
            <div class="flex items-center gap-2 shrink-0 pt-2 border-t border-paper-border/40 sm:border-t-0 sm:pt-0">
              <button
                type="button"
                class="toggle-pin-btn px-3 py-2 rounded-xl border ${isPinned ? 'border-amber-500/60 bg-amber-500/25 text-amber-950 dark:text-amber-100 font-bold shadow-2xs' : 'border-paper-border hover:border-amber-500/40 bg-paper-surface hover:bg-amber-500/10 text-paper-muted hover:text-amber-800 dark:hover:text-amber-300 font-medium'} text-xs font-sans transition-all cursor-pointer flex items-center justify-center gap-1.5"
                data-slug="${post.slug}"
                data-pinned="${isPinned ? 'true' : 'false'}"
                title="${isPinned ? 'পিন প্রত্যাহার করুন' : 'এই রচনাটি ব্লগের শীর্ষে পিন করুন'}"
              >
                <span>${isPinned ? '📌' : '📍'}</span>
                <span class="pin-status-label">${isPinned ? 'পিনকৃত (শীর্ষে)' : 'শীর্ষে পিন করুন'}</span>
              </button>
              <button
                type="button"
                class="load-in-writer-btn flex-1 sm:flex-initial px-3.5 py-2 rounded-xl bg-paper-accent text-white hover:opacity-95 text-xs font-sans font-semibold transition-all cursor-pointer shadow-2xs flex items-center justify-center gap-1.5"
                data-slug="${post.slug}"
              >
                <span>✍️</span>
                <span>সম্পাদনা</span>
              </button>
              <a
                href="/${post.slug}"
                target="_blank"
                class="px-3 py-2 rounded-xl border border-paper-border dark:border-night-border hover:bg-paper-border/30 text-paper-text dark:text-night-text text-xs font-sans transition-colors flex items-center justify-center gap-1"
              >
                <span>পড়ুন</span>
                <span>↗</span>
              </a>
              <button
                type="button"
                class="delete-post-btn px-3 py-2 rounded-xl border border-red-300 dark:border-red-800/60 bg-red-500/10 hover:bg-red-600 text-red-600 hover:text-white text-xs font-sans font-medium transition-all cursor-pointer flex items-center justify-center gap-1"
                data-slug="${post.slug}"
                title="স্থায়ীভাবে লেখাটি মুছে ফেলুন"
              >
                <span>🗑️</span>
                <span>মুছুন</span>
              </button>
            </div>
          `;
          fileListContainer.appendChild(row);
        });
        attachLoadPostListeners();
        attachDeleteListeners();
        attachPinListeners();
      }

      // Initial sync of file rows on boot
      renderEntireFileList();

      function renderFileList() {
        if (!fileListContainer) return;
        const rows = fileListContainer.querySelectorAll('.file-row');
        let visibleCount = 0;

        rows.forEach((row) => {
          const cat = row.getAttribute('data-category');
          if (currentFilterCat === 'all' || cat === currentFilterCat) {
            row.classList.remove('hidden');
            visibleCount++;
          } else {
            row.classList.add('hidden');
          }
        });

        if (emptyFolderNotice) {
          emptyFolderNotice.classList.toggle('hidden', visibleCount > 0);
        }
        if (currentFolderCount) {
          currentFolderCount.innerText = visibleCount.toString();
        }
      }

      function updateFolderBadges() {
        const total = serializedPosts.length;
        if (folderTotalFilesBadge) folderTotalFilesBadge.innerText = `${total}টি ফাইল`;

        document.querySelectorAll('.folder-count-badge').forEach((badge) => {
          const catId = badge.getAttribute('data-count-cat');
          if (catId === 'all') {
            badge.innerText = `(${total})`;
          } else {
            const count = serializedPosts.filter((p) => p.category === catId).length;
            badge.innerText = `(${count})`;
          }
        });
      }

      function attachFolderClickListeners() {
        document.querySelectorAll('.folder-item').forEach((item) => {
          item.addEventListener('click', () => {
            document.querySelectorAll('.folder-item').forEach((f) => {
              f.classList.remove('bg-paper-accent/15', 'dark:bg-night-accent/20', 'text-paper-accent', 'dark:text-night-accent', 'font-semibold');
              f.classList.add('text-paper-text', 'dark:text-night-text');
            });

            item.classList.add('bg-paper-accent/15', 'dark:bg-night-accent/20', 'text-paper-accent', 'dark:text-night-accent', 'font-semibold');
            item.classList.remove('text-paper-text', 'dark:text-night-text');

            currentFilterCat = item.getAttribute('data-cat') || 'all';

            const catObj = serializedCategories.find((c) => c.id === currentFilterCat);
            if (currentFolderTitle) {
              currentFolderTitle.innerText = currentFilterCat === 'all'
                ? '📁 সকল রচনা (ফাইল তালিকা)'
                : `${catObj?.icon || '📁'} ${catObj?.title || currentFilterCat} (ফোল্ডার তালিকা)`;
            }

            renderFileList();
          });
        });
      }

      attachFolderClickListeners();
      updateFolderBadges();
      renderFileList();

      // 6. Live Writer's Desk & Markdown Preview Engine
      const editorTitle = document.getElementById('editor-title');
      const editorCat = document.getElementById('editor-category');
      const editorDate = document.getElementById('editor-date');
      const editorDesc = document.getElementById('editor-description');
      const editorTags = document.getElementById('editor-tags');
      const editorPinned = document.getElementById('editor-pinned');
      const editorBody = document.getElementById('editor-body');

      const prevTitle = document.getElementById('preview-title');
      const prevCat = document.getElementById('preview-category-badge');
      const prevDate = document.getElementById('preview-date');
      const prevDesc = document.getElementById('preview-description');
      const prevBody = document.getElementById('preview-body');
      const prevWordCount = document.getElementById('writer-word-counter');
      const prevReadingTime = document.getElementById('preview-reading-time');
      const prevFootnotesSection = document.getElementById('preview-footnotes-section');
      const prevFootnotesList = document.getElementById('preview-footnotes-list');

      const footnotesListContainer = document.getElementById('writer-footnotes-list');
      const addFootnoteToolbarBtn = document.getElementById('toolbar-add-footnote-btn');
      const addFootnoteRowBtn = document.getElementById('add-footnote-row-btn');

      let writerFootnotes = [];

      function renderFootnotesEditor() {
        if (!footnotesListContainer) return;
        footnotesListContainer.innerHTML = '';

        if (writerFootnotes.length === 0) {
          footnotesListContainer.innerHTML = '<p class="text-[11px] text-paper-muted italic">এখনও কোনো টীকা যুক্ত করা হয়নি।</p>';
          return;
        }

        writerFootnotes.forEach((fn) => {
          const row = document.createElement('div');
          row.className = 'flex items-center gap-2 text-xs font-sans';
          row.innerHTML = `
            <span class="w-6 h-6 rounded-lg bg-amber-500/20 text-amber-800 dark:text-amber-300 font-bold flex items-center justify-center shrink-0">
              [${toBnNum(fn.id)}]
            </span>
            <input
              type="text"
              data-id="${fn.id}"
              class="fn-text-input flex-grow px-3 py-1.5 rounded-lg border border-paper-border dark:border-night-border bg-paper-surface dark:bg-night-surface text-paper-text dark:text-night-text"
              placeholder="টীকা বা তথ্যসূত্রের বিবরণ লিখুন..."
              value="${fn.text || ''}"
            />
            <button
              type="button"
              class="fn-remove-btn w-6 h-6 rounded-lg text-red-500 hover:bg-red-500/10 flex items-center justify-center shrink-0 cursor-pointer"
              data-id="${fn.id}"
              title="মুছুন"
            >✕</button>
          `;
          footnotesListContainer.appendChild(row);
        });

        // Event delegation
        footnotesListContainer.querySelectorAll('.fn-text-input').forEach((input) => {
          input.addEventListener('input', (e) => {
            const id = Number(e.target.getAttribute('data-id'));
            const item = writerFootnotes.find((f) => f.id === id);
            if (item) item.text = e.target.value.trim();
            updateLivePreview();
          });
        });

        footnotesListContainer.querySelectorAll('.fn-remove-btn').forEach((btn) => {
          btn.addEventListener('click', () => {
            const id = Number(btn.getAttribute('data-id'));
            writerFootnotes = writerFootnotes.filter((f) => f.id !== id);
            renderFootnotesEditor();
            updateLivePreview();
          });
        });
      }

      function insertFootnoteAtCursor() {
        if (!editorBody) return;
        const nextId = writerFootnotes.length + 1;
        const marker = `[${toBnNum(nextId)}]`;
        const start = editorBody.selectionStart;
        const end = editorBody.selectionEnd;
        editorBody.setRangeText(marker, start, end, 'end');
        editorBody.focus();

        writerFootnotes.push({ id: nextId, text: '' });
        renderFootnotesEditor();
        updateLivePreview();
      }

      addFootnoteToolbarBtn?.addEventListener('click', insertFootnoteAtCursor);
      addFootnoteRowBtn?.addEventListener('click', () => {
        const nextId = writerFootnotes.length + 1;
        writerFootnotes.push({ id: nextId, text: '' });
        renderFootnotesEditor();
        updateLivePreview();
      });

      // Set default today's date
      if (editorDate && !editorDate.value) {
        editorDate.value = new Date().toISOString().split('T')[0];
      }

      function updateLivePreview() {
        const titleVal = editorTitle?.value.trim() || 'শিরোনাম এখানে দৃশ্যমান হবে';
        const catVal = editorCat?.options[editorCat.selectedIndex]?.text || 'চিন্তা';
        const descVal = editorDesc?.value.trim() || 'সংক্ষিপ্ত বিবরণী এখানে প্রদর্শিত হবে...';
        const bodyVal = editorBody?.value || 'আপনার লেখা শুরু করুন, এখানে আসল পত্রিকার মতো ফুটে উঠবে।';

        if (prevTitle) prevTitle.innerText = titleVal;
        if (prevCat) prevCat.innerText = catVal;
        if (prevDesc) prevDesc.innerText = descVal;

        const words = bodyVal.trim() ? bodyVal.trim().split(/\s+/).length : 0;
        const readMins = Math.max(1, Math.ceil(words / 180));
        if (prevWordCount) prevWordCount.innerText = `${words} শব্দ · ${readMins} মিনিট পাঠ`;
        if (prevReadingTime) prevReadingTime.innerText = `${readMins} মিনিট পাঠ`;

        if (prevBody) {
          let html = bodyVal
            .replace(/### (.*$)/gim, '<h3 class="text-lg font-bold font-serif my-2">$1</h3>')
            .replace(/## (.*$)/gim, '<h2 class="text-xl font-bold font-serif my-3">$1</h2>')
            .replace(/# (.*$)/gim, '<h1 class="text-2xl font-bold font-serif my-4">$1</h1>')
            .replace(/\*\*(.*)\*\*/gim, '<strong>$1</strong>')
            .replace(/\*(.*)\*/gim, '<em>$1</em>')
            .replace(/^> (.*$)/gim, '<blockquote class="my-3 border-l-4 border-amber-600 dark:border-amber-400 bg-amber-500/10 dark:bg-amber-400/10 px-4 py-2.5 rounded-r-xl italic font-serif leading-relaxed">$1</blockquote>')
            .replace(/\n\n/gim, '</p><p class="my-3">');

          html = html.replace(/\[([১-৯\d]+)\]/g, '<sup class="px-1 py-0.5 rounded bg-amber-500/20 text-paper-accent dark:text-night-accent font-bold cursor-pointer hover:underline text-[11px]">[$1]</sup>');

          prevBody.innerHTML = `<p class="my-3">${html}</p>`;
        }

        if (prevFootnotesSection && prevFootnotesList) {
          if (writerFootnotes.length > 0) {
            prevFootnotesSection.classList.remove('hidden');
            prevFootnotesList.innerHTML = writerFootnotes.map((f) => `
              <li class="leading-relaxed">
                <span class="text-paper-text dark:text-night-text font-serif">${f.text || '<em>(টীকার বিবরণ লেখা হয়নি)</em>'}</span>
              </li>
            `).join('');
          } else {
            prevFootnotesSection.classList.add('hidden');
            prevFootnotesList.innerHTML = '';
          }
        }
      }

      [editorTitle, editorCat, editorDesc, editorBody].forEach((el) => {
        el?.addEventListener('input', updateLivePreview);
      });

      // Markdown Toolbar Syntax Insertion
      document.querySelectorAll('.md-tool-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          if (!editorBody) return;
          const syntax = btn.getAttribute('data-syntax');
          const start = editorBody.selectionStart;
          const end = editorBody.selectionEnd;
          const selected = editorBody.value.substring(start, end);

          if (syntax === '## ' || syntax === '> ' || syntax === '- ') {
            editorBody.setRangeText(`\n${syntax}${selected}`, start, end, 'end');
          } else {
            editorBody.setRangeText(`${syntax}${selected || 'পাঠ্য'}${syntax}`, start, end, 'end');
          }
          editorBody.focus();
          updateLivePreview();
        });
      });

      // Clear / Reset Editor
      document.getElementById('reset-editor-btn')?.addEventListener('click', () => {
        if (!confirm('আপনি কি লেখার খসড়া পরিষ্কার করতে চান?')) return;
        if (editorTitle) editorTitle.value = '';
        if (editorDesc) editorDesc.value = '';
        if (editorTags) editorTags.value = '';
        if (editorPinned) editorPinned.checked = false;
        if (editorBody) editorBody.value = '';
        writerFootnotes = [];
        renderFootnotesEditor();
        updateLivePreview();
        if (window.showAdminToast) window.showAdminToast('খসড়া পাতা পরিষ্কার করা হয়েছে।');
      });

      // 8. Load Post Into Editor
      function attachLoadPostListeners() {
        document.querySelectorAll('.load-in-writer-btn').forEach((btn) => {
          if (btn.getAttribute('data-load-bound')) return;
          btn.setAttribute('data-load-bound', 'true');

          btn.addEventListener('click', () => {
            const slug = btn.getAttribute('data-slug');
            const post = serializedPosts.find((p) => p.slug === slug);
            if (!post) return;

            if (editorTitle) editorTitle.value = post.title;
            if (editorCat) editorCat.value = post.category;
            if (editorDate) editorDate.value = post.publishedAt;
            if (editorDesc) editorDesc.value = post.description;
            if (editorTags) editorTags.value = (post.tags || []).join(', ');
            if (editorPinned) editorPinned.checked = Boolean(post.pinned);
            if (editorBody) editorBody.value = post.body;

            writerFootnotes = Array.isArray(post.footnotes) ? JSON.parse(JSON.stringify(post.footnotes)) : [];
            renderFootnotesEditor();
            updateLivePreview();

            // Switch to writer tab
            document.getElementById('tab-btn-writer')?.click();
            if (window.showAdminToast) window.showAdminToast(`'${post.title}' সম্পাদনা ডেস্কে লোড হয়েছে।`);
          });
        });
      }

      attachLoadPostListeners();

      // 9. Post Deletion Handler (Reactive with ZERO reload)
            // 9b. Pin/Unpin Toggle Listener
      function attachPinListeners() {
        document.querySelectorAll('.toggle-pin-btn').forEach((btn) => {
          if (btn.getAttribute('data-pin-bound')) return;
          btn.setAttribute('data-pin-bound', 'true');

          btn.addEventListener('click', async () => {
            const slug = btn.getAttribute('data-slug');
            if (!slug) return;

            btn.disabled = true;
            const originalHtml = btn.innerHTML;
            btn.innerHTML = '<span>⏳</span>';

            try {
              const res = await fetch('/api/posts', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ action: 'toggle_pin', slug })
              });
              const data = await res.json();
              if (data.success) {
                const isPinned = Boolean(data.pinned);
                if (isPinned) {
                  serializedPosts.forEach((item) => {
                    if (item.slug !== slug) item.pinned = false;
                  });
                }
                const p = serializedPosts.find((item) => item.slug === slug);
                if (p) p.pinned = isPinned;

                // Sort pinned first
                serializedPosts.sort((a, b) => {
                  if (a.pinned && !b.pinned) return -1;
                  if (!a.pinned && b.pinned) return 1;
                  return new Date(b.publishedAt).getTime() - new Date(a.publishedAt).getTime();
                });

                localStorage.setItem('kherokhata_custom_posts', JSON.stringify(serializedPosts));
                window.dispatchEvent(new CustomEvent('kherokhata-posts-sync'));

                renderEntireFileList();
                renderFileList();

                if (window.showAdminToast) {
                  window.showAdminToast(isPinned ? `✓ "${p?.title || slug}" রচনাটি ব্লগের শীর্ষে পিন করা হয়েছে! 📌` : 'পিন প্রত্যাহার করা হয়েছে।');
                }
              } else {
                throw new Error(data.message || 'Pin toggle failed');
              }
            } catch (err) {
              console.error('[Admin] Pin toggle error:', err);
              if (window.showAdminToast) window.showAdminToast('পিন পরিবর্তন করতে সমস্যা হয়েছে');
            } finally {
              btn.disabled = false;
            }
          });
        });
      }

      function attachDeleteListeners() {
        document.querySelectorAll('.delete-post-btn').forEach((btn) => {
          if (btn.getAttribute('data-delete-bound')) return;
          btn.setAttribute('data-delete-bound', 'true');

          btn.addEventListener('click', async () => {
            const slug = btn.getAttribute('data-slug');
            if (!slug) return;

            const row = btn.closest('.file-row');
            const title = row?.querySelector('.font-serif.font-semibold span:last-child')?.innerText || slug;

            if (!confirm(`আপনি কি নিশ্চিত যে "${title}" লেখাটি স্থায়ীভাবে মুছে ফেলতে চান?`)) {
              return;
            }

            // Animate out and remove from DOM
            row?.classList.add('opacity-0', 'scale-95');
            setTimeout(() => row?.remove(), 200);

            // Update in-memory posts
            const idx = serializedPosts.findIndex((p) => p.slug === slug);
            if (idx !== -1) serializedPosts.splice(idx, 1);

            // Persist deletion to localStorage
            try {
              const currentCustom = getCustomPosts().filter((p) => p.slug !== slug);
              localStorage.setItem('kherokhata_custom_posts', JSON.stringify(currentCustom));

              const delList = getDeletedSlugs();
              if (!delList.includes(slug)) {
                delList.push(slug);
                localStorage.setItem('kherokhata_deleted_posts', JSON.stringify(delList));
              }
              window.dispatchEvent(new CustomEvent('kherokhata-posts-sync', { detail: { deletedSlug: slug } }));
            } catch (e) {}

            updateFolderBadges();
            renderFileList();

            // Send real DELETE to API or Enqueue for Offline Sync
            let deleteSynced = false;
            if (navigator.onLine) {
              try {
                const delRes = await fetch('/api/posts', {
                  method: 'DELETE',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ slug })
                });
                if (delRes.ok) deleteSynced = true;
              } catch (e) {
                console.warn('[Admin] DELETE API error:', e);
              }
            }

            if (!deleteSynced) {
              try {
                const delQueue = JSON.parse(localStorage.getItem('kherokhata_offline_delete_queue') || '[]');
                if (!delQueue.includes(slug)) delQueue.push(slug);
                localStorage.setItem('kherokhata_offline_delete_queue', JSON.stringify(delQueue));
              } catch (e) {}
            }

            // Remove from offline post queue if it was queued for upload
            try {
              const postQueue = JSON.parse(localStorage.getItem('kherokhata_offline_queue') || '[]');
              const filteredPostQueue = postQueue.filter((p) => p.slug !== slug);
              localStorage.setItem('kherokhata_offline_queue', JSON.stringify(filteredPostQueue));
              updateOfflineQueueBadge();
            } catch (e) {}

            // Purge Reader HTML & API Cache so changes are instantly reflected on refresh
            if ('caches' in window) {
              caches.keys().then((names) => {
                names.forEach((name) => {
                  caches.open(name).then((c) => {
                    c.delete('/');
                    c.delete('/api/posts');
                    c.delete(`/${slug}`);
                  });
                });
              }).catch(() => {});
            }

            if (window.showAdminToast) window.showAdminToast(`'${title}' সফলভাবে মুছে ফেলা হয়েছে! ✓`);
          });
        });
      }

      attachDeleteListeners();

      // 10. Save & Publish Handler (Reactive with ZERO reload)
      const saveBtn = document.getElementById('save-publish-btn');
      const saveBtnText = document.getElementById('save-btn-text');

      saveBtn?.addEventListener('click', async () => {
        const title = editorTitle?.value.trim();
        const category = editorCat?.value || 'chinta';
        const date = editorDate?.value || new Date().toISOString().split('T')[0];
        const desc = editorDesc?.value.trim() || '';
        const tags = (editorTags?.value || '').split(',').map((t) => t.trim()).filter(Boolean);
        const body = editorBody?.value || '';

        if (!title) {
          alert('অনুগ্রহ করে লেখার শিরোনাম দিন।');
          editorTitle?.focus();
          return;
        }
        if (!body) {
          alert('অনুগ্রহ করে লেখার মূল বিষয়বস্তু লিখুন।');
          editorBody?.focus();
          return;
        }

        if (saveBtn) saveBtn.disabled = true;
        if (saveBtnText) saveBtnText.innerText = 'সংরক্ষণ হচ্ছে...';

        try {
          const slug = title
            .toLowerCase()
            .trim()
            .replace(/[^\w\u0980-\u09FF-]+/g, '-')
            .replace(/^-+|-+$/g, '') || ('post-' + Date.now());

          const postPayload = {
            slug,
            title,
            description: desc,
            category,
            publishedAt: date,
            formattedDate: date,
            tags,
            pinned: Boolean(editorPinned?.checked),
            body,
            wordCount: body.trim().split(/\s+/).length,
            footnotes: writerFootnotes
          };

          // 1. Update in-memory state
          const existIdx = serializedPosts.findIndex((p) => p.slug === slug);
          if (existIdx >= 0) {
            serializedPosts[existIdx] = postPayload;
          } else {
            serializedPosts.unshift(postPayload);
          }

          // 2. Persist to localStorage immediately
          try {
            const currentCustom = getCustomPosts();
            const cIdx = currentCustom.findIndex((p) => p.slug === slug);
            if (cIdx >= 0) {
              currentCustom[cIdx] = postPayload;
            } else {
              currentCustom.unshift(postPayload);
            }
            localStorage.setItem('kherokhata_custom_posts', JSON.stringify(currentCustom));

            // Clean up from deleted list if was deleted previously
            const delList = getDeletedSlugs().filter((s) => s !== slug);
            localStorage.setItem('kherokhata_deleted_posts', JSON.stringify(delList));

            // Broadcast to all reader tabs & windows
            window.dispatchEvent(new CustomEvent('kherokhata-posts-sync', { detail: { post: postPayload } }));
          } catch (storageErr) {
            console.warn('[Admin] LocalStorage save warning:', storageErr);
          }

          // 3. Send POST to server API or Enqueue for Offline Sync
          let cloudSynced = false;
          if (navigator.onLine) {
            try {
              const apiRes = await fetch('/api/posts', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(postPayload)
              });
              if (apiRes.ok) cloudSynced = true;
            } catch (apiErr) {
              console.warn('[Admin] Serverless API save error:', apiErr);
            }
          }

          if (cloudSynced) {
            // Remove from offline queue if it was queued previously
            try {
              const queue = JSON.parse(localStorage.getItem('kherokhata_offline_queue') || '[]');
              const filtered = queue.filter((p) => p.slug !== slug);
              localStorage.setItem('kherokhata_offline_queue', JSON.stringify(filtered));
              updateOfflineQueueBadge();
            } catch (e) {}

            if (window.showAdminToast) {
              window.showAdminToast(`'${title}' সফলভাবে সংরক্ষিত ও ক্লাউডে প্রকাশিত হয়েছে! ✓`);
            }
          } else {
            // Offline or intermittent connection: enqueue for background sync
            try {
              const queue = JSON.parse(localStorage.getItem('kherokhata_offline_queue') || '[]');
              const qIdx = queue.findIndex((p) => p.slug === slug);
              if (qIdx >= 0) queue[qIdx] = postPayload;
              else queue.push(postPayload);
              localStorage.setItem('kherokhata_offline_queue', JSON.stringify(queue));
              updateOfflineQueueBadge();
            } catch (e) {}

            if (window.showAdminToast) {
              window.showAdminToast(`📶 অফলাইন মোড: '${title}' ডিভাইসে সংরক্ষিত হয়েছে! ইন্টারনেট পেলেই ক্লাউডে স্বয়ংক্রিয়ভাবে আপলোড হবে।`);
            }
          }

          // 4. Purge Reader HTML & API Cache so changes are instantly reflected on refresh
          if ('caches' in window) {
            caches.keys().then((names) => {
              names.forEach((name) => {
                caches.open(name).then((c) => {
                  c.delete('/');
                  c.delete('/api/posts');
                  c.delete(`/${slug}`);
                });
              });
            }).catch(() => {});
          }

          // 5. Update UI File Explorer list
          renderEntireFileList();
          updateFolderBadges();
          renderFileList();

          // Switch smoothly to Explorer tab without reloading
          document.getElementById('tab-btn-explorer')?.click();
        } catch (err) {
          alert('সংরক্ষণ ত্রুটি: ' + err.message);
        } finally {
          if (saveBtn) saveBtn.disabled = false;
          if (saveBtnText) saveBtnText.innerText = 'সংরক্ষণ ও প্রকাশ করুন';
        }
      });

      // 11. Dynamic Category / Folder Creation & Deletion
      const newCatLabel = document.getElementById('new-cat-label');
      const newCatSlug = document.getElementById('new-cat-slug');
      const newCatDesc = document.getElementById('new-cat-desc');
      const addCatBtn = document.getElementById('add-cat-btn');
      const catListContainer = document.getElementById('admin-category-list-container');
      const folderTreeList = document.getElementById('folder-tree-list');

      function syncCategoryDropdown() {
        if (!editorCat) return;
        const currentVal = editorCat.value;
        editorCat.innerHTML = serializedCategories.map((c) => `
          <option value="${c.id}" ${c.id === currentVal ? 'selected' : ''}>${c.title}</option>
        `).join('');
      }

      function renderCategoriesTab() {
        if (!catListContainer) return;
        catListContainer.innerHTML = serializedCategories.map((cat) => {
          const count = serializedPosts.filter((p) => p.category === cat.id).length;
          const isCore = ['chinta', 'pathalap', 'itihas', 'boi-alochona', 'onubad', 'dinlipi', 'smritikotha', 'bhromongatha', 'goddo'].includes(cat.id);
          return `
            <div class="py-3 flex items-center justify-between text-xs gap-3">
              <div>
                <span class="font-serif font-bold text-paper-text dark:text-night-text text-sm">
                  ${cat.icon || '📁'} ${cat.title}
                </span>
                <span class="ml-2 font-mono text-[11px] text-paper-muted">/category/${cat.id}</span>
                <p class="text-[11px] font-serif text-paper-muted mt-0.5">${cat.desc || ''}</p>
              </div>
              <div class="flex items-center gap-2 shrink-0">
                <span class="text-xs font-sans px-2.5 py-1 rounded-full bg-paper-border/50 text-paper-muted">
                  ${count}টি রচনা
                </span>
                ${!isCore ? `
                  <button
                    type="button"
                    class="delete-cat-btn px-2.5 py-1 rounded-lg text-red-600 hover:bg-red-500/10 text-[11px] font-sans font-semibold cursor-pointer"
                    data-id="${cat.id}"
                    title="ফোল্ডারটি মুছুন"
                  >
                    🗑️ মুছুন
                  </button>
                ` : ''}
              </div>
            </div>
          `;
        }).join('');

        attachDeleteCategoryListeners();
      }

      function renderExplorerFolderTree() {
        if (!folderTreeList) return;
        folderTreeList.innerHTML = `
          <button
            type="button"
            class="folder-item w-full text-left px-3.5 py-2.5 rounded-xl ${currentFilterCat === 'all' ? 'bg-paper-accent/15 dark:bg-night-accent/20 text-paper-accent dark:text-night-accent font-semibold' : 'hover:bg-paper-border/40 text-paper-text dark:text-night-text'} flex items-center justify-between transition-colors cursor-pointer"
            data-cat="all"
          >
            <span class="flex items-center gap-2">
              <span>📁</span>
              <span>সকল রচনা</span>
            </span>
            <span class="text-[11px] opacity-80 folder-count-badge" data-count-cat="all">(${serializedPosts.length})</span>
          </button>
          ${serializedCategories.map((cat) => {
            const count = serializedPosts.filter((p) => p.category === cat.id).length;
            const isActive = currentFilterCat === cat.id;
            return `
              <button
                type="button"
                class="folder-item w-full text-left px-3.5 py-2.5 rounded-xl ${isActive ? 'bg-paper-accent/15 dark:bg-night-accent/20 text-paper-accent dark:text-night-accent font-semibold' : 'hover:bg-paper-border/40 text-paper-text dark:text-night-text'} flex items-center justify-between transition-colors cursor-pointer"
                data-cat="${cat.id}"
              >
                <span class="flex items-center gap-2">
                  <span>${cat.icon || '📁'}</span>
                  <span>${cat.title}</span>
                </span>
                <span class="text-[11px] text-paper-muted opacity-80 folder-count-badge" data-count-cat="${cat.id}">(${count})</span>
              </button>
            `;
          }).join('')}
        `;
        attachFolderClickListeners();
      updateFolderBadges();
      renderFileList();
      }

      function attachDeleteCategoryListeners() {
        document.querySelectorAll('.delete-cat-btn').forEach((btn) => {
          btn.addEventListener('click', async () => {
            const id = btn.getAttribute('data-id');
            if (!id) return;
            if (!confirm('আপনি কি নিশ্চিত যে এই ফোল্ডারটি মুছে ফেলতে চান?')) return;

            try {
              const res = await fetch('/api/categories', {
                method: 'DELETE',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id })
              });
              const json = await res.json();
              if (json.success) {
                serializedCategories = serializedCategories.filter((c) => c.id !== id);
                renderCategoriesTab();
                renderExplorerFolderTree();
                syncCategoryDropdown();
                if ('caches' in window) {
                  caches.keys().then((names) => {
                    names.forEach((name) => {
                      caches.open(name).then((c) => {
                        c.delete('/');
                        c.delete('/api/categories');
                      });
                    });
                  }).catch(() => {});
                }
                if (window.showAdminToast) window.showAdminToast('ফোল্ডার সফলভাবে মুছে ফেলা হয়েছে! ✓');
              } else {
                alert(json.message || 'ডিলিট করতে সমস্যা হয়েছে।');
              }
            } catch (err) {
              alert('ত্রুটি: ' + err.message);
            }
          });
        });
      }

      addCatBtn?.addEventListener('click', async () => {
        const title = newCatLabel?.value.trim();
        const customSlug = newCatSlug?.value.trim();
        const desc = newCatDesc?.value.trim();

        if (!title) {
          alert('অনুগ্রহ করে ফোল্ডার বা বিভাগের নাম লিখুন।');
          newCatLabel?.focus();
          return;
        }

        const addCatBtnText = document.getElementById('add-cat-btn-text');
        if (addCatBtnText) addCatBtnText.innerText = 'সংরক্ষণ হচ্ছে...';
        addCatBtn.disabled = true;

        try {
          const res = await fetch('/api/categories', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: customSlug, title, desc })
          });
          const json = await res.json();

          if (json.success && json.category) {
            const existingIdx = serializedCategories.findIndex((c) => c.id === json.category.id);
            if (existingIdx >= 0) {
              serializedCategories[existingIdx] = json.category;
            } else {
              serializedCategories.push(json.category);
            }
            renderCategoriesTab();
            renderExplorerFolderTree();
            syncCategoryDropdown();

            if (newCatLabel) newCatLabel.value = '';
            if (newCatSlug) newCatSlug.value = '';
            if (newCatDesc) newCatDesc.value = '';

            if ('caches' in window) {
              caches.keys().then((names) => {
                names.forEach((name) => {
                  caches.open(name).then((c) => {
                    c.delete('/');
                    c.delete('/api/categories');
                  });
                });
              }).catch(() => {});
            }

            if (window.showAdminToast) {
              window.showAdminToast(`'${title}' ফোল্ডার সফলভাবে ক্লাউডে সংরক্ষিত হয়েছে! ✓`);
            }
          } else {
            alert(json.message || 'বিভাগ সংরক্ষণ ব্যর্থ হয়েছে।');
          }
        } catch (err) {
          alert('ত্রুটি: ' + err.message);
        } finally {
          addCatBtn.disabled = false;
          if (addCatBtnText) {
            addCatBtnText.innerText = 'নতুন ফোল্ডারটি সংরক্ষণ করুন';
          }
        }
      });

      attachDeleteCategoryListeners();

      // 12. Bookshelf Manager (Add Read, Add Wish, Quick Delete)
      const adminBooksList = document.getElementById('admin-books-list');
      const addReadBtn = document.getElementById('add-read-book-btn');
      const addWishBtn = document.getElementById('add-wish-book-btn');

      function getBookshelfData() {
        const stored = localStorage.getItem('kherokhata_bookshelf_custom');
        if (stored) {
          try {
            return JSON.parse(stored);
          } catch (e) {}
        }
        return JSON.parse(JSON.stringify(initialBookshelf));
      }

      async function saveBookshelfData(data) {
        localStorage.setItem('kherokhata_bookshelf_custom', JSON.stringify(data));
        renderAdminBooks();
        if (window.showAdminToast) window.showAdminToast('বুকশেলফ হালনাগাদ করা হয়েছে! ✓');

        try {
          await fetch('/api/bookshelf', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
          });
        } catch (e) {
          console.warn('[Admin] Bookshelf cloud sync error:', e);
        }
      }

      function renderAdminBooks() {
        if (!adminBooksList) return;
        const data = getBookshelfData();
        adminBooksList.innerHTML = '';

        // Finished Books Sub-List
        const readWrapper = document.createElement('div');
        readWrapper.className = 'space-y-2';
        readWrapper.innerHTML = `
          <h5 class="font-bold text-xs text-paper-accent dark:text-night-accent flex items-center gap-1.5">
            <span>📖</span> <span>পড়া শেষ বইসমূহ (${data.readBooks?.length || 0}টি):</span>
          </h5>
        `;

        if (!data.readBooks || data.readBooks.length === 0) {
          readWrapper.innerHTML += `<p class="text-xs text-paper-muted italic">কোনো পঠিত বই যুক্ত করা হয়নি।</p>`;
        } else {
          data.readBooks.forEach((book, idx) => {
            const item = document.createElement('div');
            item.className = 'p-3 rounded-xl border border-paper-border/60 dark:border-night-border/60 bg-paper-surface dark:bg-night-surface flex items-center justify-between gap-3';
            item.innerHTML = `
              <div>
                <span class="font-bold text-paper-text dark:text-night-text">${book.title}</span>
                <span class="text-paper-muted"> — ${book.author} (${book.readYear || '২০২৬'})</span>
                <span class="ml-2 text-amber-500 font-bold">★ ${book.rating || '৫'}</span>
              </div>
              <button type="button" class="text-red-500 hover:text-red-700 text-xs font-semibold cursor-pointer" data-delete-read="${book.id || idx}">
                মুছুন ✕
              </button>
            `;
            readWrapper.appendChild(item);
          });
        }

        // Wishlist Sub-List
        const wishWrapper = document.createElement('div');
        wishWrapper.className = 'space-y-2 pt-4 border-t border-paper-border/60';
        wishWrapper.innerHTML = `
          <h5 class="font-bold text-xs text-paper-accent dark:text-night-accent flex items-center gap-1.5">
            <span>🎯</span> <span>পড়ার ইচ্ছেতালিকা (${data.wishlistBooks?.length || 0}টি):</span>
          </h5>
        `;

        if (!data.wishlistBooks || data.wishlistBooks.length === 0) {
          wishWrapper.innerHTML += `<p class="text-xs text-paper-muted italic">ইচ্ছেতালিকায় কোনো বই নেই।</p>`;
        } else {
          data.wishlistBooks.forEach((itemData, idx) => {
            const item = document.createElement('div');
            item.className = 'p-3 rounded-xl border border-paper-border/60 dark:border-night-border/60 bg-paper-surface dark:bg-night-surface flex items-center justify-between gap-3';
            item.innerHTML = `
              <div>
                <span class="font-bold text-paper-text dark:text-night-text">${itemData.title}</span>
                <span class="text-paper-muted"> — ${itemData.author}</span>
                <span class="ml-2 text-[10px] px-2 py-0.5 rounded-full bg-paper-accent/10 text-paper-accent font-semibold">${itemData.priority || 'উচ্চ'}</span>
              </div>
              <div class="flex items-center gap-2">
                <button type="button" class="text-emerald-600 hover:text-emerald-700 text-xs font-semibold cursor-pointer" data-complete-wish="${itemData.id || idx}" title="পড়া শেষ হিসেবে চিহ্নিত করুন">
                  ✓ পড়া শেষ
                </button>
                <button type="button" class="text-red-500 hover:text-red-700 text-xs font-semibold cursor-pointer" data-delete-wish="${itemData.id || idx}">
                  মুছুন ✕
                </button>
              </div>
            `;
            wishWrapper.appendChild(item);
          });
        }

        adminBooksList.appendChild(readWrapper);
        adminBooksList.appendChild(wishWrapper);

        // Delete handlers
        adminBooksList.querySelectorAll('[data-delete-read]').forEach((btn) => {
          btn.addEventListener('click', () => {
            const id = btn.getAttribute('data-delete-read');
            const d = getBookshelfData();
            d.readBooks = d.readBooks.filter((b, i) => (b.id ? b.id !== id : i.toString() !== id));
            saveBookshelfData(d);
          });
        });

        adminBooksList.querySelectorAll('[data-delete-wish]').forEach((btn) => {
          btn.addEventListener('click', () => {
            const id = btn.getAttribute('data-delete-wish');
            const d = getBookshelfData();
            d.wishlistBooks = d.wishlistBooks.filter((w, i) => (w.id ? w.id !== id : i.toString() !== id));
            saveBookshelfData(d);
          });
        });

        adminBooksList.querySelectorAll('[data-complete-wish]').forEach((btn) => {
          btn.addEventListener('click', () => {
            const id = btn.getAttribute('data-complete-wish');
            const d = getBookshelfData();
            const targetIdx = d.wishlistBooks.findIndex((w, i) => (w.id ? w.id === id : i.toString() === id));
            if (targetIdx !== -1) {
              const comp = d.wishlistBooks.splice(targetIdx, 1)[0];
              d.readBooks.unshift({
                id: 'read-' + Date.now(),
                title: comp.title,
                author: comp.author,
                readYear: new Date().getFullYear().toString(),
                rating: '৫',
                tag: 'নির্বাচিত পাঠ',
                review: comp.note || 'পড়া সম্পন্ন হয়েছে।'
              });
              saveBookshelfData(d);
            }
          });
        });
