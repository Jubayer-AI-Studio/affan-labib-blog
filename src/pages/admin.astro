      const fullbioInput = document.getElementById('edit-author-fullbio');
      const manifestoTitleInput = document.getElementById('edit-author-manifesto-title');
      const manifestoInput = document.getElementById('edit-author-manifesto');
      const fbInput = document.getElementById('edit-author-fb');
