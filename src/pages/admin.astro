                        data-id="${safeId}"
                      >
                        উত্তর প্রকাশ করুন
                      </button>
                    </div>
                  </div>
                </div>
              `;
            }).join('');
          }
        }
      }

      // ========================================================
      // Universal Non-blocking Event Delegation (Profile & Moderation)
      // ========================================================
      document.addEventListener('click', async (e) => {
        // 1. Profile Save
        const saveProfileTrigger = e.target.closest('#save-profile-btn');
        if (saveProfileTrigger) {
          e.preventDefault();
          await doSaveProfile();
          return;
        }

        // 2. Reply Toggle
        const replyBtn = e.target.closest('.admin-reply-btn');
        if (replyBtn) {
          e.preventDefault();
          const card = replyBtn.closest('.comment-card-item');
          const formBox = card ? card.querySelector('.reply-form-box') : null;
          if (formBox) {
            formBox.classList.toggle('hidden');
            if (!formBox.classList.contains('hidden')) {
              formBox.querySelector('.reply-textarea-input')?.focus();
            }
          }
          return;
        }

        // 3. Cancel Reply
        const cancelReplyBtn = e.target.closest('.cancel-reply-btn');
        if (cancelReplyBtn) {
          e.preventDefault();
          const card = cancelReplyBtn.closest('.comment-card-item');
          const formBox = card ? card.querySelector('.reply-form-box') : null;
          if (formBox) formBox.classList.add('hidden');
          return;
        }

        // 4. Submit Reply
        const submitReplyBtn = e.target.closest('.submit-reply-btn');
        if (submitReplyBtn) {
          e.preventDefault();
          const card = submitReplyBtn.closest('.comment-card-item');
          const formBox = card ? card.querySelector('.reply-form-box') : null;
          const textarea = formBox ? formBox.querySelector('.reply-textarea-input') : null;
          const text = textarea?.value?.trim();
          if (!text) {
            if (textarea) textarea.focus();
            if (window.showAdminToast) window.showAdminToast('⚠️ উত্তরের বিবরণ খালি রাখা যাবে না');
            return;
          }

          const slug = submitReplyBtn.getAttribute('data-slug') || card?.getAttribute('data-slug') || '';
          const commentId = submitReplyBtn.getAttribute('data-id') || card?.getAttribute('data-comment-id') || '';

          submitReplyBtn.disabled = true;
          const origSubmitText = submitReplyBtn.innerHTML;
          submitReplyBtn.innerHTML = '<span>⏳ প্রকাশ হচ্ছে...</span>';

          try {
            const res = await fetch('/api/interactions', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                action: 'reply',
                slug,
                parentId: commentId,
                content: text,
                authorName: 'আফফান লাবীব (লেখক)'
              })
            });
            const json = await res.json();
            if (json && json.success) {
              if (formBox) formBox.classList.add('hidden');
              if (textarea) textarea.value = '';
              if (window.showAdminToast) window.showAdminToast('✓ আপনার উত্তরটি সফলভাবে প্রকাশিত হয়েছে!');
              loadInteractionsData();
            } else {
              throw new Error(json.error || 'উত্তর প্রকাশ ব্যর্থ হয়েছে');
            }
          } catch (err) {
            if (window.showAdminToast) window.showAdminToast('⚠️ উত্তর প্রকাশে সমস্যা: ' + (err.message || err));
          } finally {
            submitReplyBtn.disabled = false;
            submitReplyBtn.innerHTML = origSubmitText;
          }
          return;
        }

        // 5. Delete Button Clicked -> Show inline confirmation
        const deleteBtn = e.target.closest('.admin-delete-cmt-btn');
        if (deleteBtn) {
          e.preventDefault();
          const wrap = deleteBtn.closest('.del-wrap');
          const confirmBox = wrap ? wrap.querySelector('.confirm-del-box') : null;
          if (confirmBox) {
            deleteBtn.classList.add('hidden');
            confirmBox.classList.remove('hidden');
          }
          return;
        }

        // 6. Confirm Delete "No" -> Cancel
        const confirmNoBtn = e.target.closest('.confirm-del-no-btn');
        if (confirmNoBtn) {
          e.preventDefault();
          const wrap = confirmNoBtn.closest('.del-wrap');
          const deleteBtn = wrap ? wrap.querySelector('.admin-delete-cmt-btn') : null;
          const confirmBox = wrap ? wrap.querySelector('.confirm-del-box') : null;
          if (confirmBox) confirmBox.classList.add('hidden');
          if (deleteBtn) deleteBtn.classList.remove('hidden');
          return;
        }

        // 7. Confirm Delete "Yes" -> Permanent Delete
        const confirmYesBtn = e.target.closest('.confirm-del-yes-btn');
        if (confirmYesBtn) {
          e.preventDefault();
          const card = confirmYesBtn.closest('.comment-card-item');
          const commentId = confirmYesBtn.getAttribute('data-id') || card?.getAttribute('data-comment-id');
          const content = card?.getAttribute('data-comment-content') || card?.querySelector('.comment-body-text')?.textContent?.trim() || '';

          confirmYesBtn.disabled = true;
          confirmYesBtn.innerHTML = '⏳';

          try {
            const res = await fetch('/api/interactions', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                action: 'delete_comment',
                commentId,
                content
              })
            });
            const json = await res.json();
            if (json && json.success) {
              if (card) {
                card.style.transition = 'all 0.3s ease';
                card.style.opacity = '0';
                card.style.transform = 'scale(0.95)';
                setTimeout(() => card.remove(), 300);
              }
              currentInteractionsData.comments = (currentInteractionsData.comments || []).filter(
                (x) => x.id !== commentId && x.content !== content
              );
              const newCount = currentInteractionsData.comments.length;
              if (adminTotalComments) adminTotalComments.textContent = toBn(newCount);
              if (adminCommentsFeedBadge) adminCommentsFeedBadge.textContent = `${toBn(newCount)}টি মন্তব্য`;
              if (window.showAdminToast) window.showAdminToast('✓ মন্তব্যটি স্থায়ীভাবে মুছে ফেলা হয়েছে।');
            } else {
              throw new Error(json.error || 'মুছে ফেলা সম্ভব হয়নি');
            }
          } catch (err) {
            if (window.showAdminToast) window.showAdminToast('⚠️ মন্তব্য মুছতে সমস্যা হয়েছে: ' + (err.message || err));
            confirmYesBtn.disabled = false;
            confirmYesBtn.innerHTML = 'হ্যাঁ';
          }
          return;
        }
      });

      refreshInteractionsBtn?.addEventListener('click', () => {
        loadInteractionsData();
        if (window.showAdminToast) window.showAdminToast('✓ পাঠকদের প্রতিক্রিয়া রিফ্রেশ করা হয়েছে।');
      });

      // Load initial profile data
      loadProfileIntoForm();

      document.getElementById('tab-btn-interactions')?.addEventListener('click', () => {
        loadInteractionsData();
      });

    })();
  </script>
</AdminLayout>
