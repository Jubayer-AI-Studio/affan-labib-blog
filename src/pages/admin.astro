      saveProfileBtn?.addEventListener('click', () => {
        const chosenAvatar = avatarInput?.value.trim() || localStorage.getItem('kherokhata_author_avatar') || author.avatar;
        if (chosenAvatar) {
          try { localStorage.setItem('kherokhata_author_avatar', chosenAvatar); } catch(e) {}
        }

        const profileData = {
          name: nameInput?.value.trim() || author.name,
          education: eduInput?.value.trim() || author.education,
          tagline: taglineInput?.value.trim() || author.tagline,
          bio: shortbioInput?.value.trim() || author.bioShort,
          bioShort: shortbioInput?.value.trim() || author.bioShort,
          bioFull: fullbioInput?.value.trim() || author.bioFull,
          manifestoTitle: manifestoTitleInput?.value.trim() || author.aboutManifestoTitle,
          aboutManifestoTitle: manifestoTitleInput?.value.trim() || author.aboutManifestoTitle,
          manifesto: manifestoInput?.value.trim() || author.aboutManifesto,
          aboutManifesto: manifestoInput?.value.trim() || author.aboutManifesto,
          avatar: chosenAvatar,
          facebook: fbInput?.value.trim() || author.social?.facebook,
          whatsapp: waInput?.value.trim() || author.social?.whatsapp,
        };

        localStorage.setItem('kherokhata_author_custom', JSON.stringify(profileData));
        if (profileData.avatar) {
          localStorage.setItem('kherokhata_author_avatar', profileData.avatar);
        }

        // Trigger global sync event
        window.dispatchEvent(new CustomEvent('kherokhata-author-sync'));

