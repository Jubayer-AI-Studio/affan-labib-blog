        if (data.readBooks.length === 0) {
          readWrapper.innerHTML += `<p class="text-xs text-paper-muted italic">কোনো পঠিত বই যুক্ত করা হয়নি।</p>`;
        } else {
          data.readBooks.forEach((book, idx) => {
            const item = document.createElement('div');
            item.className = 'p-3 rounded-xl border border-paper-border/60 dark:border-night-border/60 bg-paper-surface flex items-center justify-between gap-3';
            item.innerHTML = `
              <div>
                <span class="font-bold font-serif text-sm text-paper-text dark:text-night-text">${book.title}</span>
                <span class="text-xs text-paper-muted ml-2">— ${book.author} (${book.readYear})</span>
                <span class="ml-2 text-amber-500 font-mono">★ ${book.rating}</span>
                ${book.review ? `<p class="text-xs font-serif text-paper-muted italic mt-0.5">"${book.review}"</p>` : ''}
              </div>
              <button
                type="button"
                data-delete-read="${book.id || idx}"
                class="px-2.5 py-1 rounded-lg text-xs font-sans text-red-600 hover:bg-red-50 dark:hover:bg-red-950/40 border border-red-200 dark:border-red-900 transition-colors cursor-pointer"
                title="মুছে ফেলুন"
              >
                🗑️
              </button>
            `;
            readWrapper.appendChild(item);
          });
        }
        adminBooksList.appendChild(readWrapper);

        // Wishlist Sub-List
        const wishWrapper = document.createElement('div');
        wishWrapper.className = 'space-y-2 pt-4 border-t border-paper-border/60';
        wishWrapper.innerHTML = `
          <h5 class="font-bold text-xs text-paper-accent dark:text-night-accent flex items-center gap-1.5">
            <span>🎯</span> <span>পড়ার উইশলিস্ট টাস্ক (${data.wishlistBooks.length}টি):</span>
          </h5>
        `;

        if (data.wishlistBooks.length === 0) {
          wishWrapper.innerHTML += `<p class="text-xs text-paper-muted italic">উইশলিস্টে কোনো বই নেই।</p>`;
        } else {
          data.wishlistBooks.forEach((wish, idx) => {
            const item = document.createElement('div');
            item.className = 'p-3 rounded-xl border border-paper-border/60 dark:border-night-border/60 bg-paper-surface flex items-center justify-between gap-3';
            item.innerHTML = `
              <div>
                <span class="font-bold font-serif text-sm text-paper-text dark:text-night-text">${wish.title}</span>
                <span class="text-xs text-paper-muted ml-2">— ${wish.author}</span>
                <span class="ml-2 text-[10px] px-2 py-0.5 rounded-full bg-paper-border text-paper-text">${wish.priority}</span>
                ${wish.note ? `<p class="text-xs font-serif text-paper-muted italic mt-0.5">"${wish.note}"</p>` : ''}
              </div>
              <div class="flex items-center gap-2">
                <button
                  type="button"
                  data-complete-wish="${wish.id || idx}"
                  class="px-2.5 py-1 rounded-lg text-xs font-sans bg-emerald-50 text-emerald-700 dark:bg-emerald-950/40 dark:text-emerald-400 border border-emerald-300 dark:border-emerald-800 hover:opacity-90 cursor-pointer flex items-center gap-1"
                  title="পড়া শেষ হিসেবে পড়া বইয়ের ঘরে স্থানান্তর করুন"
                >
                  <span>✓</span> <span>পড়া শেষ</span>
                </button>
                <button
                  type="button"
                  data-delete-wish="${wish.id || idx}"
                  class="px-2 py-1 rounded-lg text-xs font-sans text-red-600 hover:bg-red-50 dark:hover:bg-red-950/40 border border-red-200 dark:border-red-900 transition-colors cursor-pointer"
                  title="মুছে ফেলুন"
                >
                  🗑️
                </button>
              </div>
            `;
            wishWrapper.appendChild(item);
          });
        }
        adminBooksList.appendChild(wishWrapper);

        // Attach action handlers
        adminBooksList.querySelectorAll('[data-delete-read]').forEach((btn) => {
          btn.addEventListener('click', () => {
            const id = btn.getAttribute('data-delete-read');
            const d = getBookshelfData();
            d.readBooks = d.readBooks.filter((b, i) => (b.id ? b.id !== id : i.toString() !== id));
            saveBookshelfData(d);
          });
        });

        adminBooksList.querySelectorAll('[data-delete-wish]').forEach((btn) => {
          btn.addEventListener('click', () => {
            const id = btn.getAttribute('data-delete-wish');
            const d = getBookshelfData();
            d.wishlistBooks = d.wishlistBooks.filter((w, i) => (w.id ? w.id !== id : i.toString() !== id));
            saveBookshelfData(d);
          });
        });

        adminBooksList.querySelectorAll('[data-complete-wish]').forEach((btn) => {
          btn.addEventListener('click', () => {
            const id = btn.getAttribute('data-complete-wish');
            const d = getBookshelfData();
            const targetIndex = d.wishlistBooks.findIndex((w, i) => (w.id ? w.id === id : i.toString() === id));
            if (targetIndex !== -1) {
              const completed = d.wishlistBooks.splice(targetIndex, 1)[0];
              d.readBooks.unshift({
                id: 'read-' + Date.now(),
                title: completed.title,
                author: completed.author,
                readYear: new Date().getFullYear().toString(),
                review: completed.note || 'সম্প্রতি পড়া সমাপ্ত হয়েছে।',
                rating: 5,
                tag: 'নব্য সমাপ্ত কিতাব',
                coverBg: 'from-amber-950/40 via-neutral-900 to-orange-950/30'
              });
              saveBookshelfData(d);
              alert(`'${completed.title}' বইটি পড়া শেষ তালিকায় যুক্ত করা হয়েছে! ✓`);
            }
          });
        });
      }

      addReadBtn?.addEventListener('click', () => {
        const title = document.getElementById('new-read-title')?.value.trim();
        const bAuthor = document.getElementById('new-read-author')?.value.trim();
        const year = document.getElementById('new-read-year')?.value.trim() || '২০২৬';
        const rating = parseFloat(document.getElementById('new-read-rating')?.value) || 5;
        const tag = document.getElementById('new-read-tag')?.value.trim() || 'পঠিত কিতাব';
        const review = document.getElementById('new-read-review')?.value.trim() || '';

        if (!title || !bAuthor) {
          alert('অনুগ্রহ করে বইয়ের নাম ও লেখকের নাম লিখুন।');
          return;
        }

        const d = getBookshelfData();
        d.readBooks.unshift({
          id: 'read-' + Date.now(),
          title,
          author: bAuthor,
          readYear: year,
          rating,
          tag,
          review,
          coverBg: 'from-amber-950/40 via-neutral-900 to-orange-950/30'
        });
        saveBookshelfData(d);

        document.getElementById('new-read-title').value = '';
        document.getElementById('new-read-author').value = '';
        document.getElementById('new-read-review').value = '';
        alert('নতুন পড়া বই সফলভাবে যুক্ত হয়েছে! ✓');
      });

      addWishBtn?.addEventListener('click', () => {
        const title = document.getElementById('new-wish-title')?.value.trim();
        const bAuthor = document.getElementById('new-wish-author')?.value.trim();
        const priority = document.getElementById('new-wish-priority')?.value || 'উচ্চ';
        const note = document.getElementById('new-wish-note')?.value.trim() || '';

        if (!title || !bAuthor) {
          alert('অনুগ্রহ করে বইয়ের নাম ও লেখকের নাম লিখুন।');
          return;
        }

        const d = getBookshelfData();
        d.wishlistBooks.unshift({
          id: 'wish-' + Date.now(),
          title,
          author: bAuthor,
          priority,
          note,
          isCompleted: false
        });
        saveBookshelfData(d);

        document.getElementById('new-wish-title').value = '';
        document.getElementById('new-wish-author').value = '';
        document.getElementById('new-wish-note').value = '';
        alert('উইশলিস্টে নতুন বই সফলভাবে যুক্ত হয়েছে! ✓');
      });

      // Export JSON File Download Handler
      document.getElementById('export-bookshelf-json-btn')?.addEventListener('click', () => {
        const data = getBookshelfData();
        const jsonStr = JSON.stringify(data, null, 2);
        const blob = new Blob([jsonStr], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'bookshelf.json';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
        alert('আপডেটকৃত bookshelf.json ডাউনলোড হয়েছে! এটি প্রজেক্টের src/data/ ফোল্ডারে রিপ্লেস করতে পারেন।');
      });

      // Copy JSON Code Handler
      document.getElementById('copy-bookshelf-json-btn')?.addEventListener('click', async () => {
        const data = getBookshelfData();
        const jsonStr = JSON.stringify(data, null, 2);
        try {
          await navigator.clipboard.writeText(jsonStr);
          const copyLabel = document.getElementById('copy-bookshelf-text');
          if (copyLabel) copyLabel.innerText = '✓ কপি হয়েছে!';
          setTimeout(() => {
            if (copyLabel) copyLabel.innerText = 'JSON কোড কপি';
          }, 2000);
        } catch (err) {
          prompt('সম্পূর্ণ bookshelf.json কোড কপি করুন:', jsonStr);
        }
      });

      // Reset to Default Bookshelf
      document.getElementById('reset-bookshelf-btn')?.addEventListener('click', () => {
        if (!confirm('আপনি কি ডিফল্ট বুকশেলফ ডেটায় ফিরে যেতে চান? আপনার কাস্টম সব পরিবর্তন মুছে যাবে।')) return;
        localStorage.removeItem('kherokhata_bookshelf_custom');
        window.dispatchEvent(new CustomEvent('kherokhata-bookshelf-sync'));
        renderAdminBooks();
        alert('বুকশেলফ ডিফল্ট অবস্থায় ফিরে গেছে! ✓');
      });

      renderAdminBooks();

      // ==========================================
      // POST DELETION HANDLER (FIX 2: Fullstack)
      // ==========================================
      document.querySelectorAll('.delete-post-btn').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const slug = btn.getAttribute('data-slug');
          if (!slug) return;

          const row = btn.closest('.file-row');
          const title = row ? (row.querySelector('.font-serif.font-semibold span:last-child')?.innerText || slug) : slug;

          if (!confirm(`আপনি কি নিশ্চিত যে "${title}" লেখাটি স্থায়ীভাবে মুছে ফেলতে চান?\nএই পরিবর্তনটি ডাটাবেস ও সাইট থেকে মুছে যাবে।`)) {
            return;
          }

          try {
            btn.disabled = true;
            btn.innerText = 'মুছছি...';
            const res = await fetch('/api/posts', {
              method: 'DELETE',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ slug })
            });
            const data = await res.json();
            if (res.ok && data.success) {
              row?.remove();
              const pIdx = serializedPosts.findIndex((p) => p.slug === slug);
              if (pIdx !== -1) serializedPosts.splice(pIdx, 1);

              const customPosts = JSON.parse(localStorage.getItem('kherokhata_custom_posts') || '[]');
              const updatedCustom = customPosts.filter((p) => p.slug !== slug);
              localStorage.setItem('kherokhata_custom_posts', JSON.stringify(updatedCustom));

              alert('লেখাটি সফলভাবে মুছে ফেলা হয়েছে! ✓');
            } else {
              alert('লেখা মুছতে সমস্যা হয়েছে: ' + (data.error || 'অজানা ত্রুটি'));
              btn.disabled = false;
              btn.innerText = '🗑️ ডিলিট';
            }
          } catch (err) {
            alert('সার্ভার এরর: ' + err.message);
            btn.disabled = false;
            btn.innerText = '🗑️ ডিলিট';
          }
        });
      });

      // ==========================================
      // LIVE WRITER SAVE & PUBLISH HANDLER
      // ==========================================
      document.getElementById('save-publish-btn')?.addEventListener('click', async () => {
        const title = editorTitle?.value.trim();
        const category = editorCat?.value || 'chinta';
        const date = editorDate?.value || new Date().toISOString().split('T')[0];
        const desc = editorDesc?.value.trim() || '';
        const tags = (editorTags?.value || '').split(',').map((t) => t.trim()).filter(Boolean);
        const body = editorBody?.value || '';

        if (!title) {
          alert('অনুগ্রহ করে লেখার শিরোনাম দিন।');
          editorTitle?.focus();
          return;
        }
        if (!body) {
          alert('অনুগ্রহ করে লেখার মূল বিষয়বস্তু লিখুন।');
          editorBody?.focus();
          return;
        }

        const saveBtn = document.getElementById('save-publish-btn');
        const origText = saveBtn ? saveBtn.innerHTML : '';
        if (saveBtn) {
          saveBtn.disabled = true;
          saveBtn.innerText = 'সংরক্ষণ হচ্ছে...';
        }

        try {
          const postPayload = {
            title,
            description: desc,
            category,
            publishedAt: date,
            tags,
            body,
            footnotes: writerFootnotes && writerFootnotes.length > 0 ? writerFootnotes : undefined
          };

          const res = await fetch('/api/posts', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(postPayload)
          });
          const result = await res.json();

          if (res.ok && result.success) {
            alert(`'${title}' লেখাটি সফলভাবে সংরক্ষিত ও প্রকাশিত হয়েছে! ✓`);
            window.location.reload();
          } else {
            alert('সংরক্ষণ ব্যর্থ হয়েছে: ' + (result.error || 'অজানা ত্রুটি'));
          }
        } catch (err) {
          alert('সার্ভারের সাথে যোগাযোগ করা যায়নি: ' + err.message);
        } finally {
          if (saveBtn) {
            saveBtn.disabled = false;
            saveBtn.innerHTML = origText;
          }
        }
      });

      // ==========================================
      // CATEGORY & FOLDER MANAGER HANDLER
      // ==========================================
      const addCatBtn = document.getElementById('add-cat-btn');
      const newCatLabel = document.getElementById('new-cat-label');
      const newCatSlug = document.getElementById('new-cat-slug');
      const newCatDesc = document.getElementById('new-cat-desc');

      addCatBtn?.addEventListener('click', () => {
        const label = newCatLabel?.value.trim();
        const slug = newCatSlug?.value.trim().toLowerCase().replace(/[^a-z0-9-]/g, '-');
        const desc = newCatDesc?.value.trim();

        if (!label || !slug) {
          alert('অনুগ্রহ করে বিভাগের নাম ও স্লাগ লিখুন।');
          return;
        }

        const customCats = JSON.parse(localStorage.getItem('kherokhata_custom_categories') || '[]');
        if (customCats.some((c) => c.slug === slug)) {
          alert('এই স্লাগ দিয়ে ইতিমধ্যে একটি বিষয়শ্রেণী তৈরি আছে।');
          return;
        }

        customCats.push({ label, slug, desc });
        localStorage.setItem('kherokhata_custom_categories', JSON.stringify(customCats));

        if (editorCat) {
          const opt = document.createElement('option');
          opt.value = slug;
          opt.textContent = `${label} (${slug})`;
          editorCat.appendChild(opt);
        }

        if (newCatLabel) newCatLabel.value = '';
        if (newCatSlug) newCatSlug.value = '';
        if (newCatDesc) newCatDesc.value = '';

        alert(`'${label}' নতুন ফোল্ডার/বিষয়শ্রেণী সফলভাবে তৈরি হয়েছে! ✓`);
      });

  })();

  </script>
</Layout>
