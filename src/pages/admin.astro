      function escapeHtml(str) {
        if (!str) return '';
        return String(str)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#039;');
      }

      async function loadProfileIntoForm() {
        try {
          const res = await fetch('/api/author?_t=' + Date.now());
          if (res.ok) {
            const data = await res.json();
            if (data.success && data.author) {
              const current = data.author;
              if (nameInp) nameInp.value = current.name || '';
              if (eduInp) eduInp.value = current.education || '';
              if (tagInp) tagInp.value = current.tagline || '';
              if (shortbioInp) shortbioInp.value = current.bioShort || '';
              if (fullbioInp) fullbioInp.value = current.bioFull || '';
              if (manifestoTitleInp) manifestoTitleInp.value = current.aboutManifestoTitle || 'কেন এই পড়ার ঘর?';
              if (manifestoInp) manifestoInp.value = current.aboutManifesto || '';
              if (fbInp) fbInp.value = current.social?.facebook || '';
              if (waInp) waInp.value = current.social?.whatsapp || '';
              if (emailInp) emailInp.value = current.social?.email || '';
              localStorage.setItem('kherokhata_author_custom', JSON.stringify(current));
              return;
            }
          }
        } catch (e) {}

        const custom = localStorage.getItem('kherokhata_author_custom');
        const current = custom ? { ...author, ...JSON.parse(custom) } : author;

        if (nameInp && !nameInp.value) nameInp.value = current.name || '';
        if (eduInp && !eduInp.value) eduInp.value = current.education || '';
        if (tagInp && !tagInp.value) tagInp.value = current.tagline || '';
        if (shortbioInp && !shortbioInp.value) shortbioInp.value = current.bioShort || '';
        if (fullbioInp && !fullbioInp.value) fullbioInp.value = current.bioFull || '';
        if (manifestoTitleInp && !manifestoTitleInp.value) manifestoTitleInp.value = current.aboutManifestoTitle || 'কেন এই পড়ার ঘর?';
        if (manifestoInp && !manifestoInp.value) manifestoInp.value = current.aboutManifesto || '';
        if (fbInp && !fbInp.value) fbInp.value = current.social?.facebook || '';
        if (waInp && !waInp.value) waInp.value = current.social?.whatsapp || '';
        if (emailInp && !emailInp.value) emailInp.value = current.social?.email || '';
      }

      async function doSaveProfile() {
        const btn = document.getElementById('save-profile-btn');
        if (btn) btn.disabled = true;
        const origHtml = btn ? btn.innerHTML : '';
        if (btn) btn.innerHTML = '<span>⏳</span><span>সংরক্ষণ হচ্ছে...</span>';

        const updated = {
          name: (document.getElementById('profile-name')?.value || '').trim() || author.name,
          education: (document.getElementById('profile-education')?.value || '').trim(),
          tagline: (document.getElementById('profile-tagline')?.value || '').trim(),
          bioShort: (document.getElementById('profile-bio-short')?.value || '').trim(),
          bioFull: (document.getElementById('profile-bio-full')?.value || '').trim(),
          aboutManifestoTitle: (document.getElementById('profile-manifesto-title')?.value || '').trim() || 'কেন এই পড়ার ঘর?',
          aboutManifesto: (document.getElementById('profile-manifesto')?.value || '').trim(),
          social: {
            facebook: (document.getElementById('profile-facebook')?.value || '').trim(),
            whatsapp: (document.getElementById('profile-whatsapp')?.value || '').trim(),
            email: (document.getElementById('profile-email')?.value || '').trim()
          }
        };

        try {
          const res = await fetch('/api/author', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(updated)
          });
          const result = await res.json();
          if (result.success) {
            const finalAuthor = result.author || updated;
            localStorage.setItem('kherokhata_author_custom', JSON.stringify(finalAuthor));

            // Sync live DOM elements on page
            document.querySelectorAll('.author-name-text').forEach((el) => { el.innerText = finalAuthor.name; });
            document.querySelectorAll('.author-edu-text').forEach((el) => { el.innerText = finalAuthor.education; });
            document.querySelectorAll('.author-tagline-text').forEach((el) => { el.innerText = finalAuthor.tagline; });
            document.querySelectorAll('.author-shortbio-text').forEach((el) => { el.innerText = finalAuthor.bioShort; });
            document.querySelectorAll('.author-biofull-text').forEach((el) => { el.innerText = finalAuthor.bioFull; });
            document.querySelectorAll('.author-manifesto-title-text').forEach((el) => { el.innerText = finalAuthor.aboutManifestoTitle; });
            document.querySelectorAll('.author-manifesto-text').forEach((el) => { el.innerText = finalAuthor.aboutManifesto; });

            const statusEl = document.getElementById('profile-save-status');
            const inlineStatusEl = document.getElementById('profile-save-status-inline');
            if (statusEl) {
              statusEl.classList.remove('hidden');
              setTimeout(() => statusEl.classList.add('hidden'), 6000);
            }
            if (inlineStatusEl) {
              inlineStatusEl.classList.remove('hidden');
              setTimeout(() => inlineStatusEl.classList.add('hidden'), 6000);
            }

            // High-visibility button feedback
            if (btn) {
              btn.classList.remove('bg-paper-accent', 'dark:bg-night-accent');
              btn.classList.add('bg-emerald-600', 'text-white');
              btn.innerHTML = '<span>✓</span><span>সফলভাবে সংরক্ষিত!</span>';
            }

            window.dispatchEvent(new CustomEvent('kherokhata-author-sync'));
            if (window.showAdminToast) window.showAdminToast('✓ লেখক পরিচিতি সফলভাবে সংরক্ষিত হয়েছে!');

            setTimeout(() => {
              if (btn) {
                btn.disabled = false;
                btn.classList.remove('bg-emerald-600', 'text-white');
                btn.classList.add('bg-paper-accent', 'dark:bg-night-accent');
                btn.innerHTML = origHtml || '<span>💾</span><span>প্রোফাইল সংরক্ষণ করুন</span>';
              }
            }, 3500);
          } else {
            throw new Error(result.error || 'সংরক্ষণ ব্যর্থ হয়েছে');
          }
        } catch (err) {
          console.error('[Admin] Profile save error:', err);
          localStorage.setItem('kherokhata_author_custom', JSON.stringify(updated));
          if (window.showAdminToast) window.showAdminToast('✓ লোকালে সংরক্ষিত হয়েছে (ক্লাউড সিঙ্ক অপেক্ষা করছে)');
          if (btn) {
            btn.disabled = false;
            btn.innerHTML = origHtml || '<span>💾</span><span>প্রোফাইল সংরক্ষণ করুন</span>';
          }
        }
      }

      resetProfileBtn?.addEventListener('click', () => {
        if (nameInp) nameInp.value = author.name;
