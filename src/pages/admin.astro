      function renderAdminInteractions() {
        const stats = currentInteractionsData.stats || {};
        const comments = currentInteractionsData.comments || [];

        // Calculate totals
        let totalViews = 0;
        let totalLikes = 0;
        Object.values(stats).forEach((s) => {
          totalViews += (s.views || 0);
          totalLikes += (s.likes || 0);
        });

        if (adminTotalViews) adminTotalViews.textContent = toBn(totalViews);
        if (adminTotalLikes) adminTotalLikes.textContent = toBn(totalLikes);
        if (adminTotalComments) adminTotalComments.textContent = toBn(comments.length);
        if (adminCommentsFeedBadge) adminCommentsFeedBadge.textContent = `${toBn(comments.length)}টি মন্তব্য`;

        // Render Articles Stats List
        if (adminArticlesStatsList) {
          const allPosts = serializedPosts || [];
          if (allPosts.length === 0) {
            adminArticlesStatsList.innerHTML = '<div class="py-6 text-center text-xs font-serif text-paper-muted">কোনো রচনা নেই</div>';
          } else {
            adminArticlesStatsList.innerHTML = allPosts.map((p) => {
              const st = stats[p.slug] || { views: 0, likes: 0 };
              const postComments = comments.filter((c) => isSameArticleSlug(c.slug, p.slug)).length;
              return `
