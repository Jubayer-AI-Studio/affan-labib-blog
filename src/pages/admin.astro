      function loadAuthorProfileForm() {
        const stored = localStorage.getItem('kherokhata_author_custom');
        let current = author;
        if (stored) {
          try {
            current = { ...author, ...JSON.parse(stored) };
          } catch(e) {}
        }
        if (nameInput) nameInput.value = current.name || '';
        if (eduInput) eduInput.value = current.education || '';
        if (taglineInput) taglineInput.value = current.tagline || '';
        if (shortbioInput) shortbioInput.value = current.bioShort || current.bio || '';
        if (fullbioInput) fullbioInput.value = current.bioFull || current.bio || '';
        if (manifestoTitleInput) manifestoTitleInput.value = current.aboutManifestoTitle || current.manifestoTitle || '';
        if (manifestoInput) manifestoInput.value = current.aboutManifesto || current.manifesto || '';
        if (fbInput) fbInput.value = current.social?.facebook || '';
        if (waInput) waInput.value = current.social?.whatsapp || '';
        const savedAv = localStorage.getItem('kherokhata_author_avatar');
        if (avatarInput) avatarInput.value = savedAv || current.avatar || '';
        if (avatarPreview) avatarPreview.src = savedAv || current.avatar || '/images/affan-labib.jpg';
      }

      avatarInput?.addEventListener('input', () => {
        if (avatarPreview && avatarInput.value.trim()) {
          avatarPreview.src = avatarInput.value.trim();
        }
