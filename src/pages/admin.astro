          <div class="flex items-center justify-between">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-serif font-bold bg-rose-500/15 text-rose-900 dark:text-rose-200 border border-rose-500/25">
              <span>❤️</span>
              <span>পাঠক ভালোবাসা</span>
            </span>
            <span class="w-2 h-2 rounded-full bg-rose-500 animate-pulse"></span>
          </div>
          <div id="admin-total-likes" class="text-4xl sm:text-5xl font-serif font-black tracking-tight text-rose-800 dark:text-rose-300 mt-3">
            {ssrTotalLikesBn}
          </div>
          <p class="text-xs text-paper-muted dark:text-night-muted font-serif mt-1.5">
            পাঠকদের হৃদয়স্পর্শী অনুভূতির স্থায়ী সংখ্যা
          </p>
        </div>

        <!-- Card 3: Comments -->
        <div class="relative overflow-hidden rounded-3xl border border-emerald-500/30 dark:border-emerald-500/20 bg-paper-surface/95 dark:bg-night-surface/95 backdrop-blur-xl p-6 shadow-sm group hover:border-emerald-500/50 transition-all duration-300">
          <div class="absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-emerald-600 via-teal-400 to-emerald-600"></div>
          <div class="flex items-center justify-between">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-serif font-bold bg-emerald-500/15 text-emerald-900 dark:text-emerald-200 border border-emerald-500/25">
              <span>💬</span>
              <span>সক্রিয় পাঠক সংলাপ</span>
            </span>
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          </div>
          <div id="admin-total-comments" class="text-4xl sm:text-5xl font-serif font-black tracking-tight text-emerald-800 dark:text-emerald-300 mt-3">
            {ssrTotalCommentsBn}
          </div>
          <p class="text-xs text-paper-muted dark:text-night-muted font-serif mt-1.5">
            মন্তব্যঘরে জমা হওয়া মোট পাঠক প্রতিক্রিয়া
          </p>
        </div>
      </div>

      <!-- Main Columns: Stats on Left (7 cols), Comments Moderation on Right (5 cols) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
        <!-- Left: Articles Stat Table (7 cols) -->
        <div class="lg:col-span-7 rounded-3xl border border-paper-border/90 dark:border-night-border/90 bg-paper-surface/95 dark:bg-night-surface/95 backdrop-blur-xl p-5 sm:p-6 shadow-sm space-y-4">
          <div class="flex items-center justify-between pb-3 border-b border-paper-border/60">
            <div>
              <h3 class="font-serif font-bold text-base text-paper-text dark:text-night-text flex items-center gap-2">
                <span>📊</span>
                <span>লেখাভিত্তিক লাইভ পরিসংখ্যান</span>
              </h3>
              <p class="text-xs text-paper-muted font-sans mt-0.5">প্রতিটি লেখার পাঠসংখ্যা, লাইক ও মন্তব্যের খতিয়ান</p>
            </div>
            <button
              id="refresh-interactions-btn"
              type="button"
              class="px-3.5 py-1.5 rounded-xl border border-paper-border/80 bg-paper-bg/60 text-xs font-serif font-semibold text-paper-muted hover:text-paper-text hover:border-paper-accent transition-colors flex items-center gap-1.5 cursor-pointer shadow-2xs"
            >
              <span>🔄</span>
              <span>রিফ্রেশ</span>
            </button>
          </div>

          <!-- SSR Pre-rendered Articles Stats List (Zero wait time) -->
          <div id="admin-articles-stats-list" class="space-y-2.5 max-h-[550px] overflow-y-auto pr-1">
            {posts.map((p) => {
              const st = (interactions.stats || {})[p.slug] || { views: 0, likes: 0 };
              const postComments = (ssrComments || []).filter((c) => c.slug === p.slug || c.slug === p.slug.trim()).length;
              return (
                <div class="p-3.5 rounded-2xl border border-paper-border/70 dark:border-night-border/70 bg-paper-bg/50 dark:bg-night-bg/50 flex items-center justify-between gap-3 text-xs hover:border-amber-500/30 transition-all">
                  <div class="min-w-0 flex-grow">
                    <a href={`/${p.slug}`} target="_blank" class="font-serif font-bold text-paper-text dark:text-night-text truncate block hover:text-paper-accent transition-colors">
                      {p.title}
                    </a>
                    <span class="text-[11px] text-paper-muted font-sans">{p.formattedDate || p.publishedAt}</span>
                  </div>
                  <div class="flex items-center gap-2.5 font-serif text-xs shrink-0 select-none">
                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-lg bg-amber-500/10 text-amber-900 dark:text-amber-200 border border-amber-500/20" title="ভিউ">
                      <span>👁️</span>
                      <span class="font-bold">{toBnDigits(st.views)}</span>
                    </span>
                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-lg bg-rose-500/10 text-rose-800 dark:text-rose-200 border border-rose-500/20" title="লাইক">
                      <span>❤️</span>
                      <span class="font-bold">{toBnDigits(st.likes)}</span>
                    </span>
                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-lg bg-emerald-500/10 text-emerald-800 dark:text-emerald-200 border border-emerald-500/20" title="মন্তব্য">
                      <span>💬</span>
                      <span class="font-bold">{toBnDigits(postComments)}</span>
                    </span>
                  </div>
                </div>
              );
            })}
          </div>
        </div>

        <!-- Right: Comments Feed & Moderation (5 cols) -->
        <div class="lg:col-span-5 rounded-3xl border border-paper-border/90 dark:border-night-border/90 bg-paper-surface/95 dark:bg-night-surface/95 backdrop-blur-xl p-5 sm:p-6 shadow-sm space-y-4">
          <div class="flex items-center justify-between pb-3 border-b border-paper-border/60">
            <div>
              <h3 class="font-serif font-bold text-base text-paper-text dark:text-night-text flex items-center gap-2">
                <span>💬</span>
                <span>মন্তব্যঘর নিয়ন্ত্রণ ও উত্তর</span>
