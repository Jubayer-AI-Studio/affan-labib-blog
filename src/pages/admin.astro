---
// src/pages/admin.astro
import Layout from '../layouts/Layout.astro';
import posts from '../data/posts.json';
import author from '../data/author.json';
import defaultBookshelf from '../data/bookshelf.json';
---

<Layout
  title="লেখক স্টুডিও | আফফান লাবীব"
  description="আফফান লাবীবের নিভৃত লেখক স্টুডিও ও কন্টেন্ট ড্যাশবোর্ড।"
>
<div id="pin-screen" class="max-w-md mx-auto my-12 p-8 rounded-3xl border border-paper-border dark:border-night-border bg-paper-surface/90 dark:bg-night-surface/90 backdrop-blur-xl shadow-2xl text-center space-y-6"> <div class="w-16 h-16 mx-auto rounded-2xl bg-paper-accent/15 dark:bg-night-accent/20 text-paper-accent dark:text-night-accent flex items-center justify-center text-3xl shadow-sm">
🔐
</div> <div class="space-y-2"> <h1 class="text-2xl font-bold font-serif text-paper-text dark:text-night-text">
লেখক ও অ্যাডমিন প্রবেশদ্বার
</h1> <p class="text-xs text-paper-muted dark:text-night-muted font-sans leading-relaxed">
এই অংশটি শুধুমাত্র আফফান লাবীবের ব্যক্তিগত ব্যবহারের জন্য। অনুগ্রহ করে ৪-সংখ্যার গোপন পিন কোড লিখুন।
</p> </div> <div class="space-y-4"> <div class="relative"> <input id="pin-input" type="password" maxlength="6" placeholder="••••" autofocus class="w-full text-center text-2xl tracking-[0.5em] font-mono py-3.5 px-4 rounded-xl border border-paper-border dark:border-night-border bg-paper-bg dark:bg-night-bg text-paper-text dark:text-night-text focus:outline-none focus:border-paper-accent dark:focus:border-night-accent"> </div> <p id="pin-error" class="hidden text-xs text-red-600 font-sans font-medium">
❌ পিন কোডটি সঠিক নয়! পুনরায় চেষ্টা করুন।
</p> <button id="pin-submit-btn" type="button" class="w-full py-3 rounded-xl bg-paper-accent dark:bg-night-accent text-white font-sans text-sm font-semibold hover:opacity-95 shadow-md transition-all cursor-pointer">
স্টুডিও আনলক করুন →
</button> <p class="text-[11px] text-paper-muted dark:text-night-muted font-sans opacity-70">
(ডিফল্ট পিন: 1234 — প্রবেশের পর পরিবর্তন করতে পারবেন)
</p> </div> </div>  <div id="studio-screen" class="hidden space-y-8"> <!-- Studio Header Bar --> <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 p-5 rounded-2xl border border-paper-border/80 dark:border-night-border/80 bg-paper-surface/85 dark:bg-night-surface/85 backdrop-blur-xl shadow-xs"> <div class="flex items-center gap-3"> <img src="/images/affan-labib.jpg" alt="আফফান লাবীব" class="author-avatar-img w-10 h-10 rounded-xl object-cover ring-2 ring-paper-accent/30"> <div> <div class="flex items-center gap-2"> <h2 class="text-lg font-bold font-serif text-paper-text dark:text-night-text">
আফফান লাবীব — রাইটার্স স্টুডিও
</h2> <span class="px-2 py-0.5 rounded-full text-[10px] font-sans font-medium bg-emerald-500/15 text-emerald-700 dark:text-emerald-400 border border-emerald-500/30">
● অ্যাডমিন সক্রিয়
</span> </div> <p class="text-xs text-paper-muted dark:text-night-muted font-sans">
ব্যক্তিগত রচনাগার, সি-ড্রাইভ ফোল্ডার এক্সপ্লোরার ও লাইভ এডিটর
</p> </div> </div> <div class="flex items-center gap-2"> <a href="/" target="_blank" class="px-3 py-1.5 rounded-lg border border-paper-border dark:border-night-border hover:bg-paper-border/40 text-xs font-sans font-medium transition-colors">
আসল সাইট দেখুন ↗
</a> <button id="logout-btn" type="button" class="px-3 py-1.5 rounded-lg bg-red-50 dark:bg-red-950/40 border border-red-200 dark:border-red-800 text-red-600 dark:text-red-400 text-xs font-sans font-medium hover:bg-red-100 transition-colors cursor-pointer">
লগআউট
</button> </div> </div> <!-- Navigation Tabs --> <div class="flex items-center gap-2 overflow-x-auto pb-2 border-b border-paper-border/80 dark:border-night-border/80 text-xs font-sans"> <button id="tab-btn-explorer" type="button" class="admin-tab-btn px-4 py-2 rounded-xl font-medium transition-colors bg-paper-accent text-white shadow-2xs" data-tab="tab-explorer">
🗂️ ফোল্ডার এক্সপ্লোরার (C: Drive)
</button> <button id="tab-btn-writer" type="button" class="admin-tab-btn px-4 py-2 rounded-xl font-medium transition-colors border border-paper-border dark:border-night-border bg-paper-surface/60 dark:bg-night-surface/60 text-paper-muted dark:text-night-muted hover:text-paper-text" data-tab="tab-writer">
✍️ লাইভ রাইটার্স ডেস্ক (Split-View)
</button> <button id="tab-btn-profile" type="button" class="admin-tab-btn px-4 py-2 rounded-xl font-medium transition-colors border border-paper-border dark:border-night-border bg-paper-surface/60 dark:bg-night-surface/60 text-paper-muted dark:text-night-muted hover:text-paper-text" data-tab="tab-profile">
👤 লেখক প্রোফাইল ও বায়ো
</button> <button id="tab-btn-bookshelf" type="button" class="admin-tab-btn px-4 py-2 rounded-xl font-medium transition-colors border border-paper-border dark:border-night-border bg-paper-surface/60 dark:bg-night-surface/60 text-paper-muted dark:text-night-muted hover:text-paper-text" data-tab="tab-bookshelf">
📚 পাঠাগার ও বুকশেলফ
</button> <button id="tab-btn-menu" type="button" class="admin-tab-btn px-4 py-2 rounded-xl font-medium transition-colors border border-paper-border dark:border-night-border bg-paper-surface/60 dark:bg-night-surface/60 text-paper-muted dark:text-night-muted hover:text-paper-text" data-tab="tab-menu">
📁 বিষয়শ্রেণী ও ফোল্ডার ম্যানেজার
</button> <button id="tab-btn-settings" type="button" class="admin-tab-btn px-4 py-2 rounded-xl font-medium transition-colors border border-paper-border dark:border-night-border bg-paper-surface/60 dark:bg-night-surface/60 text-paper-muted dark:text-night-muted hover:text-paper-text" data-tab="tab-settings">
⚙️ পিন কোড ও নিরাপত্তা
</button> </div> <!-- TAB 1: C: Drive Folder Explorer --> <div id="tab-explorer" class="admin-tab-content space-y-6"> <div class="grid grid-cols-1 md:grid-cols-12 gap-6"> <!-- Left: Folder Tree --> <div class="md:col-span-4 rounded-2xl border border-paper-border/80 dark:border-night-border/80 bg-paper-surface/90 dark:bg-night-surface/90 p-4 space-y-3 font-mono text-xs"> <div class="pb-2 border-b border-paper-border/60 dark:border-night-border/60 font-sans font-bold text-xs text-paper-text dark:text-night-text flex items-center justify-between"> <span>💻 C:\লাবীবের_খেরোখাতা\</span> <span class="text-[10px] text-paper-muted">10টি ফাইল</span> </div> <div class="space-y-1"> <button type="button" class="folder-item w-full text-left px-3 py-2 rounded-lg bg-paper-accent/15 dark:bg-night-accent/20 text-paper-accent dark:text-night-accent font-semibold flex items-center justify-between transition-colors" data-cat="all"> <span class="flex items-center gap-2"> <span>📁</span> <span class="font-sans">সকল রচনা</span> </span> <span class="text-[11px] opacity-80 font-sans">(10)</span> </button> <button type="button" class="folder-item w-full text-left px-3 py-2 rounded-lg hover:bg-paper-border/40 dark:hover:bg-night-border/40 text-paper-text dark:text-night-text flex items-center justify-between transition-colors" data-cat="chinta"> <span class="flex items-center gap-2"> <span>📁</span> <span class="font-sans">চিন্তা</span> </span> <span class="text-[11px] text-paper-muted opacity-80 font-sans">(4)</span> </button><button type="button" class="folder-item w-full text-left px-3 py-2 rounded-lg hover:bg-paper-border/40 dark:hover:bg-night-border/40 text-paper-text dark:text-night-text flex items-center justify-between transition-colors" data-cat="pathalap"> <span class="flex items-center gap-2"> <span>📁</span> <span class="font-sans">পাঠালাপ</span> </span> <span class="text-[11px] text-paper-muted opacity-80 font-sans">(2)</span> </button><button type="button" class="folder-item w-full text-left px-3 py-2 rounded-lg hover:bg-paper-border/40 dark:hover:bg-night-border/40 text-paper-text dark:text-night-text flex items-center justify-between transition-colors" data-cat="itihas"> <span class="flex items-center gap-2"> <span>📁</span> <span class="font-sans">ইতিহাস</span> </span> <span class="text-[11px] text-paper-muted opacity-80 font-sans">(2)</span> </button><button type="button" class="folder-item w-full text-left px-3 py-2 rounded-lg hover:bg-paper-border/40 dark:hover:bg-night-border/40 text-paper-text dark:text-night-text flex items-center justify-between transition-colors" data-cat="boi-alochona"> <span class="flex items-center gap-2"> <span>📁</span> <span class="font-sans">বই-আলোচনা</span> </span> <span class="text-[11px] text-paper-muted opacity-80 font-sans">(2)</span> </button><button type="button" class="folder-item w-full text-left px-3 py-2 rounded-lg hover:bg-paper-border/40 dark:hover:bg-night-border/40 text-paper-text dark:text-night-text flex items-center justify-between transition-colors" data-cat="onubad"> <span class="flex items-center gap-2"> <span>📁</span> <span class="font-sans">অনুবাদ</span> </span> <span class="text-[11px] text-paper-muted opacity-80 font-sans">(0)</span> </button> </div> <div class="pt-3 border-t border-paper-border/50 dark:border-night-border/50"> <button id="quick-new-post-btn" type="button" class="w-full py-2 px-3 rounded-lg bg-paper-accent dark:bg-night-accent text-white font-sans text-xs font-semibold hover:opacity-95 transition-opacity flex items-center justify-center gap-1.5 shadow-xs cursor-pointer"> <span>➕</span> <span>নতুন লেখা লিখুন</span> </button> </div> </div> <!-- Right: File List View --> <div class="md:col-span-8 rounded-2xl border border-paper-border/80 dark:border-night-border/80 bg-paper-surface/90 dark:bg-night-surface/90 p-5 space-y-4"> <div class="flex items-center justify-between border-b border-paper-border/60 dark:border-night-border/60 pb-3"> <h3 id="current-folder-title" class="font-serif font-bold text-base text-paper-text dark:text-night-text">
📁 সকল রচনা (ফাইল তালিকা)
</h3> <span class="text-xs font-sans text-paper-muted">ক্লিক করে এডিট বা প্রিভিউ দেখুন</span> </div> <div id="file-list-container" class="space-y-2 max-h-[500px] overflow-y-auto pr-1">
          {posts.map((post) => (
            <div
              class="file-row p-3 rounded-xl border border-paper-border/60 dark:border-night-border/60 hover:border-paper-accent/50 dark:hover:border-night-accent/50 hover:bg-paper-border/20 dark:hover:bg-night-border/20 transition-all flex items-center justify-between gap-3 text-xs"
              data-category={post.category}
              data-slug={post.slug}
            >
              <div class="space-y-0.5 flex-grow">
                <div class="font-serif font-semibold text-sm text-paper-text dark:text-night-text flex items-center gap-2">
                  <span>📄</span>
                  <span>{post.title}</span>
                </div>
                <div class="text-[11px] font-sans text-paper-muted dark:text-night-muted flex items-center gap-2 flex-wrap">
                  <span>তারিখ: {post.publishedAt}</span>
                  <span>·</span>
                  <span>শব্দ: {post.body ? post.body.trim().split(/\s+/).length : 0}</span>
                  <span>·</span>
                  <span class="font-mono">{post.slug}.md</span>
                </div>
              </div>
              <div class="flex items-center gap-2">
                <a
                  href={`/${post.slug}`}
                  target="_blank"
                  class="px-2.5 py-1 rounded-md border border-paper-border dark:border-night-border hover:text-paper-accent text-[11px] font-sans transition-colors"
                >
                  পড়ুন ↗
                </a>
                <button
                  type="button"
                  class="load-in-writer-btn px-2.5 py-1 rounded-md bg-paper-accent/10 hover:bg-paper-accent text-paper-accent hover:text-white text-[11px] font-sans font-medium transition-colors cursor-pointer"
                  data-slug={post.slug}
                >
                  সম্পাদনা ✍️
                </button>
                <button
                  type="button"
                  class="delete-post-btn px-2.5 py-1 rounded-md border border-red-300 dark:border-red-900/50 bg-red-500/10 hover:bg-red-600 text-red-600 hover:text-white text-[11px] font-sans font-medium transition-colors cursor-pointer"
                  data-slug={post.slug}
                  title="স্থায়ীভাবে লেখাটি মুছে ফেলুন"
                >
                  🗑️ ডিলিট
                </button>
              </div>
            </div>
          ))}
        </div> </div> </div> </div> <!-- TAB 2: Split-View Live Writer's Desk --> <div id="tab-writer" class="admin-tab-content hidden space-y-4"> <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-start"> <!-- Left: Bengali Markdown Editor Form --> <div class="rounded-2xl border border-paper-border/80 dark:border-night-border/80 bg-paper-surface/95 dark:bg-night-surface/95 p-6 shadow-sm space-y-4 font-sans text-xs"> <div class="flex items-center justify-between border-b border-paper-border/60 pb-3"> <h3 class="font-serif font-bold text-base text-paper-text dark:text-night-text flex items-center gap-2"> <span>✍️</span> <span>রচনা সম্পাদক (Editor)</span> </h3> <span id="writer-word-counter" class="font-sans text-xs text-paper-muted">০ শব্দ · ০ মিনিট পাঠ</span> </div> <!-- Title Input --> <div class="space-y-1"> <label class="block font-semibold text-paper-text dark:text-night-text">শিরোনাম (Title):</label> <input id="editor-title" type="text" placeholder="লেখার সুন্দর বাংলা শিরোনাম লিখুন..." class="w-full px-3.5 py-2.5 rounded-xl border border-paper-border dark:border-night-border bg-paper-bg dark:bg-night-bg text-paper-text dark:text-night-text font-serif text-base focus:outline-none focus:border-paper-accent"> </div> <!-- Category & Date Grid --> <div class="grid grid-cols-1 sm:grid-cols-2 gap-3"> <div class="space-y-1"> <label class="block font-semibold text-paper-text dark:text-night-text">বিষয়শ্রেণী (Category):</label> <select id="editor-category" class="w-full px-3 py-2 rounded-xl border border-paper-border dark:border-night-border bg-paper-bg dark:bg-night-bg text-paper-text dark:text-night-text text-xs focus:outline-none focus:border-paper-accent font-serif"> <option value="chinta">চিন্তা</option><option value="pathalap">পাঠালাপ</option><option value="itihas">ইতিহাস</option><option value="boi-alochona">বই-আলোচনা</option><option value="onubad">অনুবাদ</option> </select> </div> <div class="space-y-1"> <label class="block font-semibold text-paper-text dark:text-night-text">প্রকাশের তারিখ:</label> <input id="editor-date" type="date" class="w-full px-3 py-2 rounded-xl border border-paper-border dark:border-night-border bg-paper-bg dark:bg-night-bg text-paper-text dark:text-night-text text-xs focus:outline-none focus:border-paper-accent"> </div> </div> <!-- Excerpt Description --> <div class="space-y-1"> <label class="block font-semibold text-paper-text dark:text-night-text">সংক্ষিপ্ত বিবরণ (Excerpt / Description):</label> <textarea id="editor-description" rows="2" placeholder="লেখাটির সংক্ষিপ্ত সারমর্ম লিখুন..." class="w-full px-3.5 py-2 rounded-xl border border-paper-border dark:border-night-border bg-paper-bg dark:bg-night-bg text-paper-text dark:text-night-text font-serif text-xs focus:outline-none focus:border-paper-accent leading-relaxed"></textarea> </div> <!-- Tags --> <div class="space-y-1"> <label class="block font-semibold text-paper-text dark:text-night-text">ট্যাগসমূহ (কমা দিয়ে আলাদা করুন):</label> <input id="editor-tags" type="text" placeholder="চিন্তা, পাঠাভ্যাস, বই" class="w-full px-3 py-2 rounded-xl border border-paper-border dark:border-night-border bg-paper-bg dark:bg-night-bg text-paper-text dark:text-night-text text-xs focus:outline-none focus:border-paper-accent font-sans"> </div> <!-- Markdown Toolbar --> <div class="flex items-center gap-1.5 flex-wrap pt-2 border-t border-paper-border/60"> <button type="button" class="md-tool-btn px-2 py-1 rounded bg-paper-border/50 hover:bg-paper-border font-bold" data-syntax="**" title="বোল্ড">B</button> <button type="button" class="md-tool-btn px-2 py-1 rounded bg-paper-border/50 hover:bg-paper-border italic" data-syntax="*" title="ইটালিক">I</button> <button type="button" class="md-tool-btn px-2 py-1 rounded bg-paper-border/50 hover:bg-paper-border" data-syntax="## " title="হেডিং ২">H2</button> <button type="button" class="md-tool-btn px-2 py-1 rounded bg-paper-border/50 hover:bg-paper-border" data-syntax="> " title="উদ্ধৃতি">Quote</button> <button type="button" class="md-tool-btn px-2 py-1 rounded bg-paper-border/50 hover:bg-paper-border" data-syntax="- " title="বুলেট তালিকা">• List</button> <span class="text-paper-border dark:text-night-border">|</span> <!-- Footnote Quick Insert Button --> <button id="toolbar-add-footnote-btn" type="button" class="px-2.5 py-1 rounded-lg bg-amber-500/20 hover:bg-amber-500/30 text-amber-800 dark:text-amber-300 font-bold border border-amber-500/40 text-xs flex items-center gap-1.5 cursor-pointer transition-all active:scale-95" title="কার্সরের স্থানে স্বয়ংক্রিয়ভাবে [১], [২] টীকা বসান"> <span>📚</span> <span>ফুটনোট যোগ করুন</span> </button> </div> <!-- Body Content Area --> <div class="space-y-1"> <label class="block font-semibold text-paper-text dark:text-night-text">মূল রচনা (Markdown Body):</label> <textarea id="editor-body" rows="12" placeholder="এখানে আপনার সম্পূর্ণ লেখাটি বাংলায় টাইপ বা পেস্ট করুন... ডানপাশে রিয়েল-টাইম প্রিভিউ ফুটে উঠবে।" class="w-full px-4 py-3 rounded-xl border border-paper-border dark:border-night-border bg-paper-bg dark:bg-night-bg text-paper-text dark:text-night-text font-serif text-sm focus:outline-none focus:border-paper-accent leading-relaxed"></textarea> </div> <!-- Footnotes Manager Box --> <div class="p-4 rounded-2xl bg-paper-border/20 dark:bg-night-border/25 border border-paper-border/60 dark:border-night-border/60 space-y-3 font-sans"> <div class="flex items-center justify-between"> <div class="flex items-center gap-2"> <span class="text-base">📚</span> <label class="font-semibold text-paper-text dark:text-night-text text-xs">
তথ্যসূত্র ও টীকার তালিকা (Footnotes Manager):
</label> </div> <button id="add-footnote-row-btn" type="button" class="px-2.5 py-1 rounded-lg bg-paper-accent dark:bg-night-accent text-white text-[11px] font-semibold hover:opacity-90 flex items-center gap-1 cursor-pointer shadow-2xs"> <span>➕ নতুন টীকা</span> </button> </div> <p class="text-[11px] text-paper-muted dark:text-night-muted leading-relaxed">
টিপস: উপরের টুলবারের <strong>[📚 ফুটনোট যোগ করুন]</strong> বাটনে চাপ দিলে লেখার মাঝে স্বয়ংক্রিয়ভাবে [১], [২] বসে যাবে। নিচে সেই নম্বরের বিপরীতে টীকার বিস্তারিত ব্যাখ্যা লিখুন।
