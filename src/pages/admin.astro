      async function loadInteractionsData() {
        try {
          const res = await fetch('/api/interactions?admin=true&_t=' + Date.now());
          const json = await res.json();
          if (json && json.success && json.data) {
            currentInteractionsData = json.data;
            renderAdminInteractions();
          }
        } catch (e) {
          console.error('[Admin] Interactions load error:', e);
        }
