বা কেন উইশলিস্টে রাখছেন..." class="w-full px-3.5 py-2.5 rounded-xl border border-paper-border dark:border-night-border bg-paper-surface dark:bg-night-surface text-paper-text dark:text-night-text text-xs font-sans"> <button id="add-wish-book-btn" type="button" class="px-5 py-2.5 rounded-xl bg-paper-accent dark:bg-night-accent text-white font-sans text-xs font-semibold hover:opacity-95 shadow-xs cursor-pointer flex items-center gap-1.5"> <span>➕</span> <span>উইশলিস্টে যুক্ত করুন</span> </button> </div> <!-- Live Preview of Current Books in Admin --> <div class="space-y-4"> <div class="flex items-center justify-between pb-2 border-b border-paper-border/60"> <h4 class="font-bold font-serif text-sm text-paper-text dark:text-night-text">
📋 বর্তমান বুকশেলফ তালিকা (সরাসরি ম্যানেজ করুন):
</h4> <a href="/bookshelf" target="_blank" class="text-xs font-sans text-paper-accent hover:underline">
আসল বুকশেলফ পেজ দেখুন ↗
</a> </div> <div id="admin-books-list" class="space-y-3 font-sans text-xs"> <!-- Rendered dynamically by script --> </div> <!-- Backend Persistence & Export Tools --> <div class="pt-6 border-t border-paper-border/60 dark:border-night-border/60 flex flex-wrap items-center justify-between gap-3 font-sans text-xs"> <div> <span class="font-bold text-paper-text dark:text-night-text block">💾 ব্যাকএন্ড ডেটা সিঙ্ক ও এক্সপোর্ট:</span> <span class="text-[11px] text-paper-muted dark:text-night-muted">আপনার পরিবর্তনগুলো স্বয়ংক্রিয়ভাবে লাইভ বুকশেলফে কার্যকর হয়েছে। সোর্স কোডে পারসিস্ট করতে JSON ডাউনলোড করুন।</span> </div> <div class="flex items-center gap-2 flex-wrap"> <button id="export-bookshelf-json-btn" type="button" class="px-3.5 py-2 rounded-xl bg-paper-accent dark:bg-night-accent text-white font-semibold hover:opacity-90 cursor-pointer flex items-center gap-1.5 shadow-xs" title="বর্তমান সব বইয়ের তালিকা JSON ফাইল আকারে নামিয়ে নিন"> <span>📥</span> <span>bookshelf.json ডাউনলোড</span> </button> <button id="copy-bookshelf-json-btn" type="button" class="px-3.5 py-2 rounded-xl border border-paper-border dark:border-night-border bg-paper-surface dark:bg-night-surface hover:border-paper-accent cursor-pointer flex items-center gap-1.5"> <span>📋</span> <span id="copy-bookshelf-text">JSON কোড কপি</span> </button> <button id="reset-bookshelf-btn" type="button" class="px-3 py-2 rounded-xl text-red-600 hover:bg-red-50 dark:hover:bg-red-950/30 border border-red-200 dark:border-red-900 cursor-pointer" title="ডিফল্ট ডেটায় ফিরে যান">
🔄 রিসেট
</button> </div> </div> </div> </div> </div> </div>

  <script is:inline define:vars={{ serializedPosts: posts, author, initialBookshelf: defaultBookshelf }}>


    (() => {
      const pinScreen = document.getElementById('pin-screen');
      const studioScreen = document.getElementById('studio-screen');
      const pinInput = document.getElementById('pin-input');
      const pinSubmitBtn = document.getElementById('pin-submit-btn');
      const pinError = document.getElementById('pin-error');
      const logoutBtn = document.getElementById('logout-btn');

      // Check existing PIN in localStorage or default '1234'
      function getStoredPin() {
        return localStorage.getItem('kherokhata_admin_pin') || '1234';
      }

      function checkAuth() {
        const isAuth = sessionStorage.getItem('kherokhata_admin_auth') === 'true';
        if (isAuth) {
          pinScreen?.classList.add('hidden');
          studioScreen?.classList.remove('hidden');
        } else {
          pinScreen?.classList.remove('hidden');
          studioScreen?.classList.add('hidden');
        }
      }

      function attemptLogin() {
        const val = pinInput?.value.trim();
        if (val === getStoredPin()) {
          sessionStorage.setItem('kherokhata_admin_auth', 'true');
          pinError?.classList.add('hidden');
          checkAuth();
        } else {
          pinError?.classList.remove('hidden');
          pinInput?.classList.add('border-red-500');
          setTimeout(() => {
            pinInput?.classList.remove('border-red-500');
          }, 1500);
        }
      }

      pinSubmitBtn?.addEventListener('click', attemptLogin);
      pinInput?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') attemptLogin();
      });

      logoutBtn?.addEventListener('click', () => {
        sessionStorage.removeItem('kherokhata_admin_auth');
        checkAuth();
      });

      checkAuth();

      // Tab Switching
      const tabBtns = document.querySelectorAll('.admin-tab-btn');
      const tabContents = document.querySelectorAll('.admin-tab-content');

      tabBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const target = btn.getAttribute('data-tab');
          tabBtns.forEach((b) => {
            b.classList.remove('bg-paper-accent', 'text-white', 'shadow-2xs');
            b.classList.add('border', 'border-paper-border', 'dark:border-night-border', 'bg-paper-surface/60', 'text-paper-muted');
          });
          btn.classList.add('bg-paper-accent', 'text-white', 'shadow-2xs');
          btn.classList.remove('border', 'border-paper-border', 'bg-paper-surface/60', 'text-paper-muted');

          tabContents.forEach((c) => {
            c.classList.toggle('hidden', c.id !== target);
          });
        });
      });

      // Explorer Category Filtering
      const folderBtns = document.querySelectorAll('.folder-item');
      const fileRows = document.querySelectorAll('.file-row');
      const folderTitle = document.getElementById('current-folder-title');

      folderBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const cat = btn.getAttribute('data-cat');
          folderBtns.forEach((b) => {
            b.classList.remove('bg-paper-accent/15', 'dark:bg-night-accent/20', 'text-paper-accent', 'dark:text-night-accent', 'font-semibold');
          });
          btn.classList.add('bg-paper-accent/15', 'dark:bg-night-accent/20', 'text-paper-accent', 'dark:text-night-accent', 'font-semibold');

          fileRows.forEach((row) => {
            const rowCat = row.getAttribute('data-category');
            if (cat === 'all' || rowCat === cat) {
              row.classList.remove('hidden');
            } else {
              row.classList.add('hidden');
            }
          });

          if (folderTitle) {
            folderTitle.innerText = `📁 ${btn.querySelector('span:last-child')?.innerText || 'ফাইল তালিকা'}`;
          }
        });
      });

      // Quick new post button opens writer tab
      document.getElementById('quick-new-post-btn')?.addEventListener('click', () => {
        document.getElementById('tab-btn-writer')?.click();
      });

      // Split-view Real-Time Live Preview Logic
      const editorTitle = document.getElementById('editor-title');
      const editorCat = document.getElementById('editor-category');
      const editorDesc = document.getElementById('editor-description');
      const editorBody = document.getElementById('editor-body');
      const editorDate = document.getElementById('editor-date');
      const editorTags = document.getElementById('editor-tags');

      const prevTitle = document.getElementById('preview-title');
      const prevCat = document.getElementById('preview-category-badge');
      const prevDesc = document.getElementById('preview-description');
      const prevBody = document.getElementById('preview-body');
      const prevWordCount = document.getElementById('writer-word-counter');
      const prevReadingTime = document.getElementById('preview-reading-time');
      const prevFootnotesSection = document.getElementById('preview-footnotes-section');
      const prevFootnotesList = document.getElementById('preview-footnotes-list');

      // Markdown Toolbar Syntax Insertion
      document.querySelectorAll('.md-tool-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          if (!editorBody) return;
          const syntax = btn.getAttribute('data-syntax');
          const start = editorBody.selectionStart;
          const end = editorBody.selectionEnd;
          const val = editorBody.value;
          const selected = val.substring(start, end);
          let replacement = '';
          if (syntax === '**' || syntax === '*') {
            replacement = `${syntax}${selected || 'শব্দ'}${syntax}`;
          } else {
            replacement = `${syntax}${selected}`;
          }
          editorBody.setRangeText(replacement, start, end, 'end');
          editorBody.focus();
          updateLivePreview();
        });
      });

      // Footnotes Management in Writer's Desk
      let writerFootnotes = [];
      const bnDigits = ['০', '১', '২', '৩', '৪', '৫', '৬', '৭', '৮', '৯'];
      function toBnNum(n) {
        return String(n).replace(/\d/g, (d) => bnDigits[d]);
      }

      const footnotesListContainer = document.getElementById('writer-footnotes-list');
      const addFootnoteRowBtn = document.getElementById('add-footnote-row-btn');
      const addFootnoteToolbarBtn = document.getElementById('toolbar-add-footnote-btn');

      function renderFootnotesEditor() {
        if (!footnotesListContainer) return;
        footnotesListContainer.innerHTML = '';
        if (writerFootnotes.length === 0) {
          footnotesListContainer.innerHTML = '<p class="text-xs text-paper-muted italic py-1">এখনো কোনো টীকা যোগ করা হয়নি। টুলবারের [📚 ফুটনোট যোগ করুন] বাটনে চাপ দিন।</p>';
          return;
        }

        writerFootnotes.forEach((fn) => {
          const row = document.createElement('div');
          row.className = 'flex items-center gap-2 p-2 rounded-xl bg-paper-surface/90 dark:bg-night-surface/90 border border-paper-border/60 dark:border-night-border/60 text-xs';
          row.innerHTML = `
            <span class="px-2.5 py-1 rounded-lg bg-amber-500/20 text-amber-700 dark:text-amber-300 font-bold font-mono text-xs shrink-0">[${toBnNum(fn.id)}]</span>
            <input
              type="text"
              class="fn-text-input flex-grow px-3 py-1.5 rounded-lg border border-paper-border dark:border-night-border bg-paper-bg dark:bg-night-bg text-paper-text dark:text-night-text text-xs font-serif"
              placeholder="টীকা ${toBnNum(fn.id)}-এর তথ্যসূত্র বা সারসংক্ষেপ লিখুন..."
              value="${fn.text ? fn.text.replace(/"/g, '&quot;') : ''}"
              data-id="${fn.id}"
            />
            <button
              type="button"
              class="fn-remove-btn w-7 h-7 rounded-lg text-red-500 hover:bg-red-500/10 flex items-center justify-center shrink-0 cursor-pointer"
              data-id="${fn.id}"
              title="মুছুন"
            >✕</button>
          `;
          footnotesListContainer.appendChild(row);
        });

        // Attach input listeners
        footnotesListContainer.querySelectorAll('.fn-text-input').forEach((input) => {
          input.addEventListener('input', (e) => {
            const id = Number(e.target.getAttribute('data-id'));
            const item = writerFootnotes.find((f) => f.id === id);
            if (item) item.text = e.target.value.trim();
            updateLivePreview();
          });
        });

        // Attach remove listeners
        footnotesListContainer.querySelectorAll('.fn-remove-btn').forEach((btn) => {
          btn.addEventListener('click', () => {
            const id = Number(btn.getAttribute('data-id'));
            writerFootnotes = writerFootnotes.filter((f) => f.id !== id);
            renderFootnotesEditor();
            updateLivePreview();
          });
        });
      }

      function insertFootnoteAtCursor() {
        if (!editorBody) return;
        const nextId = writerFootnotes.length + 1;
        const bnMarker = `[${toBnNum(nextId)}]`;
        const start = editorBody.selectionStart;
        const end = editorBody.selectionEnd;
        editorBody.setRangeText(bnMarker, start, end, 'end');
        editorBody.focus();

        writerFootnotes.push({ id: nextId, text: '' });
        renderFootnotesEditor();
        updateLivePreview();

        setTimeout(() => {
          const lastInput = footnotesListContainer?.querySelector(`input[data-id="${nextId}"]`);
          lastInput?.focus();
        }, 100);
      }

      addFootnoteToolbarBtn?.addEventListener('click', insertFootnoteAtCursor);
      addFootnoteRowBtn?.addEventListener('click', () => {
        const nextId = writerFootnotes.length + 1;
        writerFootnotes.push({ id: nextId, text: '' });
        renderFootnotesEditor();
        updateLivePreview();
      });

      renderFootnotesEditor();

      // Set default today's date
      if (editorDate) {
        editorDate.value = new Date().toISOString().split('T')[0];
      }

      function updateLivePreview() {
        const titleVal = editorTitle?.value.trim() || 'শিরোনাম এখানে দৃশ্যমান হবে';
        const catVal = editorCat?.options[editorCat.selectedIndex]?.text || 'চিন্তা';
        const descVal = editorDesc?.value.trim() || 'সংক্ষিপ্ত বিবরণী এখানে প্রদর্শিত হবে...';
        const bodyVal = editorBody?.value || 'আপনার লেখা শুরু করুন, এখানে আসল পত্রিকার মতো ফুটে উঠবে।';

        if (prevTitle) prevTitle.innerText = titleVal;
        if (prevCat) prevCat.innerText = catVal;
        if (prevDesc) prevDesc.innerText = descVal;

        // Word count & reading time
        const words = bodyVal.trim() ? bodyVal.trim().split(/\s+/).length : 0;
        const readMins = Math.max(1, Math.ceil(words / 180));
        if (prevWordCount) prevWordCount.innerText = `${words} শব্দ · ${readMins} মিনিট পাঠ`;
        if (prevReadingTime) prevReadingTime.innerText = `${readMins} মিনিট পাঠ`;

        // Simple Markdown parsing for preview
        if (prevBody) {
          let html = bodyVal
            .replace(/### (.*$)/gim, '<h3 class="text-lg font-bold font-serif my-2">$1</h3>')
            .replace(/## (.*$)/gim, '<h2 class="text-xl font-bold font-serif my-3">$1</h2>')
            .replace(/# (.*$)/gim, '<h1 class="text-2xl font-bold font-serif my-4">$1</h1>')
            .replace(/\*\*(.*)\*\*/gim, '<strong>$1</strong>')
            .replace(/\*(.*)\*/gim, '<em>$1</em>')
            .replace(/^> (.*$)/gim, '<blockquote class="border-l-4 border-paper-accent/60 pl-3 my-2 italic">$1</blockquote>')
            .replace(/\n\n/gim, '</p><p class="my-3">');

          // Highlight footnotes in preview
          html = html.replace(/\[([১-৯\d]+)\]/g, '<sup class="px-1 py-0.5 rounded bg-amber-500/20 text-paper-accent dark:text-night-accent font-bold cursor-pointer hover:underline text-[11px]">[$1]</sup>');

          prevBody.innerHTML = `<p class="my-3">${html}</p>`;
        }

        // Render preview footnotes list
        if (prevFootnotesSection && prevFootnotesList) {
          if (writerFootnotes.length > 0) {
            prevFootnotesSection.classList.remove('hidden');
            prevFootnotesList.innerHTML = writerFootnotes.map((f) => `
              <li class="leading-relaxed">
                <span class="text-paper-text dark:text-night-text font-serif">${f.text || '<em>(টীকার বিবরণ লেখা হয়নি)</em>'}</span>
              </li>
            `).join('');
          } else {
            prevFootnotesSection.classList.add('hidden');
            prevFootnotesList.innerHTML = '';
          }
        }
      }

      [editorTitle, editorCat, editorDesc, editorBody].forEach((el) => {
        el?.addEventListener('input', updateLivePreview);
      });

      // Load post into writer
      document.querySelectorAll('.load-in-writer-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const slug = btn.getAttribute('data-slug');
          const post = serializedPosts.find((p) => p.slug === slug);
          if (!post) return;

          if (editorTitle) editorTitle.value = post.title;
          if (editorCat) editorCat.value = post.category;
          if (editorDesc) editorDesc.value = post.description;
          if (editorBody) editorBody.value = post.body;
          if (editorTags) editorTags.value = post.tags.join(', ');

          writerFootnotes = post.footnotes ? JSON.parse(JSON.stringify(post.footnotes)) : [];
          renderFootnotesEditor();

          updateLivePreview();
          document.getElementById('tab-btn-writer')?.click();
        });
      });

      // Download Markdown file (.md)
      document.getElementById('download-md-btn')?.addEventListener('click', () => {
        const title = editorTitle?.value.trim() || 'untitled';
        const category = editorCat?.value || 'chinta';
        const date = editorDate?.value || new Date().toISOString().split('T')[0];
        const desc = editorDesc?.value.trim() || '';
        const tags = (editorTags?.value || '').split(',').map((t) => t.trim()).filter(Boolean);
        const body = editorBody?.value || '';

        let footnotesYaml = '';
        if (writerFootnotes && writerFootnotes.length > 0) {
          footnotesYaml = `footnotes:\n` + writerFootnotes.map((f) => `  - id: ${f.id}\n    text: "${(f.text || '').replace(/"/g, '\\"')}"`).join('\n') + '\n';
        }

        const mdContent = `---
title: "${title}"
description: "${desc}"
publishedAt: "${date}"
category: "${category}"
tags: [${tags.map((t) => `"${t}"`).join(', ')}]
${footnotesYaml}---

${body}
`;

        const blob = new Blob([mdContent], { type: 'text/markdown;charset=utf-8' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
