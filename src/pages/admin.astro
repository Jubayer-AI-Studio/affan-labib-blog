---
// src/pages/admin.astro
// Standalone, Jitter-Free Author Studio for Affan Labib
import AdminLayout from '../layouts/AdminLayout.astro';
import { getAllPostsAsync, getCategoriesAsync, getAuthorAsync, getAdminPinAsync, getBookshelfAsync } from '../lib/db';
// dynamic bookshelf loaded via getBookshelfAsync

export const prerender = false;

import { getAllInteractionsForAdmin, toBnDigits } from '../lib/interactions';

const [posts, categories, author, interactions, defaultBookshelf, currentAdminPin] = await Promise.all([
  getAllPostsAsync(),
  getCategoriesAsync(),
  getAuthorAsync(),
  getAllInteractionsForAdmin(),
  getBookshelfAsync(),
  getAdminPinAsync()
]);

let ssrTotalViews = 0;
let ssrTotalLikes = 0;
const ssrComments = interactions.comments || [];
Object.values(interactions.stats || {}).forEach((s) => {
  ssrTotalViews += (s.views || 0);
  ssrTotalLikes += (s.likes || 0);
});
const ssrTotalViewsBn = toBnDigits(ssrTotalViews);
const ssrTotalLikesBn = toBnDigits(ssrTotalLikes);
const ssrTotalCommentsBn = toBnDigits(ssrComments.length);
---

<AdminLayout
  title="লেখক স্টুডিও | আফফান লাবীব"
  description="আফফান লাবীবের নিভৃত লেখক স্টুডিও ও কন্টেন্ট ড্যাশবোর্ড।"
>
  <!-- 1. Universal PIN Lock Screen (Client Protection) -->
  <div
    id="pin-screen"
    class="max-w-md mx-auto my-14 p-7 sm:p-9 rounded-3xl border border-paper-border/90 dark:border-night-border/90 bg-paper-surface/90 dark:bg-night-surface/90 backdrop-blur-2xl shadow-xl text-center space-y-6"
  >
    <div class="relative w-20 h-20 mx-auto rounded-3xl bg-gradient-to-tr from-amber-500/20 via-paper-accent/20 to-purple-500/20 flex items-center justify-center text-3xl shadow-inner border border-amber-500/30">
      <span>🔐</span>
    </div>

    <div class="space-y-2">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-sans font-semibold bg-rose-500/10 text-rose-700 dark:text-rose-400 border border-rose-500/20">
        <span>🛡️</span>
        <span>ব্যক্তিগত সংরক্ষিত এলাকা</span>
      </span>
      <h1 class="text-2xl sm:text-3xl font-bold font-serif text-paper-text dark:text-night-text tracking-tight">
        লেখক স্টুডিও প্রবেশদ্বার
      </h1>
      <p class="text-xs sm:text-sm text-paper-muted dark:text-night-muted font-serif leading-relaxed">
        এটি লেখক আফফান লাবীবের নিভৃত রচনাগার। স্টুডিওতে প্রবেশ করতে আপনার গোপন পিন কোড প্রদান করুন।
      </p>
    </div>

    <div class="space-y-4 pt-2">
      <div class="relative">
        <input
          id="pin-input"
          type="password"
          maxlength="12"
          placeholder="••••••"
          autocomplete="off"
          class="w-full text-center text-3xl tracking-[0.4em] font-mono py-3.5 px-4 rounded-2xl border border-paper-border dark:border-night-border bg-paper-bg dark:bg-night-bg text-paper-text dark:text-night-text focus:outline-none focus:ring-2 focus:ring-paper-accent"
        />
      </div>

      <p id="pin-error" class="hidden text-xs text-rose-600 font-sans font-semibold bg-rose-500/10 py-2 px-3 rounded-xl border border-rose-500/20">
        ❌ পিন কোডটি সঠিক নয়! শুধুমাত্র লেখকের নির্ধারিত পিন কোড দিয়েই খোলা যাবে।
      </p>

      <button
        id="pin-submit-btn"
        type="button"
        class="w-full py-3.5 rounded-2xl bg-paper-accent text-white font-sans text-sm font-semibold hover:opacity-95 shadow-md active:scale-98 transition-all cursor-pointer flex items-center justify-center gap-2"
      >
        <span>🔓</span>
        <span>স্টুডিও আনলক করুন</span>
      </button>

      <div class="pt-2">
        <a href="/" class="text-xs font-sans text-paper-muted hover:text-paper-accent transition-colors">
          ← প্রধান ব্লগে ফিরে যান
        </a>
      </div>
    </div>
  </div>

  <!-- 2. Main Author Studio Workspace (Protected) -->
  <div id="studio-screen" class="hidden space-y-6">
    <!-- Top Luxe Header Bar -->
    <header class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 p-5 rounded-3xl border border-paper-border/80 dark:border-night-border/80 bg-paper-surface/90 dark:bg-night-surface/90 backdrop-blur-xl shadow-xs">
      <div class="flex items-center gap-3.5">
        <img
          src="/images/affan-labib.jpg"
          alt="আফফান লাবীব"
          class="author-avatar-img w-11 h-11 rounded-2xl object-cover ring-2 ring-paper-accent/30 shadow-xs"
        />
        <div>
          <div class="flex items-center gap-2 flex-wrap">
            <h2 class="text-lg font-bold font-serif text-paper-text dark:text-night-text author-name-text">
              {author.name} — লেখক স্টুডিও
            </h2>
            <span id="admin-connection-badge" class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-sans font-medium bg-emerald-500/15 text-emerald-700 dark:text-emerald-400 border border-emerald-500/30">
              <span id="admin-connection-dot" class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
              <span id="admin-connection-status-text">স্টুডিও সক্রিয়</span>
            </span>

          </div>
          <p class="text-xs text-paper-muted dark:text-night-muted font-sans mt-0.5">
            নিভৃত সাহিত্য রচনাগার, ফোল্ডার এক্সপ্লোরার ও লাইভ রাইটার্স ডেস্ক
          </p>
        </div>
      </div>

      <div class="flex items-center gap-2 self-end sm:self-center">
        <!-- Theme Toggle -->
        <button
          id="admin-theme-toggle-btn"
          type="button"
          class="p-2 rounded-xl border border-paper-border dark:border-night-border hover:bg-paper-border/30 text-xs font-sans transition-colors cursor-pointer"
          title="রিডিং মোড (দিন / সেপিয়া / রাত)"
        >
          <span id="admin-theme-icon">☀️</span>
        </button>

        <a
          href="/"
          target="_blank"
          class="px-3.5 py-2 rounded-xl border border-paper-border dark:border-night-border hover:bg-paper-border/40 text-xs font-sans font-medium transition-colors flex items-center gap-1.5"
        >
          <span>আসল ব্লগে যান</span>
          <span>↗</span>
        </a>



        <button
          id="admin-lock-btn"
          type="button"
          class="px-3.5 py-2 rounded-xl bg-rose-500/10 hover:bg-rose-500/20 text-rose-600 dark:text-rose-400 border border-rose-500/30 text-xs font-sans font-medium transition-colors cursor-pointer flex items-center gap-1.5"
          title="লেখক স্টুডিও লক করুন"
        >
          <span>🔒</span>
          <span>লক করুন</span>
        </button>
      </div>
    </header>

    <!-- Navigation Tabs -->
    <nav class="flex items-center gap-2 overflow-x-auto pb-2 border-b border-paper-border/80 dark:border-night-border/80 text-xs font-sans no-scrollbar">
      <button
        id="tab-btn-explorer"
        type="button"
        class="admin-tab-btn px-4 py-2.5 rounded-2xl font-medium transition-all bg-paper-accent text-white shadow-xs cursor-pointer whitespace-nowrap"
        data-tab="tab-explorer"
      >
        📑 সকল রচনা
      </button>
      <button
        id="tab-btn-writer"
        type="button"
        class="admin-tab-btn px-4 py-2.5 rounded-2xl font-medium transition-all border border-paper-border dark:border-night-border bg-paper-surface/60 dark:bg-night-surface/60 text-paper-muted dark:text-night-muted hover:text-paper-text cursor-pointer whitespace-nowrap"
        data-tab="tab-writer"
      >
        ✍️ নতুন রচনা লিখুন
      </button>
      <button
        id="tab-btn-menu"
        type="button"
        class="admin-tab-btn px-4 py-2.5 rounded-2xl font-medium transition-all border border-paper-border dark:border-night-border bg-paper-surface/60 dark:bg-night-surface/60 text-paper-muted dark:text-night-muted hover:text-paper-text cursor-pointer whitespace-nowrap"
        data-tab="tab-menu"
      >
        📁 বিষয়শ্রেণীসমূহ
      </button>
      <button
        id="tab-btn-bookshelf"
        type="button"
        class="admin-tab-btn px-4 py-2.5 rounded-2xl font-medium transition-all border border-paper-border dark:border-night-border bg-paper-surface/60 dark:bg-night-surface/60 text-paper-muted dark:text-night-muted hover:text-paper-text cursor-pointer whitespace-nowrap"
        data-tab="tab-bookshelf"
      >
        📚 সম্প্রতি পঠিত বই
      </button>
      <button
        id="tab-btn-profile"
        type="button"
        class="admin-tab-btn px-4 py-2.5 rounded-2xl font-medium transition-all border border-paper-border dark:border-night-border bg-paper-surface/60 dark:bg-night-surface/60 text-paper-muted dark:text-night-muted hover:text-paper-text cursor-pointer whitespace-nowrap"
        data-tab="tab-profile"
      >
        👤 লেখক পরিচিতি
      </button>
      <button
        id="tab-btn-interactions"
        type="button"
        class="admin-tab-btn px-4 py-2.5 rounded-2xl font-medium transition-all border border-paper-border dark:border-night-border bg-paper-surface/60 dark:bg-night-surface/60 text-paper-muted dark:text-night-muted hover:text-paper-text cursor-pointer whitespace-nowrap"
        data-tab="tab-interactions"
      >
        💬 পাঠক প্রতিক্রিয়া
      </button>
      <button
        id="tab-btn-settings"
        type="button"
        class="admin-tab-btn px-4 py-2.5 rounded-2xl font-medium transition-all border border-paper-border dark:border-night-border bg-paper-surface/60 dark:bg-night-surface/60 text-paper-muted dark:text-night-muted hover:text-paper-text cursor-pointer whitespace-nowrap"
        data-tab="tab-settings"
      >
        🔒 পিন ও লক সেটিংস
      </button>
    </nav>

    <!-- ======================================================== -->
    <!-- TAB 1: C: Drive Folder Explorer -->
    <!-- ======================================================== -->
    <section id="tab-explorer" class="admin-tab-content space-y-6">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-start">
        <!-- Left: Folder Tree -->
        <div class="md:col-span-4 rounded-3xl border border-paper-border/80 dark:border-night-border/80 bg-paper-surface/90 dark:bg-night-surface/90 p-5 space-y-4 font-mono text-xs shadow-xs">
          <div class="pb-3 border-b border-paper-border/60 dark:border-night-border/60 font-sans font-bold text-xs text-paper-text dark:text-night-text flex items-center justify-between">
            <span class="flex items-center gap-1.5">
              <span>💻</span>
              <span>লেখকের সংগ্রহশালা</span>
            </span>
            <span id="folder-total-files-badge" class="text-[11px] text-paper-muted font-mono">{posts.length}টি ফাইল</span>
          </div>

          <!-- Dynamic Folder Tree List -->
          <div id="folder-tree-list" class="space-y-1 font-sans">
            <button
              type="button"
              class="folder-item w-full text-left px-3.5 py-2.5 rounded-xl bg-paper-accent/15 dark:bg-night-accent/20 text-paper-accent dark:text-night-accent font-semibold flex items-center justify-between transition-colors cursor-pointer"
              data-cat="all"
            >
              <span class="flex items-center gap-2">
                <span>📁</span>
                <span>সকল রচনা</span>
              </span>
              <span class="text-[11px] opacity-80 folder-count-badge" data-count-cat="all">({posts.length})</span>
            </button>

            {categories.map((cat) => {
              const count = posts.filter((p) => p.category === cat.id).length;
              return (
                <button
                  type="button"
                  class="folder-item w-full text-left px-3.5 py-2.5 rounded-xl hover:bg-paper-border/40 dark:hover:bg-night-border/40 text-paper-text dark:text-night-text flex items-center justify-between transition-colors cursor-pointer"
                  data-cat={cat.id}
                >
                  <span class="flex items-center gap-2">
                    <span>{cat.icon || '📁'}</span>
                    <span>{cat.title}</span>
                  </span>
                  <span class="text-[11px] text-paper-muted opacity-80 folder-count-badge" data-count-cat={cat.id}>({count})</span>
                </button>
              );
            })}
          </div>

          <div class="pt-3 border-t border-paper-border/50 dark:border-night-border/50 space-y-2">
            <button
              id="quick-new-post-btn"
              type="button"
              class="w-full py-2.5 px-3 rounded-xl bg-paper-accent dark:bg-night-accent text-white font-sans text-xs font-semibold hover:opacity-95 transition-opacity flex items-center justify-center gap-1.5 shadow-xs cursor-pointer"
            >
              <span>➕</span>
              <span>নতুন লেখা লিখুন</span>
            </button>
            <button
              id="quick-new-folder-btn"
              type="button"
              class="w-full py-2 px-3 rounded-xl border border-paper-border dark:border-night-border hover:bg-paper-border/30 text-paper-text dark:text-night-text font-sans text-xs font-medium transition-colors flex items-center justify-center gap-1.5 cursor-pointer"
            >
              <span>📁</span>
              <span>নতুন ফোল্ডার খুলুন</span>
            </button>
          </div>
        </div>

        <!-- Right: File List View -->
        <div class="md:col-span-8 rounded-3xl border border-paper-border/80 dark:border-night-border/80 bg-paper-surface/90 dark:bg-night-surface/90 p-6 space-y-4 shadow-xs">
          <div class="flex items-center justify-between border-b border-paper-border/60 dark:border-night-border/60 pb-3 flex-wrap gap-2">
            <div>
              <h3 id="current-folder-title" class="font-serif font-bold text-base text-paper-text dark:text-night-text">
                📁 সকল রচনা (ফাইল তালিকা)
              </h3>
              <span class="text-xs font-sans text-paper-muted">যেকোনো লেখা পড়তে বা পরিবর্তন করতে ক্লিক করুন</span>
            </div>
            <div class="text-xs font-sans text-paper-muted">
              মোট <span id="current-folder-count" class="font-bold text-paper-accent dark:text-night-accent">{posts.length}</span> টি রচনা
            </div>
          </div>

          <!-- File Rows Container -->
          <div id="file-list-container" class="space-y-3 max-h-[600px] overflow-y-auto pr-1">
            {posts.map((post) => (
              <div
                class="file-row p-4 rounded-2xl border border-paper-border/70 dark:border-night-border/70 bg-paper-bg/40 dark:bg-night-bg/40 hover:border-paper-accent/50 dark:hover:border-night-accent/50 transition-all flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs"
                data-category={post.category}
                data-slug={post.slug}
              >
                <div class="space-y-1 min-w-0 flex-1">
                  <div class="font-serif font-bold text-sm sm:text-base text-paper-text dark:text-night-text flex items-center gap-2">
                    <span class="shrink-0 text-base">{post.pinned ? '📌' : '📄'}</span>
                    <span class="truncate block">{post.title}</span>
                    {post.pinned && (
                      <span class="px-2 py-0.5 rounded-full text-[10px] bg-amber-500/20 text-amber-800 dark:text-amber-300 font-sans shrink-0">পিনকৃত</span>
                    )}
                  </div>
                  <div class="text-[11px] font-sans text-paper-muted dark:text-night-muted flex items-center gap-2 flex-wrap">
                    <span class="px-2 py-0.5 rounded-md bg-paper-accent/10 text-paper-accent dark:text-night-accent font-medium">
                      {post.category}
                    </span>
                    <span>·</span>
                    <span>তারিখ: {post.publishedAt}</span>
                    <span>·</span>
                    <span>{post.body ? post.body.trim().split(/\s+/).length : 0} শব্দ</span>
                  </div>
                </div>

                <div class="flex items-center gap-2 shrink-0 pt-2 border-t border-paper-border/40 sm:border-t-0 sm:pt-0">
                  <button
                    type="button"
                    class="toggle-pin-btn px-3 py-2 rounded-xl border border-amber-500/40 bg-amber-500/10 hover:bg-amber-500/20 text-amber-800 dark:text-amber-300 text-xs font-sans font-medium transition-all cursor-pointer flex items-center justify-center gap-1"
                    data-slug={post.slug}
                    data-pinned={post.pinned ? 'true' : 'false'}
                    title={post.pinned ? 'পিন বাতিল করুন' : 'শীর্ষে পিন করুন'}
                  >
                    <span>{post.pinned ? '📌' : '📍'}</span>
                    <span class="pin-status-label">{post.pinned ? 'পিনকৃত' : 'পিন করুন'}</span>
                  </button>
                  <button
                    type="button"
                    class="load-in-writer-btn flex-1 sm:flex-initial px-3.5 py-2 rounded-xl bg-paper-accent text-white hover:opacity-95 text-xs font-sans font-semibold transition-all cursor-pointer shadow-2xs flex items-center justify-center gap-1.5"
                    data-slug={post.slug}
                  >
                    <span>✍️</span>
                    <span>সম্পাদনা</span>
                  </button>
                  <a
                    href={`/${post.slug}`}
                    target="_blank"
                    class="px-3 py-2 rounded-xl border border-paper-border dark:border-night-border hover:bg-paper-border/30 text-paper-text dark:text-night-text text-xs font-sans transition-colors flex items-center justify-center gap-1"
                  >
                    <span>পড়ুন</span>
                    <span>↗</span>
                  </a>
                  <button
                    type="button"
                    class="delete-post-btn px-3 py-2 rounded-xl border border-red-300 dark:border-red-800/60 bg-red-500/10 hover:bg-red-600 text-red-600 hover:text-white text-xs font-sans font-medium transition-all cursor-pointer flex items-center justify-center gap-1"
                    data-slug={post.slug}
                    title="স্থায়ীভাবে লেখাটি মুছে ফেলুন"
                  >
                    <span>🗑️</span>
                    <span>মুছুন</span>
                  </button>
                </div>
              </div>
            ))}
          </div>

          <div id="empty-folder-notice" class="hidden py-12 text-center text-paper-muted dark:text-night-muted font-serif">
            এই ফোল্ডারে কোনো রচনা পাওয়া যায়নি।
          </div>
        </div>
      </div>
    </section>

    <!-- ======================================================== -->
    <!-- TAB 2: Live Writer's Desk (Split-View) -->
    <!-- ======================================================== -->
    <section id="tab-writer" class="admin-tab-content hidden space-y-4">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-start">
        <!-- Left: Form -->
        <div class="rounded-3xl border border-paper-border/80 dark:border-night-border/80 bg-paper-surface/95 dark:bg-night-surface/95 p-6 shadow-xs space-y-4 font-sans text-xs">
          <div class="flex items-center justify-between border-b border-paper-border/60 pb-3">
            <h3 class="font-serif font-bold text-base text-paper-text dark:text-night-text flex items-center gap-2">
              <span>✍️</span>
              <span>রচনা সম্পাদক (Editor)</span>
            </h3>
            <span id="writer-word-counter" class="font-sans text-xs text-paper-muted">০ শব্দ · ০ মিনিট পাঠ</span>
          </div>

          <!-- Title Input -->
          <div class="space-y-1">
            <label class="block font-semibold text-paper-text dark:text-night-text">শিরোনাম (Title):</label>
            <input
              id="editor-title"
              type="text"
              placeholder="লেখার সুন্দর বাংলা শিরোনাম লিখুন..."
              class="w-full px-3.5 py-2.5 rounded-xl border border-paper-border dark:border-night-border bg-paper-bg dark:bg-night-bg text-paper-text dark:text-night-text font-serif text-base focus:outline-none focus:border-paper-accent"
            />
          </div>

          <!-- Category & Date Grid -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div class="space-y-1">
              <label class="block font-semibold text-paper-text dark:text-night-text">ফোল্ডার / বিভাগ (Category):</label>
              <select
                id="editor-category"
                class="w-full px-3 py-2.5 rounded-xl border border-paper-border dark:border-night-border bg-paper-bg dark:bg-night-bg text-paper-text dark:text-night-text text-xs focus:outline-none focus:border-paper-accent font-serif"
              >
                {categories.map((cat) => (
                  <option value={cat.id}>{cat.title}</option>
                ))}
              </select>
            </div>
            <div class="space-y-1">
              <label class="block font-semibold text-paper-text dark:text-night-text">প্রকাশের তারিখ:</label>
              <input
                id="editor-date"
                type="date"
                class="w-full px-3 py-2.5 rounded-xl border border-paper-border dark:border-night-border bg-paper-bg dark:bg-night-bg text-paper-text dark:text-night-text text-xs focus:outline-none focus:border-paper-accent"
              />
            </div>
          </div>

          <!-- Excerpt Description -->
          <div class="space-y-1">
            <label class="block font-semibold text-paper-text dark:text-night-text">সংক্ষিপ্ত বিবরণ (Excerpt):</label>
            <textarea
