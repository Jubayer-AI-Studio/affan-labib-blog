                    <span class="text-[11px] text-paper-muted font-sans">${escapeHtml(p.formattedDate || p.publishedAt)}</span>
                  </div>
                  <div class="flex items-center gap-2.5 font-serif text-xs shrink-0 select-none">
                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-lg bg-amber-500/10 text-amber-900 dark:text-amber-200 border border-amber-500/20" title="ভিউ">
                      <span>👁️</span>
                      <span class="font-bold">${toBn(st.views)}</span>
                    </span>
                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-lg bg-rose-500/10 text-rose-800 dark:text-rose-200 border border-rose-500/20" title="লাইক">
                      <span>❤️</span>
                      <span class="font-bold">${toBn(st.likes)}</span>
                    </span>
                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-lg bg-emerald-500/10 text-emerald-800 dark:text-emerald-200 border border-emerald-500/20" title="মন্তব্য">
                      <span>💬</span>
                      <span class="font-bold">${toBn(postComments)}</span>
                    </span>
                  </div>
                </div>
              `;
            }).join('');
          }
        }

        // Render Comments Moderation Feed
        if (adminCommentsFeedList) {
          if (comments.length === 0) {
            adminCommentsFeedList.innerHTML = `
              <div class="py-12 text-center rounded-2xl border border-dashed border-paper-border dark:border-night-border text-xs font-serif text-paper-muted">
                🍃 পাঠকদের কোনো মন্তব্য এখনো আসেনি।
