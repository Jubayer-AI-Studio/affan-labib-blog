              const safeId = String(c.id || '').trim() || ('cmt_gen_' + index);

              return `
                <div class="comment-card-item p-4 rounded-2xl border border-paper-border/80 dark:border-night-border/80 bg-paper-bg/60 dark:bg-night-bg/60 space-y-3 transition-all hover:border-paper-accent/30" data-comment-id="${safeId}" data-comment-content="${escapeHtml(c.content)}" data-slug="${c.slug}">
