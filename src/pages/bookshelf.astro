      const roomWish = document.getElementById('room-wish');
      const readContainer = document.getElementById('read-books-container');
      const wishContainer = document.getElementById('wish-books-container');
      const readCountBadge = document.getElementById('read-count-badge');
      const wishCountBadge = document.getElementById('wish-count-badge');

      function switchRoom(active) {
        if (active === 'wish') {
          roomRead?.classList.add('hidden');
          roomWish?.classList.remove('hidden');

          btnWish?.classList.remove('border', 'border-paper-border', 'dark:border-night-border', 'bg-paper-surface/60', 'text-paper-muted');
          btnWish?.classList.add('bg-paper-accent', 'text-white', 'shadow-xs');

          btnRead?.classList.remove('bg-paper-accent', 'text-white', 'shadow-xs');
          btnRead?.classList.add('border', 'border-paper-border', 'dark:border-night-border', 'bg-paper-surface/60', 'text-paper-muted');
        } else {
          roomWish?.classList.add('hidden');
          roomRead?.classList.remove('hidden');

          btnRead?.classList.remove('border', 'border-paper-border', 'dark:border-night-border', 'bg-paper-surface/60', 'text-paper-muted');
          btnRead?.classList.add('bg-paper-accent', 'text-white', 'shadow-xs');

          btnWish?.classList.remove('bg-paper-accent', 'text-white', 'shadow-xs');
          btnWish?.classList.add('border', 'border-paper-border', 'dark:border-night-border', 'bg-paper-surface/60', 'text-paper-muted');
        }
      }

      btnRead?.addEventListener('click', () => switchRoom('read'));
      btnWish?.addEventListener('click', () => switchRoom('wish'));

      function getBookshelfData() {
        const stored = localStorage.getItem('kherokhata_bookshelf_custom');
        if (stored) {
          try {
            return JSON.parse(stored);
          } catch (e) {}
        }
        const initialEl = document.getElementById('initial-bookshelf-data');
        if (initialEl) {
          try {
            return JSON.parse(initialEl.textContent);
          } catch (e) {}
        }
        return { readBooks: [], wishlistBooks: [] };
      }

      function saveBookshelfData(data) {
        localStorage.setItem('kherokhata_bookshelf_custom', JSON.stringify(data));
        window.dispatchEvent(new CustomEvent('kherokhata-bookshelf-sync'));
        syncAndRender();
      }

      function isAuthorLoggedIn() {
        return localStorage.getItem('kherokhata_admin_logged_in') === 'true';
      }

      window.quickDeleteBook = (type, id) => {
        if (!confirm('আপনি কি নিশ্চিত যে এই বইটি বুকশেলফ থেকে মুছে ফেলতে চান?')) return;
        const data = getBookshelfData();
        if (type === 'read') {
          data.readBooks = data.readBooks.filter((b, i) => (b.id ? b.id !== id : i.toString() !== id));
        } else if (type === 'wish') {
          data.wishlistBooks = data.wishlistBooks.filter((w, i) => (w.id ? w.id !== id : i.toString() !== id));
        }
        saveBookshelfData(data);
      };

      window.quickCompleteWish = (id) => {
        const data = getBookshelfData();
        const targetIndex = data.wishlistBooks.findIndex((w, i) => (w.id ? w.id === id : i.toString() === id));
        if (targetIndex !== -1) {
          const completed = data.wishlistBooks.splice(targetIndex, 1)[0];
          data.readBooks.unshift({
            id: 'read-' + Date.now(),
            title: completed.title,
            author: completed.author,
            readYear: new Date().getFullYear().toString(),
            review: completed.note || 'সম্প্রতি পড়া সমাপ্ত হয়েছে।',
            rating: 5,
            tag: 'নব্য সমাপ্ত কিতাব',
            coverBg: 'from-amber-950/40 via-neutral-900 to-orange-950/30'
          });
          saveBookshelfData(data);
          alert(`'${completed.title}' বইটি পড়া শেষ তালিকায় যুক্ত করা হয়েছে! ✓`);
        }
      };

      function renderReadBooks(books) {
        if (!readContainer) return;
        if (!books || books.length === 0) {
          readContainer.innerHTML = `
            <div class="col-span-full py-12 text-center rounded-3xl border border-dashed border-paper-border/80 dark:border-night-border/80 p-8 space-y-3 bg-paper-surface/50 dark:bg-night-surface/50">
              <span class="text-4xl block">📖</span>
              <h3 class="text-base font-bold font-serif text-paper-text dark:text-night-text">পঠিত কিতাবের তালিকা ফাঁকা</h3>
              <p class="text-xs text-paper-muted dark:text-night-muted font-sans">লেখক স্টুডিও থেকে নতুন পড়া বই যুক্ত করুন।</p>
            </div>
          `;
          return;
        }

        const authorMode = isAuthorLoggedIn();

        readContainer.innerHTML = books.map((book, idx) => {
          const bookId = book.id || 'read-' + idx;
          return `
            <article class="group relative rounded-3xl p-6 sm:p-7 border border-paper-border/80 dark:border-night-border/80 bg-paper-surface/80 dark:bg-night-surface/80 backdrop-blur-xl shadow-xs hover:shadow-xl transition-all duration-300 hover:-translate-y-1 flex flex-col justify-between space-y-4">
              <div class="space-y-3">
                <div class="flex items-start justify-between gap-3">
                  <span class="px-2.5 py-1 rounded-full text-[11px] font-sans font-medium bg-amber-500/10 text-amber-700 dark:text-amber-400 border border-amber-500/20">
                    ${escapeHtml(book.tag || 'পঠিত কিতাব')}
                  </span>
                  <div class="flex items-center gap-2">
                    <span class="text-xs font-mono text-paper-muted dark:text-night-muted flex items-center gap-1">
                      <span>📅</span> <span>${escapeHtml(book.readYear || '২০২৬')}</span>
                    </span>
                    ${authorMode ? `
                      <button
                        type="button"
                        onclick="window.quickDeleteBook && window.quickDeleteBook('read', '${bookId}')"
                        class="text-red-500 hover:text-red-700 text-xs px-2 py-0.5 rounded-lg bg-red-50 dark:bg-red-950/40 border border-red-200 dark:border-red-900 cursor-pointer ml-1 transition-colors"
                        title="এই বইটি তালিকা থেকে মুছে ফেলুন"
                      >
                        🗑️ মুছুন
                      </button>
                    ` : ''}
                  </div>
                </div>

                <div>
                  <h3 class="text-lg sm:text-xl font-bold font-serif text-paper-text dark:text-night-text group-hover:text-paper-accent dark:group-hover:text-night-accent transition-colors leading-snug">
                    ${escapeHtml(book.title)}
                  </h3>
                  <p class="text-xs font-sans text-paper-muted dark:text-night-muted mt-1">
                    লেখক: <span class="font-medium text-paper-text dark:text-night-text">${escapeHtml(book.author)}</span>
                  </p>
                </div>

                ${book.review ? `
                  <blockquote class="text-xs sm:text-sm font-serif italic text-paper-text/90 dark:text-night-text/90 leading-relaxed border-l-2 border-paper-accent/40 dark:border-night-accent/40 pl-3.5 py-1 bg-paper-bg/40 dark:bg-night-bg/40 rounded-r-lg">
                    "${escapeHtml(book.review)}"
                  </blockquote>
                ` : ''}
              </div>

              <div class="pt-3 border-t border-paper-border/50 dark:border-night-border/50 flex items-center justify-between text-xs font-sans">
                <div class="flex items-center gap-1 text-amber-500" title="রেটিং: ${book.rating}/৫">
                  <span>★</span>
                  <span class="font-mono font-bold text-paper-text dark:text-night-text">${book.rating}</span>
                  <span class="text-[10px] text-paper-muted">/ ৫</span>
                </div>
                <span class="text-[11px] text-paper-muted dark:text-night-muted">
                  আফফান লাবীবের নোট
                </span>
              </div>
            </article>
          `;
        }).join('');
      }

      function renderWishBooks(wishes) {
        if (!wishContainer) return;
        if (!wishes || wishes.length === 0) {
          wishContainer.innerHTML = `
            <div class="py-12 text-center rounded-3xl border border-dashed border-paper-border/80 dark:border-night-border/80 p-8 space-y-3 bg-paper-surface/50 dark:bg-night-surface/50">
              <span class="text-4xl block">🎯</span>
              <h3 class="text-base font-bold font-serif text-paper-text dark:text-night-text">উইশলিস্টে কোনো বই নেই</h3>
              <p class="text-xs text-paper-muted dark:text-night-muted font-sans">লেখক স্টুডিও থেকে পড়ার তালিকায় নতুন বই যুক্ত করুন।</p>
            </div>
          `;
          return;
        }

        const authorMode = isAuthorLoggedIn();

        wishContainer.innerHTML = wishes.map((item, idx) => {
          const wishId = item.id || 'wish-' + idx;
          const priorityClass =
            item.priority === 'উচ্চ'
              ? 'bg-rose-500/10 text-rose-600 dark:text-rose-400 border-rose-500/25'
              : item.priority === 'মাঝারি'
              ? 'bg-amber-500/10 text-amber-600 dark:text-amber-400 border-amber-500/25'
              : 'bg-blue-500/10 text-blue-600 dark:text-blue-400 border-blue-500/25';

          return `
            <div class="p-5 rounded-2xl border border-paper-border/80 dark:border-night-border/80 bg-paper-surface/80 dark:bg-night-surface/80 backdrop-blur-xl shadow-2xs hover:border-paper-accent/50 dark:hover:border-night-accent/50 transition-all flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
              <div class="flex items-start gap-3.5">
                <span class="w-6 h-6 rounded-full bg-paper-accent/15 dark:bg-night-accent/20 text-paper-accent dark:text-night-accent flex items-center justify-center text-xs font-mono font-bold mt-0.5 shrink-0">
                  ${idx + 1}
                </span>
                <div class="space-y-1">
                  <div class="flex items-center gap-2 flex-wrap">
                    <h3 class="text-base sm:text-lg font-bold font-serif text-paper-text dark:text-night-text">
                      ${escapeHtml(item.title)}
                    </h3>
                    <span class="text-[10px] font-sans font-semibold px-2 py-0.5 rounded-full border ${priorityClass}">
                      ${escapeHtml(item.priority || 'উচ্চ')} অগ্রাধিকার
                    </span>
                  </div>
                  <p class="text-xs font-sans text-paper-muted dark:text-night-muted">
                    লেখক: <span class="font-medium text-paper-text dark:text-night-text">${escapeHtml(item.author)}</span>
                  </p>
                  ${item.note ? `
                    <p class="text-xs font-serif text-paper-muted dark:text-night-muted italic pt-0.5">
                      "${escapeHtml(item.note)}"
                    </p>
                  ` : ''}
                </div>
              </div>

              <div class="shrink-0 sm:self-center flex items-center gap-2">
                ${authorMode ? `
                  <button
                    type="button"
                    onclick="window.quickCompleteWish && window.quickCompleteWish('${wishId}')"
                    class="inline-flex items-center gap-1 px-3 py-1.5 rounded-xl text-xs font-sans font-bold bg-emerald-500/15 text-emerald-700 dark:text-emerald-300 border border-emerald-500/30 hover:bg-emerald-500/25 cursor-pointer transition-colors"
                    title="পড়া শেষ হিসেবে পড়া বইয়ের ঘরে স্থানান্তর করুন"
                  >
                    <span>✓</span> <span>পড়া শেষ</span>
                  </button>
                  <button
                    type="button"
                    onclick="window.quickDeleteBook && window.quickDeleteBook('wish', '${wishId}')"
                    class="text-red-500 hover:text-red-700 text-xs px-2.5 py-1.5 rounded-xl bg-red-50 dark:bg-red-950/40 border border-red-200 dark:border-red-900 cursor-pointer transition-colors"
                    title="উইশলিস্ট থেকে মুছে ফেলুন"
                  >
                    🗑️
                  </button>
                ` : `
                  <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-sans bg-paper-bg dark:bg-night-bg border border-paper-border dark:border-night-border text-paper-muted dark:text-night-muted">
                    <span>⏳</span> <span>পড়ার অপেক্ষায়</span>
                  </span>
                `}
              </div>
            </div>
          `;
        }).join('');
      }

      function escapeHtml(str) {
        if (!str) return '';
        return String(str)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;');
      }

      function syncAndRender() {
        const data = getBookshelfData();
        if (readCountBadge) readCountBadge.innerText = data.readBooks ? data.readBooks.length : 0;
        if (wishCountBadge) wishCountBadge.innerText = data.wishlistBooks ? data.wishlistBooks.length : 0;

        // Render cards dynamically if localStorage has data or if author is logged in
        if (localStorage.getItem('kherokhata_bookshelf_custom') || isAuthorLoggedIn()) {
          renderReadBooks(data.readBooks);
          renderWishBooks(data.wishlistBooks);
        }
      }

      syncAndRender();
      window.addEventListener('kherokhata-bookshelf-sync', syncAndRender);
      window.addEventListener('storage', syncAndRender);
      window.addEventListener('load', syncAndRender);
    })();
  </script>
</Layout>
