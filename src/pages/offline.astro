---
// src/pages/offline.astro
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="অফলাইন মোড | আফফান লাবীব"
  description="আপনি বর্তমানে অফলাইনে আছেন। পূর্বে পঠিত লেখাগুলো পড়তে পারবেন।"
>
  <div class="max-w-xl mx-auto py-12 px-4 space-y-8">
    <div class="text-center space-y-4">
      <div class="w-16 h-16 mx-auto rounded-3xl bg-amber-500/15 text-amber-600 dark:text-amber-400 flex items-center justify-center text-3xl shadow-sm">
        📶
      </div>
      <div class="space-y-2">
        <h1 class="text-2xl font-bold font-serif text-paper-text dark:text-night-text">
          আপনি অফলাইনে রয়েছেন
        </h1>
        <p class="text-sm font-serif text-paper-muted dark:text-night-muted leading-relaxed">
          ইন্টারনেট সংযোগ সাময়িকভাবে বিচ্ছিন্ন থাকলেও আপনি পূর্বে ক্যাশকৃত সকল রচনা ও পাঠাগার সাবলীলভাবে পড়তে পারবেন।
        </p>
      </div>
      <div class="flex items-center justify-center gap-3 pt-2">
        <a
          href="/"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-paper-accent text-white font-sans text-xs font-semibold shadow-md hover:opacity-95 cursor-pointer"
        >
          <span>🏠</span>
          <span>প্রধান পাতায় যান</span>
        </a>
        <button
          onclick="window.location.reload()"
          type="button"
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl border border-paper-border dark:border-night-border hover:bg-paper-border/30 text-paper-text dark:text-night-text font-sans text-xs font-medium cursor-pointer"
        >
          <span>🔄</span>
          <span>সংযোগ পরীক্ষা করুন</span>
        </button>
      </div>
    </div>

    <!-- Dynamic Offline Posts List Container -->
    <div id="offline-available-section" class="hidden rounded-3xl border border-paper-border/80 dark:border-night-border/80 bg-paper-surface/90 dark:bg-night-surface/90 p-5 space-y-3">
      <h3 class="text-xs font-bold font-sans uppercase tracking-wider text-paper-accent dark:text-night-accent flex items-center gap-2">
        <span>📖</span>
        <span>ডিভাইসে সংরক্ষিত অফলাইন রচনাসমূহ:</span>
      </h3>
      <div id="offline-posts-list" class="space-y-2 font-serif text-sm"></div>
    </div>
  </div>

  <script is:inline>
    (() => {
      // Auto-reload as soon as internet is back
      window.addEventListener('online', () => {
        window.location.reload();
      });

      // Render any locally cached custom posts
      try {
        const custom = JSON.parse(localStorage.getItem('kherokhata_custom_posts') || '[]');
        const listEl = document.getElementById('offline-posts-list');
        const sectionEl = document.getElementById('offline-available-section');
        if (custom.length > 0 && listEl && sectionEl) {
          sectionEl.classList.remove('hidden');
          listEl.innerHTML = custom.map((p) => `
            <a href="/${p.slug}" class="block p-3 rounded-xl border border-paper-border/50 dark:border-night-border/50 hover:bg-paper-border/20 transition-colors">
              <div class="font-bold text-paper-text dark:text-night-text">${p.title}</div>
              <div class="text-xs text-paper-muted dark:text-night-muted font-sans mt-0.5">${p.formattedDate || p.publishedAt || ''}</div>
            </a>
          `).join('');
        }
      } catch (e) {}
    })();
  </script>
</Layout>
