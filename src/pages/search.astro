---
// src/pages/search.astro
import Layout from '../layouts/Layout.astro';
import { getAllPostsAsync, getCategoriesAsync } from '../lib/db';

export const prerender = false;

// Global Edge CDN cache with background revalidation (delivers in 30ms, revalidates instantly)
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=86400, stale-while-revalidate=604800');

const [posts, categories] = await Promise.all([
  getAllPostsAsync(),
  getCategoriesAsync()
]);

const catMap = new Map(categories.map((c) => [c.id, c.title]));

const searchablePosts = posts.map((p) => {
  return {
    title: p.title,
    slug: p.slug,
    description: p.description,
    category: p.category,
    categoryLabel: catMap.get(p.category) || p.category,
    tags: p.tags,
    publishedAt: p.publishedAt,
    formattedDate: p.formattedDate,
    body: p.body
  };
});
---

<Layout
  title="অনুসন্ধান | আফফান লাবীব"
  description="আফফান লাবীবের খেরোখাতায় যেকোনো বিষয়, শিরোনাম বা লেখার মধ্যকার শব্দ দ্রুত খুঁজে বের করুন।"
>
  <div class="max-w-3xl mx-auto space-y-8">
    <!-- Header -->
    <header class="space-y-2 pb-6 border-b border-paper-border/80 dark:border-night-border/80 text-center sm:text-left">
      <div class="inline-flex items-center gap-1.5 text-xs font-sans font-semibold text-paper-accent dark:text-night-accent uppercase tracking-wider mb-1">
        <a href="/" class="hover:underline">প্রধান পাতা</a>
        <span>/</span>
        <span>অনুসন্ধান</span>
      </div>
      <h1 class="text-3xl font-bold font-serif text-paper-text dark:text-night-text">
        পাঠাগারে অনুসন্ধান করুন
      </h1>
      <p class="text-sm font-serif text-paper-muted dark:text-night-muted">
        যেকোনো শিরোনাম, কিতাবের নাম, ট্যাগ অথবা লেখার ভেতরের মূল শব্দ লিখে খুঁজুন।
      </p>
    </header>

    <!-- Search Input Bar -->
    <div class="relative">
      <input
        id="search-input"
        type="search"
        placeholder="শব্দ বা বিষয়ের নাম লিখুন (যেমন: ফিলিস্তিন, ইতিহাস, বই)..."
        autofocus
        class="w-full py-4 pl-12 pr-4 rounded-2xl border border-paper-border dark:border-night-border bg-paper-surface/90 dark:bg-night-surface/90 text-paper-text dark:text-night-text text-base font-serif shadow-xs focus:outline-none focus:border-paper-accent dark:focus:border-night-accent transition-colors"
      />
      <div class="absolute left-4 top-1/2 -translate-y-1/2 text-paper-muted dark:text-night-muted text-lg pointer-events-none">
        🔍
      </div>
    </div>

    <!-- Results Status -->
    <div class="flex items-center justify-between text-xs font-sans text-paper-muted dark:text-night-muted">
      <span id="search-status">সকল রচনা প্রদর্শিত হচ্ছে</span>
      <span id="search-count" class="font-bold text-paper-accent dark:text-night-accent">{posts.length} টি</span>
    </div>

    <!-- Search Results Container -->
    <div id="search-results" class="space-y-4"></div>
  </div>
</Layout>

<script is:inline define:vars={{ searchablePosts }}>
  (() => {
    const deletedSlugs = (() => {
      try { return JSON.parse(localStorage.getItem('kherokhata_deleted_posts') || '[]'); } catch(e) { return []; }
    })();
    const activePosts = searchablePosts.filter((p) => !deletedSlugs.includes(p.slug));

    const input = document.getElementById('search-input');
    const container = document.getElementById('search-results');
    const statusEl = document.getElementById('search-status');
    const countEl = document.getElementById('search-count');

    const bnDigits = ['০', '১', '২', '৩', '৪', '৫', '৬', '৭', '৮', '৯'];
    function toBn(n) {
      return n.toString().replace(/[0-9]/g, (d) => bnDigits[parseInt(d, 10)]);
    }

    function escapeHtml(str) {
      return str
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;');
    }

    function highlightText(text, query) {
      if (!query) return escapeHtml(text);
      const safe = escapeHtml(text);
      const regex = new RegExp(`(${query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'gi');
      return safe.replace(regex, '<mark class="bg-amber-300 dark:bg-amber-500/30 text-paper-text dark:text-white px-0.5 rounded font-bold">$1</mark>');
    }

    function renderResults(list, q) {
      if (!container) return;
      container.innerHTML = '';

      if (statusEl && countEl) {
        if (!q) {
          statusEl.textContent = 'সকল রচনা প্রদর্শিত হচ্ছে';
        } else {
          statusEl.textContent = `"${q}" সংক্রান্ত ফলাফল`;
        }
        countEl.textContent = `${toBn(list.length)} টি`;
      }

      if (list.length === 0) {
        container.innerHTML = `
          <div class="py-12 text-center text-paper-muted dark:text-night-muted font-serif">
            <span class="text-3xl block mb-2">🍃</span>
            কোনো রচনায় মিল পাওয়া যায়নি। অন্য কোনো শব্দ দিয়ে চেষ্টা করুন।
          </div>
        `;
        return;
      }

      list.forEach((post) => {
        let snippet = '';
        if (q && post.body.toLowerCase().includes(q.toLowerCase())) {
          const idx = post.body.toLowerCase().indexOf(q.toLowerCase());
          const start = Math.max(0, idx - 40);
          const end = Math.min(post.body.length, idx + 80);
          snippet = (start > 0 ? '...' : '') + post.body.slice(start, end).trim() + (end < post.body.length ? '...' : '');
          snippet = highlightText(snippet, q);
        }

        const card = document.createElement('article');
        card.className = 'p-5 rounded-2xl border border-paper-border/80 dark:border-night-border/80 bg-paper-surface/75 dark:bg-night-surface/75 hover:border-paper-accent dark:hover:border-night-accent transition-all cursor-pointer group shadow-2xs';
        card.onclick = () => { window.location.href = `/${post.slug}`; };

        card.innerHTML = `
          <div class="flex items-center justify-between text-xs font-sans text-paper-muted dark:text-night-muted mb-2">
            <span class="px-2.5 py-0.5 rounded-full bg-paper-accent/10 text-paper-accent dark:text-night-accent font-medium">
              ${post.categoryLabel}
            </span>
            <time>${post.formattedDate}</time>
          </div>
          <h2 class="text-xl font-bold font-serif text-paper-text dark:text-night-text group-hover:text-paper-accent dark:group-hover:text-night-accent transition-colors mb-2">
            ${highlightText(post.title, q)}
          </h2>
          <p class="text-sm font-serif text-paper-muted dark:text-night-muted line-clamp-2">
            ${highlightText(post.description, q)}
          </p>
          ${
            snippet
              ? `<div class="mt-3 text-xs font-serif text-paper-text/80 dark:text-night-text/80 bg-paper-border/20 dark:bg-night-border/30 p-2.5 rounded-lg border-l-2 border-paper-accent/60">
                  <span class="text-[10px] uppercase font-sans text-paper-accent block mb-0.5 font-bold">লেখার ভেতর থেকে উক্তি:</span>
                  ${snippet}
                </div>`
              : ''
          }
        `;
        container.appendChild(card);
      });
    }

    renderResults(activePosts, '');

    input?.addEventListener('input', (e) => {
      const q = e.target.value.trim().toLowerCase();
      if (!q) {
        renderResults(activePosts, '');
        return;
      }
      const filtered = activePosts.filter((p) => {
        return (
          p.title.toLowerCase().includes(q) ||
          p.description.toLowerCase().includes(q) ||
          p.categoryLabel.toLowerCase().includes(q) ||
          p.tags.some((t) => t.toLowerCase().includes(q)) ||
          p.body.toLowerCase().includes(q)
        );
      });
      renderResults(filtered, q);
    });
  })();
</script>
